+/**
+ * iPhone WebKit never fires `contextmenu` for a long press, and the app opens its channel menu
+ * (add to favourites, audio from this channel, ...) from that event. A press held for about half a
+ * second without moving now raises the same event at the finger, and the tap that ends it is
+ * swallowed so the item is not also opened.
+ */
+export function installIosLongPress(): void {
+    if (typeof window === 'undefined' || !(window as unknown as { d7tNative?: unknown }).d7tNative) {
+        return;
+    }
+    const HOLD_MS = 500;
+    const MOVE_LIMIT = 10;
+    let timer: number | null = null;
+    let startX = 0;
+    let startY = 0;
+    let target: EventTarget | null = null;
+    let fired = false;
+
+    const clear = () => {
+        if (timer !== null) window.clearTimeout(timer);
+        timer = null;
+    };
+
+    document.addEventListener(
+        'touchstart',
+        (event) => {
+            clear();
+            fired = false;
+            if (event.touches.length !== 1) return;
+            const touch = event.touches[0];
+            startX = touch.clientX;
+            startY = touch.clientY;
+            target = event.target;
+            timer = window.setTimeout(() => {
+                timer = null;
+                fired = true;
+                target?.dispatchEvent(
+                    new MouseEvent('contextmenu', {
+                        bubbles: true,
+                        cancelable: true,
+                        clientX: startX,
+                        clientY: startY,
+                        button: 2,
+                        view: window,
+                    })
+                );
+            }, HOLD_MS);
+        },
+        { passive: true }
+    );
+    document.addEventListener(
+        'touchmove',
+        (event) => {
+            const touch = event.touches[0];
+            if (
+                timer !== null &&
+                touch &&
+                Math.hypot(touch.clientX - startX, touch.clientY - startY) > MOVE_LIMIT
+            ) {
+                clear();
+            }
+        },
+        { passive: true }
+    );
+    const end = () => clear();
+    document.addEventListener('touchend', end, { passive: true });
+    document.addEventListener('touchcancel', end, { passive: true });
+    // The click that follows a long press must not open the item as well.
+    document.addEventListener(
+        'click',
+        (event) => {
+            if (fired) {
+                fired = false;
+                event.stopPropagation();
+                event.preventDefault();
+            }
+        },
+        true
+    );
+}
diff --git a/apps/web/src/app/ios/split/embedded-mpv-preview-session.ts b/apps/web/src/app/ios/split/embedded-mpv-preview-session.ts
