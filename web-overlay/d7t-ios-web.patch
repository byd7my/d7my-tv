@@ -0,0 +1,185 @@
+// Fit the app to a phone screen when it runs inside the iOS shell (html.d7t-ios, set by the shell).
+html.d7t-ios {
+    -webkit-text-size-adjust: 100%;
+    -webkit-tap-highlight-color: transparent;
+    -webkit-touch-callout: none;
+    overscroll-behavior: none;
+    height: 100%;
+
+    body {
+        // Notch / Dynamic Island on top, home indicator at the bottom.
+        padding-top: env(safe-area-inset-top, 0px);
+        padding-bottom: env(safe-area-inset-bottom, 0px);
+        padding-left: env(safe-area-inset-left, 0px);
+        padding-right: env(safe-area-inset-right, 0px);
+        box-sizing: border-box;
+        height: 100%;
+        background: var(--app-shell-bg, #0d0f12);
+        overflow: hidden;
+        user-select: none;
+        -webkit-user-select: none;
+    }
+
+    input,
+    textarea,
+    [contenteditable] {
+        user-select: text;
+        -webkit-user-select: text;
+        // iOS zooms into inputs below 16px.
+        font-size: max(16px, 1em);
+    }
+}
+
+// Video is drawn by the phone app BEHIND this page, so the player box and everything around it
+// must let it show through (a page with a player is see-through; the shell colour sits behind it).
+html.d7t-ios {
+    .embedded-mpv-player,
+    .embedded-mpv-player__viewport {
+        background: transparent !important;
+    }
+
+    *:has(.embedded-mpv-player__viewport) {
+        background: transparent !important;
+        backdrop-filter: none !important;
+    }
+}
+
+// ── Phone layout (iPhone app) ────────────────────────────────────────────────
+// Same app, same features; only the arrangement changes so it works with a thumb:
+//  - the navigation bar moves to the bottom (like every iPhone app),
+//  - the live player sits on top at 16:9 and the channel list fills the rest,
+//  - the player's controls float over the picture instead of taking a strip below it.
+@media (max-width: 640px) {
+    html.d7t-ios {
+        .workspace-shell {
+            grid-template-rows: 56px minmax(0, 1fr) auto auto !important;
+        }
+
+        app-workspace-shell-header {
+            grid-row: 1 !important;
+        }
+
+        .workspace-body {
+            grid-row: 2 !important;
+        }
+
+        app-workspace-shell-rail {
+            grid-column: 1 !important;
+            grid-row: 3 !important;
+            border-top: 1px solid var(--app-separator, rgba(255, 255, 255, 0.08));
+        }
+
+        .workspace-now-playing {
+            grid-row: 4 !important;
+        }
+
+        // Live TV: picture first, list underneath.
+        app-live-stream-layout {
+            flex-direction: column;
+
+            .content-container {
+                order: -1;
+                flex: 0 0 auto !important;
+                min-height: 0 !important;
+            }
+
+            .video-player {
+                flex: 0 0 auto !important;
+                aspect-ratio: 16 / 9;
+                width: 100%;
+                min-height: 0 !important;
+            }
+
+            .epg.epg--inline,
+            .epg.epg--list {
+                --epg-inline-height: 150px;
+                flex: 0 0 150px !important;
+            }
+
+            // No schedule for this channel: keep just the title row, not a big empty card.
+            .epg.epg--inline:has(app-epg-timeline-empty-state),
+            .epg.epg--list:has(app-epg-timeline-empty-state) {
+                --epg-inline-height: 64px;
+                flex: 0 0 64px !important;
+
+                app-epg-timeline-empty-state {
+                    display: none;
+                }
+            }
+
+            .sidebar {
+                order: 1;
+                flex: 1 1 0 !important;
+                max-height: none !important;
+                min-height: 0 !important;
+                border-bottom: none !important;
+            }
+        }
+
+        // The player's controls overlay the picture (the video sits behind the page),
+        // in two compact rows: [play, skip | actions] over [timeline].
+        .embedded-mpv-player--controls-enabled .embedded-mpv-player__viewport {
+            bottom: 0 !important;
+        }
+
+        .embedded-mpv-player__controls:not(.embedded-mpv-player__controls--panel) {
+            grid-template-columns: auto minmax(0, 1fr) !important;
+            grid-template-areas:
+                'transport actions'
+                'timeline timeline';
+            gap: 0 8px !important;
+            padding: 6px 12px 8px !important;
+            min-height: 0 !important;
+            background: linear-gradient(
+                to top,
+                rgba(0, 0, 0, 0.85),
+                rgba(0, 0, 0, 0)
+            ) !important;
+            border-top: 0 !important;
+            backdrop-filter: none !important;
+            color: #fff;
+            --embedded-mpv-text: #fff;
+            --embedded-mpv-text-muted: rgba(255, 255, 255, 0.8);
+            --mat-icon-button-icon-color: #fff;
+
+            .embedded-mpv-player__transport {
+                grid-area: transport;
+            }
+
+            .embedded-mpv-player__timeline {
+                grid-area: timeline;
+            }
+
+            .embedded-mpv-player__actions {
+                grid-area: actions;
+                justify-content: flex-end;
+                gap: 0;
+            }
+
+            // Volume is the phone's own buttons.
+            .embedded-mpv-player__volume-inline {
+                display: none !important;
+            }
+        }
+    }
+}
+
+// Stand-in fullscreen (iPhone WebKit has none for ordinary elements).
+html.d7t-ios .d7t-fullscreen {
+    position: fixed !important;
+    inset: 0 !important;
+    width: 100vw !important;
+    height: 100vh !important;
+    z-index: 2000 !important;
+    border-radius: 0 !important;
+
+    .embedded-mpv-player__controls {
+        padding-left: max(16px, env(safe-area-inset-left, 0px));
+        padding-right: max(16px, env(safe-area-inset-right, 0px));
+        padding-bottom: max(10px, env(safe-area-inset-bottom, 0px));
+    }
+}
+
+html.d7t-ios.d7t-has-fullscreen body {
+    padding: 0;
+}
