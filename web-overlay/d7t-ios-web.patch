diff --git a/libs/portal/xtream/data-access/src/lib/services/split-audio-catalog.service.ts b/libs/portal/xtream/data-access/src/lib/services/split-audio-catalog.service.ts
new file mode 100644
index 0000000..2c38f0b
--- /dev/null
+++ b/libs/portal/xtream/data-access/src/lib/services/split-audio-catalog.service.ts
@@ -0,0 +1,174 @@
+import { inject, Injectable, signal } from '@angular/core';
+import { firstValueFrom } from 'rxjs';
+import {
+    PlaylistsService,
+    SplitAudioService,
+    type SplitAudioCatalog,
+    type SplitAudioCatalogChannel,
+} from '@iptvnator/services';
+import type { Channel } from '@iptvnator/shared/interfaces';
+import {
+    isXtreamSubscription,
+    SplitAudioSourceService,
+} from './split-audio-source.service';
+
+/** Two subscriptions load at once: each is a provider connection, and lists can be large. */
+const PARALLEL_LOADS = 2;
+/** The loaded catalog is reused this long before every subscription is fetched again. */
+const CATALOG_TTL_MS = 10 * 60 * 1000;
+
+/**
+ * The "audio from another channel" picker's view of ALL saved Xtream subscriptions at once.
+ *
+ * Before, the picker only knew the list the Live TV page published for the channel it started, so
+ * a channel opened from Recently viewed, Favorites or Search had no list at all, and another
+ * subscription had to be chosen by hand. This service loads every subscription's live channels
+ * (through the same Xtream API and cache as the single-source picker) and offers them as one
+ * searchable list, each channel tagged with its subscription.
+ *
+ * It also publishes a minimal context for a channel started from a page that published none (or
+ * a stale one), so choosing the sound, its saved delay and Auto Sync work wherever the picture
+ * came from. It never changes how the synchronisation itself works.
+ */
+@Injectable({ providedIn: 'root' })
+export class SplitAudioCatalogService implements SplitAudioCatalog {
+    private readonly splitAudio = inject(SplitAudioService);
+    private readonly sources = inject(SplitAudioSourceService);
+    private readonly playlists = inject(PlaylistsService);
+
+    private readonly all = signal<readonly SplitAudioCatalogChannel[]>([]);
+    private readonly isLoading = signal(false);
+    private readonly failedCount = signal(0);
+    private readonly failedNames = signal<readonly string[]>([]);
+    private loadedAt = 0;
+    private running: Promise<void> | null = null;
+
+    constructor() {
+        this.splitAudio.catalog.set(this);
+        // The iPhone host announces every primary playback; see IosMpvHost.
+        window.addEventListener('d7t-primary-playback', (event) => {
+            const detail = (event as CustomEvent<{ url?: string; title?: string }>)
+                .detail;
+            if (detail?.url) this.onPrimaryPlayback(detail.url, detail.title ?? '');
+        });
+    }
+
+    channels(): readonly SplitAudioCatalogChannel[] {
+        return this.all();
+    }
+
+    loading(): boolean {
+        return this.isLoading();
+    }
+
+    failed(): number {
+        return this.failedCount();
+    }
+
+    failedTitles(): readonly string[] {
+        return this.failedNames();
+    }
+
+    /** Tries again only for what failed: a provider that was busy streaming often answers a moment later. */
+    retry(): void {
+        if (this.running) return;
+        this.loadedAt = 0;
+        this.running = this.load(true).finally(() => {
+            this.running = null;
+        });
+    }
+
+    ensureLoaded(): void {
+        if (this.running) return;
+        if (Date.now() - this.loadedAt < CATALOG_TTL_MS && this.all().length) {
+            return;
+        }
+        this.running = this.load().finally(() => {
+            this.running = null;
+        });
+    }
+
+    private async load(onlyFailed = false): Promise<void> {
+        this.isLoading.set(true);
+        this.failedCount.set(0);
+        const previouslyFailed = new Set(this.failedNames());
+        this.failedNames.set([]);
+        try {
+            const everything = (
+                await firstValueFrom(this.playlists.getAllPlaylists())
+            ).filter(isXtreamSubscription);
+            const playlists = onlyFailed
+                ? everything.filter((p) => previouslyFailed.has(p.title))
+                : everything;
+            const merged: SplitAudioCatalogChannel[] = onlyFailed
+                ? [...this.all()]
+                : [];
+            let next = 0;
+            const worker = async (): Promise<void> => {
+                while (next < playlists.length) {
+                    const playlist = playlists[next++];
+                    try {
+                        const channels = await this.sources.channelsFor(
+                            playlist._id
+                        );
+                        const tagged = channels.map(
+                            (channel) =>
+                                ({
+                                    ...channel,
+                                    sourceId: playlist._id,
+                                    sourceTitle: playlist.title,
+                                }) as SplitAudioCatalogChannel
+                        );
+                        merged.push(...tagged);
+                        // Results show up as each subscription arrives.
+                        this.all.set([...merged]);
+                    } catch (error) {
+                        console.warn(
+                            'Could not load a subscription for the sound picker',
+                            error
+                        );
+                        this.failedCount.update((count) => count + 1);
+                        this.failedNames.update((names) => [
+                            ...names,
+                            playlist.title,
+                        ]);
+                    }
+                }
+            };
+            await Promise.all(
+                Array.from(
+                    { length: Math.min(PARALLEL_LOADS, playlists.length) },
+                    worker
+                )
+            );
+            // A failed subscription is asked for again the next time the picker opens, not after ten minutes.
+            if (this.failedCount() === 0) this.loadedAt = Date.now();
+        } catch (error) {
+            console.warn('Could not list the subscriptions', error);
+            this.failedCount.update((count) => count + 1);
+        } finally {
+            this.isLoading.set(false);
+        }
+    }
+
+    /**
+     * A channel started from a page that published no split-audio context (Recently viewed,
+     * Favorites, Search) or a context of an earlier channel: describe the one now playing.
+     */
+    private onPrimaryPlayback(url: string, title: string): void {
+        const current = this.splitAudio.context();
