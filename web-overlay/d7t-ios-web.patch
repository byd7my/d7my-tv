@@ -0,0 +1,37 @@
+import {
+    HttpErrorResponse,
+    HttpResponse,
+    type HttpInterceptorFn,
+} from '@angular/common/http';
+import { from, throwError } from 'rxjs';
+import { catchError, map } from 'rxjs/operators';
+import { handleIosBackend } from './ios-backend';
+import { getD7tNative, IOS_BACKEND_ORIGIN } from './ios-bridge';
+
+/** Answers the app's own backend calls inside the iOS shell, so no server is needed. */
+export const iosBackendInterceptor: HttpInterceptorFn = (req, next) => {
+    if (!getD7tNative() || !req.url.startsWith(IOS_BACKEND_ORIGIN)) {
+        return next(req);
+    }
+    const url = new URL(req.urlWithParams);
+    return from(
+        handleIosBackend({
+            method: req.method,
+            path: url.pathname.replace(/\/+$/, '') || '/',
+            query: url.searchParams,
+            body: req.body,
+        })
+    ).pipe(
+        map((res) => {
+            if (res.status >= 400) {
+                throw new HttpErrorResponse({
+                    url: req.url,
+                    status: res.status,
+                    error: res.body,
+                });
+            }
+            return new HttpResponse({ url: req.url, status: res.status, body: res.body });
+        }),
+        catchError((error) => throwError(() => error))
+    );
+};
