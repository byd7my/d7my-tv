+++ b/libs/portal/xtream/feature/src/lib/ios-live/ios-hidden-categories.service.ts
@@ -0,0 +1,87 @@
+import { Injectable, signal } from '@angular/core';
+
+export type IosCategoryType = 'live' | 'vod' | 'series';
+
+type HiddenMap = Record<string, Partial<Record<IosCategoryType, string[]>>>;
+
+const STORAGE_KEY = 'd7t.hiddenCategories.v1';
+
+/**
+ * Categories the user chose not to see in the iPhone app.
+ *
+ * Hiding is a local preference only: nothing is deleted from the provider, the
+ * playlist or the catalog database. It is stored per playlist and content type
+ * in localStorage, so it survives restarts and never leaks between sources.
+ */
+@Injectable({ providedIn: 'root' })
+export class IosHiddenCategoriesService {
+    private readonly state = signal<HiddenMap>(this.read());
+
+    /** Reactive set of hidden category ids for one playlist and section. */
+    hiddenIds(playlistId: string, type: IosCategoryType): ReadonlySet<string> {
+        return new Set(this.state()[playlistId]?.[type] ?? []);
+    }
+
+    isHidden(
+        playlistId: string,
+        type: IosCategoryType,
+        categoryId: string | number
+    ): boolean {
+        return (this.state()[playlistId]?.[type] ?? []).includes(
+            String(categoryId)
+        );
+    }
+
+    hide(
+        playlistId: string,
+        type: IosCategoryType,
+        categoryId: string | number
+    ): void {
+        const id = String(categoryId);
+        this.update(playlistId, type, (ids) =>
+            ids.includes(id) ? ids : [...ids, id]
+        );
+    }
+
+    restore(
+        playlistId: string,
+        type: IosCategoryType,
+        categoryId: string | number
+    ): void {
+        const id = String(categoryId);
+        this.update(playlistId, type, (ids) => ids.filter((x) => x !== id));
+    }
+
+    restoreAll(playlistId: string, type: IosCategoryType): void {
+        this.update(playlistId, type, () => []);
+    }
+
+    private update(
+        playlistId: string,
+        type: IosCategoryType,
+        change: (ids: string[]) => string[]
+    ): void {
+        const next: HiddenMap = { ...this.state() };
+        const entry = { ...(next[playlistId] ?? {}) };
+        entry[type] = change(entry[type] ?? []);
+        next[playlistId] = entry;
+        this.state.set(next);
+        try {
+            localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+        } catch {
+            // storage unavailable: the choice still holds for this session
+        }
+    }
+
+    private read(): HiddenMap {
+        try {
+            const raw = localStorage.getItem(STORAGE_KEY);
+            const parsed = raw ? (JSON.parse(raw) as unknown) : null;
+            return parsed && typeof parsed === 'object'
+                ? (parsed as HiddenMap)
+                : {};
+        } catch {
+            return {};
+        }
+    }
+}
