 }
+
+const STYLED_LETTERS = /[ʰ-˿ᴬ-ᶿ⁰-₟²³¹]+/g;
+
+/**
+ * Display only: provider names such as "ᴿᴬᵂ ⁴ᴷ" or "ᴴᴰ" use superscript / modifier letters that
+ * the system font draws one wide glyph at a time. Turn them into the plain letters ("RAW 4K",
+ * "HD"). The stored name (used for search, matching and saved settings) is never changed.
+ */
+export function plainDisplayText(value: string): string {
+    if (!value) return value;
+    return value.replace(STYLED_LETTERS, (run) => run.normalize('NFKC'));
+}
