--- /dev/null
+++ b/libs/portal/xtream/feature/src/lib/ios-browse/ios-browse.component.ts
@@ -0,0 +1,165 @@
+import {
+    ChangeDetectionStrategy,
+    Component,
+    computed,
+    effect,
+    inject,
+} from '@angular/core';
+import { ActivatedRoute, Router, RouterLink } from '@angular/router';
+import {
+    ContentCardComponent,
+    ContentRailShellComponent,
+} from '@iptvnator/portal/shared/ui';
+import {
+    ContentType,
+    XtreamStore,
+} from '@iptvnator/portal/xtream/data-access';
+import { toXtreamRecentlyAddedTimestamp } from '@iptvnator/shared/interfaces';
+
+interface BrowseItem {
+    readonly added?: string;
+    readonly category_id: string | number;
+    readonly cover?: string;
+    readonly id?: number;
+    readonly last_modified?: string;
+    readonly name?: string;
+    readonly poster_url?: string;
+    readonly series_id?: number;
+    readonly stream_id?: number;
+    readonly stream_icon?: string;
+    readonly title?: string;
+    readonly xtream_id?: number;
+}
+
+interface BrowseCategory {
+    readonly id: string;
+    readonly name: string;
+    readonly items: BrowseItem[];
+}
+
+const RAIL_ITEMS = 18;
+const MAX_RAILS = 24;
+const RECENT_ITEMS = 20;
+
+/**
+ * Movies / Series on the phone: a big title, "Recently Added" and one poster rail per category,
+ * each with "Show All" (the category's full grid). It reads the same store as the desktop views.
+ */
+@Component({
+    selector: 'app-ios-browse',
+    templateUrl: './ios-browse.component.html',
+    styleUrl: './ios-browse.component.scss',
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    imports: [ContentCardComponent, ContentRailShellComponent, RouterLink],
+})
+export class IosBrowseComponent {
+    private readonly store = inject(XtreamStore);
+    private readonly router = inject(Router);
+    private readonly route = inject(ActivatedRoute);
+    private readonly getVisible = this.store.getVisibleContentByType();
+
+    readonly type: ContentType =
+        this.route.parent?.snapshot.routeConfig?.path === 'series'
+            ? 'series'
+            : 'vod';
+    readonly title = this.type === 'series' ? 'Series' : 'Movies';
+
+    private readonly playlistId = computed(
+        () => this.store.currentPlaylist()?.id ?? null
+    );
+
+    private readonly all = computed(
+        () => this.getVisible(this.type) as BrowseItem[]
+    );
+
+    readonly recent = computed(() => {
+        const now = Date.now();
+        const series = this.type === 'series';
+        return this.all()
+            .map((item) => ({
+                item,
+                at:
+                    toXtreamRecentlyAddedTimestamp(
+                        series ? item.last_modified : item.added,
+                        now
+                    ) ||
+                    toXtreamRecentlyAddedTimestamp(
+                        series ? item.added : item.last_modified,
+                        now
+                    ),
+            }))
+            .filter((entry) => entry.at > 0)
+            .sort((a, b) => b.at - a.at)
+            .slice(0, RECENT_ITEMS)
+            .map((entry) => entry.item);
+    });
+
+    readonly categories = computed<BrowseCategory[]>(() => {
+        const names = new Map<string, string>();
+        const list =
+            this.type === 'series'
+                ? this.store.serialCategories()
+                : this.store.vodCategories();
+        for (const category of list as unknown as Array<Record<string, unknown>>) {
+            const id = String(category['category_id'] ?? category['id'] ?? '');
+            const name = String(
+                category['category_name'] ?? category['name'] ?? ''
+            );
+            if (id) names.set(id, name);
+        }
+        const groups = new Map<string, BrowseItem[]>();
+        for (const item of this.all()) {
+            const id = String(item.category_id);
+            const group = groups.get(id);
+            if (group) {
+                if (group.length < RAIL_ITEMS) group.push(item);
+            } else {
+                groups.set(id, [item]);
+            }
+        }
+        const result: BrowseCategory[] = [];
+        for (const [id, name] of names) {
+            const items = groups.get(id);
+            if (items?.length) result.push({ id, name, items });
+            if (result.length >= MAX_RAILS) break;
+        }
+        return result;
+    });
+
+    readonly isLoading = computed(
+        () =>
+            this.all().length === 0 &&
+            (this.store.isLoadingContent() ||
+                this.store.isLoadingCategories() ||
+                this.store.isImporting())
+    );
+
+    constructor() {
+        effect(() => this.store.setSelectedContentType(this.type));
+    }
+
+    link(section: string, ...rest: Array<string | number>): string[] | null {
+        const id = this.playlistId();
+        return id
+            ? ['/workspace', 'xtreams', id, section, ...rest.map(String)]
+            : null;
+    }
+
+    poster(item: BrowseItem): string | undefined {
+        return item.poster_url || item.cover || item.stream_icon;
+    }
+
+    label(item: BrowseItem): string {
+        return item.title || item.name || '';
+    }
+
+    open(item: BrowseItem): void {
+        const id =
+            item.xtream_id ||
+            item.id ||
+            (this.type === 'series' ? item.series_id : item.stream_id);
+        void this.router.navigate(['..', this.type, item.category_id, id], {
+            relativeTo: this.route,
+        });
+    }
+}
