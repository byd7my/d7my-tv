+/** The per-session knobs the two-session audio manager reads (the desktop reads them from its settings mirror). */
+export interface EmbeddedMpvSessionOptions {
+    extraOptions: string[];
+    autoReconnect: boolean;
+    splitAudio?: boolean;
+    splitAudioDBaseSeconds?: number;
+}
