@@ -0,0 +1,551 @@
+import type {
+    EmbeddedMpvSplitAudioStatus,
+    ResolvedPortalPlayback,
+    SplitAudioSyncAction,
+} from '@iptvnator/shared/interfaces';
+import { FreezeHolds, RESUME_GRACE_MS } from './split-audio-freeze-holds';
+import { runQuickSync } from './split-audio-quick-sync';
+import { SoundWatch } from './split-audio-sound-watch';
+import { createRunIO } from './split-audio-run-io';
+import { SyncCorrector } from './split-audio-corrector';
+import type { AudioIssue } from './split-audio-health';
+import { AutoSyncRun, type SyncSide } from './split-audio-sync-run';
+import { buildSplitAudioStatus } from './split-audio-pair-status';
+
+/**
+ * "Audio from another channel" with two sessions: the main session keeps the
+ * picture (muted) and a second, hidden session plays the other channel's
+ * sound. This class owns the link between them:
+ *
+ *  - every control the user gives the player reaches both (pause, seek, speed,
+ *    volume), so the pair behaves like one player;
+ *  - the user's speed and the sync correction are separate numbers. The speed
+ *    each session really gets is `userSpeed x factor` (factor: 1 or a small
+ *    slowdown from the corrector), so a correction never changes what the
+ *    user chose and the user's choice never cancels a correction;
+ *  - the target the correction aims at is `D_base + trim`: D_base is the fixed
+ *    delay of the frame-copy picture path, trim is the user's fine delay. The
+ *    sound session's own `audio-delay` is never used (it moves the hidden
+ *    picture, not what is heard);
+ *  - pause, seek, reload and reconnect void the measurement: factors go back
+ *    to 1 and the lateness is measured again;
+ *  - the pair has ONE decision source, chosen by `syncMode`: in 'auto' only
+ *    the readings taken off the two match clocks steer the corrector, in
+ *    'manual' only the offset the user typed does. The other source is
+ *    ignored, and the corrector is the only thing that ever changes a speed
+ *    (the user's trim moves its target, never a speed);
+ *  - the sound is watched all the time. The first reliable fault (a stall, a
+ *    starved buffer, a speed mpv does not follow, dropped frames) voids the
+ *    measurement and gives both sessions the user's speed back, whichever one
+ *    was slowed. A second one within the policy window gives the external
+ *    sound up: `hooks.giveUp` makes the owner close the sound session and hand
+ *    the picture its own audio back.
+ *
+ * It talks to mpv only through `SplitAudioHost`, so the whole thing is unit
+ * tested without a helper process.
+ */
+export interface SoundSnapshot {
+    status: string;
+    positionSeconds: number;
+    bufferedAheadSeconds: number | null;
+    droppedFrames: number | null;
+    /** Video + audio bitrate mpv measured, bits per second. */
+    bitrateBps?: number | null;
+}
+
+export interface SplitAudioHost {
+    now(): number;
+    createSoundSession(): string;
+    load(sessionId: string, playback: ResolvedPortalPlayback): void;
+    setPaused(sessionId: string, paused: boolean): void;
+    /**
+     * Pauses/resumes a session for the sync freeze only. It never goes through
+     * the user's pause path (the pair would take it for the user's pause).
+     */
+    hold(sessionId: string, on: boolean): void;
+    /** `key=value` options the session was started with (cache limits). */
+    cacheOptions(sessionId: string): readonly string[];
+    seekBy(sessionId: string, deltaSeconds: number): void;
+    /** A jump of one session only, not the user's seek (it never reaches the pair). */
+    jump(sessionId: string, deltaSeconds: number): void;
+    setSpeed(sessionId: string, speed: number): void;
+    setVolume(sessionId: string, volume: number): void;
+    disposeSession(sessionId: string): void;
+    snapshot(sessionId: string): SoundSnapshot | null;
+}
+
+export type SplitAudioSyncMode = 'auto' | 'manual';
+
+export interface SplitAudioHooks {
+    /** The sound kept failing: the owner must end the pair. */
+    giveUp(issue: AudioIssue): void;
+}
+
+export interface SplitAudioInit {
+    mainId: string;
+    syncMode?: SplitAudioSyncMode;
+    userSpeed: number;
+    userVolume: number;
+    paused: boolean;
+    /** Fixed delay of the frame-copy picture path, seconds. */
+    dBaseSeconds: number;
+    trimSeconds: number;
+}
+
+/** Quiet time before the lateness is judged again, by cause. */
+export { RESUME_GRACE_MS };
+export const SETTLE_MS = { pause: 3000, seek: 4000, reload: 5000 } as const;
+const QUICK_SHOWN_MS = 15000;
+const MIN_SPEED = 0.25;
+const MAX_SPEED = 4;
+
+export function clampSpeed(speed: number): number {
+    return Math.min(MAX_SPEED, Math.max(MIN_SPEED, speed));
+}
+
+function round5(value: number): number {
+    return Math.round(value * 1e5) / 1e5;
+}
+
+export class SplitAudioPair {
+    readonly mainId: string;
+    soundId: string | null = null;
+    private userSpeed: number;
+    private userVolume: number;
+    private userPaused: boolean;
+    private carriedRun = false;
+    private trimSeconds: number;
+    private readonly dBaseSeconds: number;
+    private appliedMain = NaN;
+    private appliedSound = NaN;
+    private speedChangedAt = 0;
+    private syncMode: SplitAudioSyncMode;
+    private autoOn = true;
+    private disabledReason: string | null = null;
+    private readonly corrector = new SyncCorrector();
+    private readonly watch = new SoundWatch();
+    private readonly run: AutoSyncRun;
+    private fineOn = false;
+    private readonly holds: FreezeHolds;
+    private lastReading: { value: number; at: number } | null = null;
+    private manualVoided: EmbeddedMpvSplitAudioStatus['manualVoided'] = null;
+    private quick: EmbeddedMpvSplitAudioStatus['quickSync'] = null;
+    private quickAt = 0;
+    private startedAt = 0;
+
+    constructor(
+        private readonly host: SplitAudioHost,
+        init: SplitAudioInit,
+        private readonly hooks: SplitAudioHooks = { giveUp: () => undefined }
+    ) {
+        this.mainId = init.mainId;
+        this.syncMode = init.syncMode ?? 'auto';
+        this.userSpeed = clampSpeed(init.userSpeed);
+        this.userVolume = init.userVolume;
+        this.userPaused = init.paused;
+        this.trimSeconds = init.trimSeconds;
+        this.dBaseSeconds = init.dBaseSeconds;
+        this.corrector.setTarget(this.target());
+        this.corrector.setSpeed(this.userSpeed, host.now());
+        this.holds = new FreezeHolds(
+            host,
+            this.mainId,
+            () => this.soundId,
+            () => this.userVolume,
+            () => this.userPaused
+        );
+        this.run = new AutoSyncRun(
+            createRunIO({
+                host,
+                mainId: this.mainId,
+                soundId: () => this.soundId,
+                target: () => this.target(),
+                userSpeed: () => this.userSpeed,
+                corrector: this.corrector,
+                hold: (side, on) => this.holds.hold(side, on),
+                setFine: (on, now) => this.setFine(on, now),
+                giveUp: () => this.hooks.giveUp('stall'),
+            })
+        );
+    }
+
+    // ------------------------------------------------------------ lifecycle
+
+    start(playback: ResolvedPortalPlayback): string {
+        const id = this.host.createSoundSession();
+        this.soundId = id;
+        this.host.setVolume(id, this.userVolume);
+        this.host.load(id, playback);
+        this.speedChangedAt = this.host.now();
+        this.startedAt = this.speedChangedAt;
+        // The picture is muted for as long as the pair lives.
+        this.host.setVolume(this.mainId, 0);
+        this.applySpeeds(true);
+        if (this.userPaused) this.host.setPaused(id, true);
+        this.resetSync('reload');
+        return id;
+    }
+
+    /**
+     * Hands the session back as it was: its own speed and volume. With
+     * `restoreMain` false the picture stays muted (a replacement sound is on
+     * its way).
+     */
+    stop(restoreMain = true): void {
+        // A frozen picture must never be left frozen.
+        this.run.cancel(null);
+        const id = this.soundId;
+        this.soundId = null;
+        try {
+            this.host.setSpeed(this.mainId, this.userSpeed);
+            if (restoreMain) this.host.setVolume(this.mainId, this.userVolume);
+        } catch {
+            // the main session may already be gone
+        }
+        if (id) this.host.disposeSession(id);
+    }
+
+    // ------------------------------------------------------------- controls
+
+    setUserSpeed(speed: number): void {
+        this.userSpeed = clampSpeed(speed);
+        this.corrector.setSpeed(this.userSpeed, this.host.now());
+        this.applySpeeds(true);
+    }
+
+    setUserVolume(volume: number): void {
+        this.userVolume = volume;
+        if (this.soundId) this.host.setVolume(this.soundId, volume);
+        this.holds.onVolume(volume);
+    }
+
+    get volume(): number {
+        return this.userVolume;
+    }
+
+    get speed(): number {
+        return this.userSpeed;
+    }
+
+    get paused(): boolean {
+        return this.userPaused;
+    }
+
+    setTrim(seconds: number): void {
+        this.trimSeconds = Number.isFinite(seconds) ? seconds : 0;
+        this.corrector.setTarget(this.target());
+    }
+
+    /**
+     * Auto or manual. A change throws away what the other source measured and
+     * lets the speeds go; the new source starts from nothing.
+     */
+    setSyncMode(mode: SplitAudioSyncMode): void {
+        if (mode === this.syncMode) return;
+        this.syncMode = mode;
+        this.manualVoided = null;
+        this.resetSync('reload');
+    }
+
+    get mode(): SplitAudioSyncMode {
+        return this.syncMode;
+    }
+
+    setAutoCorrection(on: boolean): void {
+        this.autoOn = on;
+        if (on) {
+            this.disabledReason = null;
+            this.watch.policy.reset();
+            this.resetSync('reload');
+        } else {
+            this.run.cancel(null);
+            this.releaseFactors();
+        }
+    }
+
+    onPause(paused: boolean): void {
+        this.userPaused = paused;
+        if (this.soundId) this.host.setPaused(this.soundId, paused);
+        this.resetSync('pause');
+    }
+
+    /** The main picture jumped by `deltaSeconds`; the sound follows it. */
+    onSeekBy(deltaSeconds: number): void {
+        if (
+            this.soundId &&
+            Number.isFinite(deltaSeconds) &&
+            deltaSeconds !== 0
+        ) {
+            this.host.seekBy(this.soundId, deltaSeconds);
+        }
+        this.resetSync('seek');
+    }
+
+    /** The main session loaded a stream, by the user or by a reconnect. */
+    onMainReloaded(): void {
+        this.resetSync('reload');
+    }
+
+    /**
+     * The sound session reloaded after a drop. mpv's keep-open parks it paused
+     * at the end of the old stream and the reload would inherit that: it has
+     * to be unpaused, but only when the user is not paused.
+     */
+    onSoundReloaded(): void {
+        if (!this.soundId) return;
+        this.host.setPaused(this.soundId, this.userPaused);
+        this.applySpeeds(true);
+        // The first start of a sound that replaced another while Auto Sync was on is no interruption.
+        if (this.carriedRun) {
+            this.carriedRun = false;
+            return;
+        }
+        this.resetSync('reload');
+    }
+
+    /** Auto Sync goes on with this (replacement) pair: started now, kept through the sound's first start. */
+    startCarriedRun(): void {
+        if (this.startAutoSync()) this.carriedRun = true;
+    }
+
+    // ----------------------------------------------------------- correction
+
+    /**
+     * Lateness read off the two match clocks: positive when the sound is
+     * behind. Only the automatic mode listens to it, and only a started run
+     * (or its fine correction) acts on it.
+     */
+    reportLateness(seconds: number): void {
+        if (this.syncMode !== 'auto' || !this.autoOn || this.userPaused) return;
+        this.lastReading = { value: seconds, at: this.host.now() };
+        this.run.addReading(seconds);
+        if (this.fineOn) this.corrector.addReading(seconds, this.host.now());
+    }
+
+    /** One lateness the user typed; steers by dead reckoning. Manual mode only. */
+    reportManualLateness(seconds: number): void {
+        if (this.syncMode === 'manual' && this.autoOn && !this.userPaused) {
+            this.manualVoided = null;
+            this.corrector.setManual(seconds, this.host.now());
+        }
+    }
+
+    // ---------------------------------------------------- the automatic run
+
+    /** The user pressed Sync: one run, from measuring to "synced" or "failed". */
+    startAutoSync(): boolean {
+        if (
+            this.syncMode !== 'auto' ||
+            !this.autoOn ||
+            this.userPaused ||
+            !this.soundId
+        ) {
+            return false;
+        }
+        const now = this.host.now();
+        this.corrector.reset(now, 0);
+        this.releaseFactors();
+        this.fineOn = false;
+        this.quick = null;
+        return this.run.start();
+    }
+
+    /** An Auto Sync run is working (or has just been asked for). */
+    get syncRunning(): boolean {
+        return this.run.active;
+    }
+
+    cancelAutoSync(): void {
+        this.run.cancel(null);
+    }
+
+    /** The user's sync buttons (see `SplitAudioSyncAction`). */
+    syncAction(action: SplitAudioSyncAction): boolean {
+        switch (action) {
+            case 'start':
+                return this.startAutoSync();
+            case 'cancel':
+                this.cancelAutoSync();
+                break;
+            case 'quick':
+                this.quickSync();
+                break;
+            default:
+                this.setOriginalAudioDuringFreeze(
+                    action === 'original-audio-on'
+                );
+        }
+        return true;
+    }
+
+    /** True while a freeze (or the resume of one) explains a session's status. */
+    ownsTransition(side: SyncSide): boolean {
+        return this.holds.owns(side);
+    }
+
+    /** The picture is held on purpose: it must not look paused. */
+    get pictureFrozen(): boolean {
+        return this.run.pictureFrozen;
+    }
+
+    /** The user's choice: the picture's own audio plays while the sound is frozen. */
+    setOriginalAudioDuringFreeze(on: boolean): void {
+        this.holds.setOriginalAudio(on);
+    }
+
+    /**
+     * "Quick sync", only ever on the user's button: the session that is ahead
+     * jumps back by the difference. It needs a reading, the history to jump
+     * into and a cache that really keeps that much behind the playhead.
+     */
+    quickSync(): NonNullable<EmbeddedMpvSplitAudioStatus['quickSync']> {
+        const now = this.host.now();
+        const fresh = this.lastReading && now - this.lastReading.at <= 6000;
+        const result = runQuickSync({
+            host: this.host,
+            mainId: this.mainId,
+            soundId: this.soundId,
+            userPaused: this.userPaused,
+            lateness:
+                this.syncMode === 'manual'
+                    ? this.corrector.state.lateness
+                    : fresh
+                      ? (this.lastReading?.value ?? null)
+                      : null,
+            target: this.target(),
+            startedAt: this.startedAt,
+            beforeJump: () => this.run.cancel(null),
+            afterJump: () => this.resetSync('seek'),
+        });
+        this.quick = result;
+        this.quickAt = now;
+        return result;
+    }
+
+    /** Called about twice a second. */
+    tick(): void {
+        const id = this.soundId;
+        if (!id) return;
+        const now = this.host.now();
+        this.watchSound(id, now);
+        if (!this.autoOn || this.userPaused) return;
+        if (this.syncMode === 'auto') this.run.tick();
+        if (
+            (this.syncMode === 'manual' || this.fineOn) &&
+            this.corrector.step(now)
+        ) {
+            this.applySpeeds(false);
+        }
+    }
+
+    status(): EmbeddedMpvSplitAudioStatus {
+        const now = this.host.now();
+        return buildSplitAudioStatus({
+            syncMode: this.syncMode,
+            autoOn: this.autoOn,
+            userPaused: this.userPaused,
+            correction: this.corrector.state,
+            factors: this.corrector.factors,
+            run: this.run.status(),
+            soundId: this.soundId ?? '',
+            userSpeed: this.userSpeed,
+            clamp: clampSpeed,
+            targetSeconds: this.target(),
+            dBaseSeconds: this.dBaseSeconds,
+            trimSeconds: this.trimSeconds,
+            audioRate: this.watch.audioRate,
+            issue: this.watch.shownIssue(now),
+            disabledReason: this.disabledReason,
+            manualVoided: this.manualVoided,
+            originalAudioDuringFreeze: this.holds.originalAudio,
+            quick: now - this.quickAt < QUICK_SHOWN_MS ? (this.quick ?? null) : null,
+        });
+    }
+
+    // ------------------------------------------------------------ internals
+
+    private target(): number {
+        return this.dBaseSeconds + this.trimSeconds;
+    }
+
+    private resetSync(cause: keyof typeof SETTLE_MS): void {
+        this.voidManual(cause);
+        this.run.cancel('interrupted');
+        this.fineOn = false;
+        this.corrector.reset(this.host.now(), SETTLE_MS[cause]);
+        this.watch.reset();
+        this.releaseFactors();
+    }
+
+    /**
+     * A manual correction that was under way ends here. It is not applied
+     * again by itself: the user is told and decides (the value is still typed).
+     */
+    private voidManual(
+        cause: NonNullable<EmbeddedMpvSplitAudioStatus['manualVoided']>
+    ): void {
+        if (
+            this.syncMode === 'manual' &&
+            this.corrector.state.active !== null
+        ) {
+            this.manualVoided = cause;
+        }
+    }
+
+    /** The fine correction of a run starts or stops (stopping gives the user's speed back). */
+    private setFine(on: boolean, now: number): void {
+        this.fineOn = on;
+        this.corrector.reset(now, 0);
+        if (on) this.applySpeeds(false);
+        else this.releaseFactors();
+    }
+
+    private releaseFactors(): void {
+        this.applySpeeds(false);
+    }
+
+    /** Sends `userSpeed x factor` to both sessions, only what changed. */
+    private applySpeeds(force: boolean): void {
+        const f = this.autoOn ? this.corrector.factors : { main: 1, sound: 1 };
+        const main = round5(clampSpeed(this.userSpeed * f.main));
+        const sound = round5(clampSpeed(this.userSpeed * f.sound));
+        if (force || main !== this.appliedMain) {
+            this.appliedMain = main;
+            this.host.setSpeed(this.mainId, main);
+            this.speedChangedAt = this.host.now();
+        }
+        if (this.soundId && (force || sound !== this.appliedSound)) {
+            this.appliedSound = sound;
+            this.host.setSpeed(this.soundId, sound);
+            this.speedChangedAt = this.host.now();
+        }
+    }
+
+    private watchSound(id: string, now: number): void {
+        const snap = this.host.snapshot(id);
+        if (!snap) return;
+        const issue = this.watch.observe(snap, {
+            now,
+            speed: this.appliedSound,
+            held: this.holds.isHeld('sound'),
+            userPaused: this.userPaused,
+            steadySeconds: (now - this.speedChangedAt) / 1000,
+        });
+        if (!issue) return;
+        // A reliable fault, whichever session is the slowed one: what was
+        // measured no longer holds, so it is voided (the corrector stops and
+        // waits) and both sessions get the user's speed back.
+        const action = this.watch.policy.onIssue(now);
+        this.voidManual('fault');
+        this.run.cancel('faulted');
+        this.fineOn = false;
+        this.corrector.reset(now, this.watch.policy.holdMs);
+        this.watch.clearHealth();
+        this.applySpeeds(true);
+        if (action === 'give-up') {
+            this.autoOn = false;
+            this.disabledReason = issue;
+            this.hooks.giveUp(issue);
+        }
+    }
+}
diff --git a/apps/web/src/app/ios/split/split-audio-cache.ts b/apps/web/src/app/ios/split/split-audio-cache.ts
new file mode 100644
index 0000000..32e02f2
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-cache.ts
@@ -0,0 +1,99 @@
+/**
+ * How much media a session may hold in its demuxer cache, worked out from what
+ * the session was really started with. mpv's own defaults (150 MiB ahead,
+ * 50 MiB behind) are only the fallback and are marked `assumed`: they are not
+ * a guarantee, so the freeze also watches the real growth of the cache while
+ * it runs (see split-audio-sync-run.ts).
+ */
+const MIB = 1024 * 1024;
+/** mpv defaults (0.37 and 0.42): demuxer-max-bytes / demuxer-max-back-bytes. */
+export const MPV_DEFAULT_MAX_BYTES = 150 * MIB;
+export const MPV_DEFAULT_MAX_BACK_BYTES = 50 * MIB;
+/** Used when mpv has not measured a bitrate yet: a heavy live HD stream. */
+export const FALLBACK_BITRATE_BPS = 12_000_000;
+
+export interface CacheBudget {
+    /** Most bytes the cache may hold in this direction; 0 when it is off. */
+    bytes: number;
+    /** Seconds of media that is, at the stream's bitrate. */
+    seconds: number;
+    /** True when the number is mpv's default, not something the options set. */
+    assumed: boolean;
+    /** True when the bitrate was not measured and a fallback was used. */
+    bitrateAssumed: boolean;
+}
+
+const UNITS: Record<string, number> = {
+    '': 1,
+    b: 1,
+    kib: 1024,
+    mib: MIB,
+    gib: 1024 * MIB,
+    kb: 1000,
+    mb: 1_000_000,
+    gb: 1_000_000_000,
+};
+
+/** `150MiB`, `64M`, `500000` -> bytes; null when it is not a size. */
+export function parseByteSize(value: string): number | null {
+    const match = /^\s*([0-9]+(?:\.[0-9]+)?)\s*([a-z]*)\s*$/i.exec(value);
+    if (!match) return null;
+    const unit = match[2].toLowerCase().replace(/^([kmg])$/, '$1ib');
+    const factor = UNITS[unit];
+    return factor === undefined ? null : Math.floor(Number(match[1]) * factor);
+}
+
+function lastOption(options: readonly string[], key: string): string | null {
+    let found: string | null = null;
+    for (const option of options) {
+        const at = option.indexOf('=');
+        if (at > 0 && option.slice(0, at).trim() === key) {
+            found = option.slice(at + 1).trim();
+        }
+    }
+    return found;
+}
+
+/**
+ * The cache budget of a session started with `options` (`key=value` lines,
+ * later lines win) for a stream of `bitrateBps` (null: not measured).
+ * `direction` is the part the caller needs: media buffered ahead of the
+ * playhead (a freeze) or kept behind it (a jump back).
+ */
+export function cacheBudget(
+    options: readonly string[],
+    bitrateBps: number | null,
+    direction: 'ahead' | 'back'
+): CacheBudget {
+    const bitrateAssumed = !bitrateBps || bitrateBps <= 0;
+    const bitrate = bitrateAssumed ? FALLBACK_BITRATE_BPS : bitrateBps;
+    const bytesPerSecond = bitrate / 8;
+    const off = lastOption(options, 'cache') === 'no';
+    const key =
+        direction === 'ahead' ? 'demuxer-max-bytes' : 'demuxer-max-back-bytes';
+    const set = lastOption(options, key);
+    const parsed = set === null ? null : parseByteSize(set);
+    let bytes =
+        parsed ??
+        (direction === 'ahead'
+            ? MPV_DEFAULT_MAX_BYTES
+            : MPV_DEFAULT_MAX_BACK_BYTES);
+    let seconds = bytes / bytesPerSecond;
+    if (direction === 'ahead') {
+        // `cache-secs` caps the read-ahead in time, whatever the bytes allow.
+        const capSecs = Number(lastOption(options, 'cache-secs'));
+        if (Number.isFinite(capSecs) && capSecs > 0) {
+            seconds = Math.min(seconds, capSecs);
+        }
+    }
+    if (off) {
+        bytes = 0;
+        seconds = 0;
+    }
+    return {
+        bytes,
+        seconds,
+        assumed: parsed === null && !off,
+        bitrateAssumed,
+    };
+}
diff --git a/apps/web/src/app/ios/split/split-audio-corrector.ts b/apps/web/src/app/ios/split/split-audio-corrector.ts
new file mode 100644
index 0000000..15711b8
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-corrector.ts
@@ -0,0 +1,356 @@
+/**
+ * Closed-loop corrector of the two-session "audio from another channel" mode.
+ *
+ * The picture (main session, muted) and the sound (second session, picture
+ * hidden) come from two different streams, so the heard sound is `lateness`
+ * seconds behind the picture (negative: ahead). The corrector never speeds
+ * anything up (a live stream cannot run past its live edge); it slows down
+ * the session that is AHEAD by a small, bounded rate until the lateness meets
+ * the target, then lets go:
+ *
+ *  - sound too late  -> slow the main picture (muted: nothing is heard),
+ *  - sound too early -> slow the sound session (pitch kept by mpv's scaletempo).
+ *
+ * The result is a pair of factors (1 = untouched). They are kept apart from
+ * the user's own playback speed: the service multiplies them.
+ *
+ * Pure and clock-injected: it only ever sees readings and `now`.
+ */
+export interface CorrectorConfig {
+    /** Seconds the rate aims to close an error in (rate = |error| / tc). */
+    tcSeconds: number;
+    /** Start correcting above this many seconds of error. */
+    enterSeconds: number;
+    /** Stop correcting below this many seconds of error. */
+    exitSeconds: number;
+    /** Largest slowdown of the muted main picture (0.06 = 6 %). */
+    maxMainRate: number;
+    /** Largest slowdown of the sound session (kept small: it is heard). */
+    maxSoundRate: number;
+    /** Smallest slowdown worth applying. */
+    minRate: number;
+    /** Readings older than this leave the median window. */
+    windowMs: number;
+    minReadings: number;
+    /** A window whose spread exceeds this (seconds) is not trusted. */
+    madLimitSeconds: number;
+    /**
+     * A single manual reading that is NOT being steered (idle, locked, held)
+     * is dropped after this long.
+     */
+    manualHorizonMs: number;
+    /**
+     * Longest a manual reading may steer. While a correction is under way the
+     * reading stays: closing a 10 s gap at 3 % takes over five minutes, far
+     * more than `manualHorizonMs`, and a reading that expired half way left
+     * the rest of the gap in place without a word.
+     */
+    manualMaxMs: number;
+    /** Direction changes allowed in `lockWindowMs` before correction stops. */
+    maxFlips: number;
+    lockWindowMs: number;
+}
+
+export const DEFAULT_CORRECTOR_CONFIG: CorrectorConfig = {
+    tcSeconds: 25,
+    enterSeconds: 0.12,
+    exitSeconds: 0.06,
+    maxMainRate: 0.06,
+    maxSoundRate: 0.03,
+    minRate: 0.01,
+    windowMs: 9000,
+    minReadings: 4,
+    madLimitSeconds: 0.35,
+    manualHorizonMs: 150000,
+    manualMaxMs: 30 * 60000,
+    maxFlips: 3,
+    lockWindowMs: 90000,
+};
+
+export type CorrectionTarget = 'main' | 'sound';
+
+export interface CorrectionState {
+    /** Which session is being slowed, null while idle. */
+    active: CorrectionTarget | null;
+    /** Slowdown of the active session (0.03 = 3 % slower). */
+    rate: number;
+    /** Estimated lateness of the sound now, null without a usable reading. */
+    lateness: number | null;
+    /** Lateness minus target, null without an estimate. */
+    error: number | null;
+    /** Too many direction changes: no more correction until `reset`. */
+    locked: boolean;
+    /** Why there is no estimate: `none`, `settling`, `noisy`, `stale`. */
+    reason: 'ok' | 'none' | 'settling' | 'noisy' | 'stale';
+}
+
+interface Reading {
+    at: number;
+    value: number;
+    /** Cumulative applied slope when the reading was taken. */
+    cum: number;
+    manual: boolean;
+}
+
+function median(values: number[]): number {
+    const sorted = [...values].sort((a, b) => a - b);
+    const mid = sorted.length >> 1;
+    return sorted.length % 2
+        ? sorted[mid]
+        : (sorted[mid - 1] + sorted[mid]) / 2;
+}
+
+export class SyncCorrector {
+    private readings: Reading[] = [];
+    private target = 0;
+    private active: CorrectionTarget | null = null;
+    private rate = 0;
+    private holdUntil = 0;
+    private locked = false;
+    private lockedAt = 0;
+    private flips: number[] = [];
+    private lastDirection: CorrectionTarget | null = null;
+    /** Integral of dLateness/dt caused by the factors applied so far. */
+    private cum = 0;
+    private cumAt = 0;
+    /** The user's playback speed: lateness is in content seconds, which pass this much faster. */
+    private speedScale = 1;
+    private lastState: CorrectionState = this.blank('none');
+
+    constructor(
+        private readonly config: CorrectorConfig = DEFAULT_CORRECTOR_CONFIG
+    ) {}
+
+    setTarget(seconds: number): void {
+        this.target = Number.isFinite(seconds) ? seconds : 0;
+    }
+
+    /**
+     * The user's playback speed. Both sessions run at `speed x factor`, so a
+     * slowdown closes the gap `speed` times faster per wall second; the dead
+     * reckoning has to know, or it believes the gap closed at 1x.
+     */
+    setSpeed(speed: number, now: number): void {
+        this.advance(now);
+        this.speedScale = Number.isFinite(speed) && speed > 0 ? speed : 1;
+    }
+
+    /** A measured lateness (positive: the sound is behind the picture). */
+    addReading(lateness: number, now: number): void {
+        if (!Number.isFinite(lateness)) return;
+        this.advance(now);
+        this.readings.push({
+            at: now,
+            value: lateness,
+            cum: this.cum,
+            manual: false,
+        });
+        this.trim(now);
+    }
+
+    /**
+     * One trusted reading (typed by the user): replaces the window and steers
+     * by dead reckoning, since no further reading may follow.
+     */
+    setManual(lateness: number, now: number): void {
+        if (!Number.isFinite(lateness)) return;
+        this.advance(now);
+        this.readings = [
+            { at: now, value: lateness, cum: this.cum, manual: true },
+        ];
+        this.locked = false;
+        this.flips = [];
+    }
+
+    /**
+     * Pause, seek, reload, reconnect: what was measured is void. Readings are
+     * dropped, correction stops (the caller restores the speeds) and nothing
+     * is decided for `settleMs`.
+     */
+    reset(now: number, settleMs: number): void {
+        this.readings = [];
+        this.active = null;
+        this.rate = 0;
+        this.holdUntil = now + settleMs;
+        this.locked = false;
+        this.flips = [];
+        this.lastDirection = null;
+        this.cum = 0;
+        this.cumAt = now;
+        this.lastState = this.blank('settling');
+    }
+
+    /** Releases the correction at once (the caller restores the speeds). */
+    release(now: number, holdMs: number): void {
+        this.advance(now);
+        this.active = null;
+        this.rate = 0;
+        this.holdUntil = Math.max(this.holdUntil, now + holdMs);
+    }
+
+    get state(): CorrectionState {
+        return this.lastState;
+    }
+
+    /** Factors for (main, sound); (1, 1) while idle. */
+    get factors(): { main: number; sound: number } {
+        const slowed = 1 / (1 + this.rate);
+        return {
+            main: this.active === 'main' ? slowed : 1,
+            sound: this.active === 'sound' ? slowed : 1,
+        };
+    }
+
+    /** Decides from the readings; returns true when the factors changed. */
+    step(now: number): boolean {
+        this.advance(now);
+        this.trim(now);
+        const before = `${this.active}:${this.rate.toFixed(4)}`;
+        const estimate = this.estimate();
+        if (now < this.holdUntil) {
+            this.lastState = this.blank('settling');
+        } else if (estimate.value === null) {
+            this.lastState = this.blank(estimate.reason);
+            // No trustworthy number: do not keep steering on a stale guess.
+            if (estimate.reason !== 'none' || this.readings.length === 0) {
+                this.stop();
+            }
+        } else {
+            this.decide(estimate.value - this.target, estimate.value, now);
+        }
+        return before !== `${this.active}:${this.rate.toFixed(4)}`;
+    }
+
+    // ------------------------------------------------------------- internals
+
+    private blank(reason: CorrectionState['reason']): CorrectionState {
+        return {
+            active: this.active,
+            rate: this.rate,
+            lateness: null,
+            error: null,
+            locked: this.locked,
+            reason,
+        };
+    }
+
+    private stop(): void {
+        this.active = null;
+        this.rate = 0;
+    }
+
+    /** Folds the slope applied since the last call into the running integral. */
+    private advance(now: number): void {
+        if (now > this.cumAt) {
+            this.cum += this.slope() * ((now - this.cumAt) / 1000);
+            this.cumAt = now;
+        }
+    }
+
+    /**
+     * dLateness/dt: slowing the picture lowers it, slowing the sound raises it.
+     * A session slowed by `rate` runs at 1 / (1 + rate), so the gap moves by
+     * rate / (1 + rate) per second, not by `rate` (6 % slower closes 5.66 %).
+     */
+    private slope(): number {
+        if (this.active === null) return 0;
+        const closing = (this.rate / (1 + this.rate)) * this.speedScale;
+        return this.active === 'main' ? -closing : closing;
+    }
+
+    private trim(now: number): void {
+        const { windowMs, manualHorizonMs, manualMaxMs } = this.config;
+        this.readings = this.readings.filter((r) => {
+            const age = now - r.at;
+            if (!r.manual) return age <= windowMs;
+            // Steering on it: it stays until the gap is closed (or the cap).
+            return age <= (this.active !== null ? manualMaxMs : manualHorizonMs);
+        });
+    }
+
+    private estimate(): {
+        value: number | null;
+        reason: CorrectionState['reason'];
+    } {
+        if (this.readings.length === 0) return { value: null, reason: 'none' };
+        const manual = this.readings.find((r) => r.manual);
+        const compensated = this.readings.map(
+            (r) => r.value + (this.cum - r.cum)
+        );
+        if (manual && this.readings.length === 1) {
+            return { value: compensated[0], reason: 'ok' };
+        }
+        if (this.readings.length < this.config.minReadings) {
+            return { value: null, reason: 'none' };
+        }
+        const m = median(compensated);
+        const mad = median(compensated.map((v) => Math.abs(v - m)));
+        if (mad > this.config.madLimitSeconds) {
+            return { value: null, reason: 'noisy' };
+        }
+        return { value: m, reason: 'ok' };
+    }
+
+    private decide(error: number, lateness: number, now: number): void {
+        const { enterSeconds, exitSeconds, tcSeconds, minRate } = this.config;
+        // The lock is a pause for an unstable stretch, not a verdict for the rest of the playback.
+        if (this.locked && now - this.lockedAt >= this.config.lockWindowMs) {
+            this.locked = false;
+            this.flips = [];
+            this.lastDirection = null;
+        }
+        let want: CorrectionTarget | null | 'none' = null;
+        if (this.active === null) {
+            if (Math.abs(error) > enterSeconds)
+                want = error > 0 ? 'main' : 'sound';
+        } else {
+            const sameSide = error > 0 === (this.active === 'main');
+            // Overshoot or inside the dead band: let go, never reverse at once.
+            want =
+                Math.abs(error) < exitSeconds || !sameSide
+                    ? 'none'
+                    : this.active;
+        }
+        if (want === 'none') {
+            this.stop();
+        } else if (want !== null && !this.locked) {
+            if (this.lastDirection !== null && want !== this.lastDirection) {
+                this.flips = this.flips.filter(
+                    (t) => now - t < this.config.lockWindowMs
+                );
+                this.flips.push(now);
+                if (this.flips.length >= this.config.maxFlips) {
+                    this.locked = true;
+                    this.lockedAt = now;
+                }
+            }
+            if (!this.locked) {
+                this.lastDirection = want;
+                const cap =
+                    want === 'main'
+                        ? this.config.maxMainRate
+                        : this.config.maxSoundRate;
+                const rate = Math.min(
+                    cap,
+                    Math.max(minRate, Math.abs(error) / tcSeconds)
+                );
+                if (
+                    want !== this.active ||
+                    Math.abs(rate - this.rate) >= 0.003
+                ) {
+                    this.active = want;
+                    this.rate = rate;
+                }
+            }
+        }
+        if (this.locked) this.stop();
+        this.lastState = {
+            active: this.active,
+            rate: this.rate,
+            lateness,
+            error,
+            locked: this.locked,
+            reason: 'ok',
+        };
+    }
+}
diff --git a/apps/web/src/app/ios/split/split-audio-freeze-holds.ts b/apps/web/src/app/ios/split/split-audio-freeze-holds.ts
new file mode 100644
index 0000000..eb82bc9
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-freeze-holds.ts
@@ -0,0 +1,80 @@
+import type { SplitAudioHost } from './embedded-mpv-split-audio';
+import type { SyncSide } from './split-audio-sync-run';
+
+/** A session resumed by the freeze reports `playing` again for this long. */
+export const RESUME_GRACE_MS = 3000;
+
+/**
+ * The sync freeze of one session: it pauses below the user's pause (the host
+ * `hold`), never resumes what the user paused, and - when the user chose it -
+ * lets the picture's own audio play while the external sound is frozen, with
+ * the two never audible together.
+ */
+export class FreezeHolds {
+    private held: Record<SyncSide, boolean> = { picture: false, sound: false };
+    private releasedAt: Record<SyncSide, number> = {
+        picture: -1e9,
+        sound: -1e9,
+    };
+    private audible = false;
+    private original = false;
+
+    constructor(
+        private readonly host: SplitAudioHost,
+        private readonly mainId: string,
+        private readonly soundId: () => string | null,
+        private readonly volume: () => number,
+        private readonly userPaused: () => boolean
+    ) {}
+
+    get originalAudio(): boolean {
+        return this.original;
+    }
+
+    isHeld(side: SyncSide): boolean {
+        return this.held[side];
+    }
+
+    /** True while a freeze, or the resume that ends it, explains a status change. */
+    owns(side: SyncSide): boolean {
+        return (
+            this.held[side] ||
+            this.host.now() - this.releasedAt[side] < RESUME_GRACE_MS
+        );
+    }
+
+    setOriginalAudio(on: boolean): void {
+        this.original = on;
+        if (!on && this.audible) this.setAudible(false);
+    }
+
+    /** The user moved the volume: the picture's audio, if on, follows it. */
+    onVolume(volume: number): void {
+        if (this.audible) this.host.setVolume(this.mainId, volume);
+    }
+
+    hold(side: SyncSide, on: boolean): void {
+        const id = side === 'picture' ? this.mainId : this.soundId();
+        if (!id) return;
+        this.held[side] = on;
+        if (!on) this.releasedAt[side] = this.host.now();
+        if (side === 'sound' && this.original) {
+            // Never both at once: the sound goes quiet before the picture's
+            // own audio comes up, and the picture is muted before the sound
+            // resumes (the commands reach the session in this order).
+            if (on) {
+                this.host.hold(id, true);
+                this.setAudible(true);
+                return;
+            }
+            this.setAudible(false);
+        }
+        // The user's pause wins: a release never resumes what they paused.
+        if (on || !this.userPaused()) this.host.hold(id, on);
+    }
+
+    private setAudible(on: boolean): void {
+        this.audible = on;
+        this.host.setVolume(this.mainId, on ? this.volume() : 0);
+    }
+}
diff --git a/apps/web/src/app/ios/split/split-audio-health.ts b/apps/web/src/app/ios/split/split-audio-health.ts
new file mode 100644
index 0000000..32955dc
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-health.ts
@@ -0,0 +1,235 @@
+/**
+ * Watches the SOUND session while it is being slowed down. What is heard is
+ * what the user judges, so the check is on the sound's own clock: does the
+ * position advance at the speed that was asked for, is the buffer full, are
+ * frames being dropped? A stall, a starved buffer or a speed that mpv does not
+ * follow is what a listener hears as a gap, a stutter or a wobble.
+ *
+ * Pure: it only sees samples. The pair decides what to do with the verdicts.
+ */
+export type AudioIssue = 'stall' | 'starving' | 'rate' | 'drops';
+
+export interface HealthSample {
+    now: number;
+    status: string;
+    /** mpv's position of the sound session, seconds (fractional). */
+    positionSeconds: number;
+    /** Speed commanded to the sound session right now. */
+    speed: number;
+    bufferedAheadSeconds: number | null;
+    droppedFrames: number | null;
+    /** The user paused: no movement is expected. */
+    userPaused: boolean;
+    /** Seconds since the speed last changed (rate checks need a steady speed). */
+    steadySeconds: number;
+}
+
+export interface HealthConfig {
+    stallWindowMs: number;
+    /** Below this share of the expected advance counts as a stall. */
+    stallRatio: number;
+    starveBelowSeconds: number;
+    starveForMs: number;
+    rateWindowMs: number;
+    /** Relative error of the measured rate that counts as a mismatch. */
+    rateTolerance: number;
+    dropWindowMs: number;
+    dropLimit: number;
+}
+
+export const DEFAULT_HEALTH_CONFIG: HealthConfig = {
+    stallWindowMs: 2500,
+    stallRatio: 0.2,
+    starveBelowSeconds: 0.25,
+    starveForMs: 3000,
+    // The sound session's position moves in quarter-second steps, so a rate over a short window is only good to about +-2%
+    // (measured on a real Windows helper). 24 s brings that to under 1%, and 2% still catches a speed mpv ignores (3% or more).
+    rateWindowMs: 24000,
+    rateTolerance: 0.02,
+    dropWindowMs: 5000,
+    dropLimit: 10,
+};
+
+export interface HealthVerdict {
+    issue: AudioIssue | null;
+    /** Position advance per wall second over the rate window; null if unknown. */
+    measuredRate: number | null;
+}
+
+export class AudioHealthMonitor {
+    private samples: HealthSample[] = [];
+    private starvingSince: number | null = null;
+
+    constructor(
+        private readonly config: HealthConfig = DEFAULT_HEALTH_CONFIG
+    ) {}
+
+    /** Forget everything (pause, seek, reload: positions are not comparable). */
+    reset(): void {
+        this.samples = [];
+        this.starvingSince = null;
+    }
+
+    observe(sample: HealthSample): HealthVerdict {
+        const { config } = this;
+        // Only a playing, unpaused session says anything about its sound.
+        if (sample.status !== 'playing' || sample.userPaused) {
+            this.reset();
+            return { issue: null, measuredRate: null };
+        }
+        this.samples.push(sample);
+        const horizon = Math.max(
+            config.rateWindowMs,
+            config.stallWindowMs,
+            config.dropWindowMs
+        );
+        this.samples = this.samples.filter(
+            (s) => sample.now - s.now <= horizon
+        );
+        // A jump back or forward is a seek or reload, not a stall.
+        const previous = this.samples[this.samples.length - 2];
+        if (
+            previous &&
+            Math.abs(sample.positionSeconds - previous.positionSeconds) > 5
+        ) {
+            this.samples = [sample];
+            this.starvingSince = null;
+            return { issue: null, measuredRate: null };
+        }
+
+        const measuredRate = this.rateOver(config.rateWindowMs, sample);
+
+        const stall = this.advanceRatio(config.stallWindowMs, sample);
+        if (stall !== null && stall < config.stallRatio) {
+            return { issue: 'stall', measuredRate };
+        }
+
+        const buffered = sample.bufferedAheadSeconds;
+        if (buffered !== null && buffered < config.starveBelowSeconds) {
+            this.starvingSince ??= sample.now;
+            if (sample.now - this.starvingSince >= config.starveForMs) {
+                return { issue: 'starving', measuredRate };
+            }
+        } else {
+            this.starvingSince = null;
+        }
+
+        const dropped = this.droppedOver(config.dropWindowMs, sample);
+        if (dropped >= config.dropLimit)
+            return { issue: 'drops', measuredRate };
+
+        if (
+            measuredRate !== null &&
+            sample.steadySeconds * 1000 >= config.rateWindowMs &&
+            Math.abs(measuredRate - sample.speed) / sample.speed >
+                config.rateTolerance
+        ) {
+            return { issue: 'rate', measuredRate };
+        }
+        return { issue: null, measuredRate };
+    }
+
+    private oldest(
+        windowMs: number,
+        sample: HealthSample
+    ): HealthSample | null {
+        const found = this.samples.find((s) => sample.now - s.now <= windowMs);
+        return found && found !== sample ? found : null;
+    }
+
+    /**
+     * Advance of the position per wall second over the window, as the slope of
+     * a least-squares line. The sound session's position moves in steps (the
+     * hidden picture runs at a few frames a second, so mpv's position only
+     * changes per frame): two end points could be off by a whole step, a
+     * fitted line is not.
+     */
+    private rateOver(windowMs: number, sample: HealthSample): number | null {
+        const points = this.samples.filter(
+            (s) => sample.now - s.now <= windowMs
+        );
+        const first = points[0];
+        if (!first || sample.now - first.now < windowMs * 0.8) return null;
+        const n = points.length;
+        if (n < 4) return null;
+        const mx = points.reduce((a, p) => a + p.now / 1000, 0) / n;
+        const my = points.reduce((a, p) => a + p.positionSeconds, 0) / n;
+        let num = 0;
+        let den = 0;
+        for (const p of points) {
+            num += (p.now / 1000 - mx) * (p.positionSeconds - my);
+            den += (p.now / 1000 - mx) ** 2;
+        }
+        return den > 0 ? num / den : null;
+    }
+
+    /** Measured advance divided by the advance the commanded speed predicts. */
+    private advanceRatio(
+        windowMs: number,
+        sample: HealthSample
+    ): number | null {
+        const first = this.oldest(windowMs, sample);
+        if (!first || sample.now - first.now < windowMs * 0.8) return null;
+        const seconds = (sample.now - first.now) / 1000;
+        return (
+            (sample.positionSeconds - first.positionSeconds) /
+            (seconds * sample.speed)
+        );
+    }
+
+    private droppedOver(windowMs: number, sample: HealthSample): number {
+        const first = this.oldest(windowMs, sample);
+        if (
+            !first ||
+            first.droppedFrames === null ||
+            sample.droppedFrames === null
+        )
+            return 0;
+        return Math.max(0, sample.droppedFrames - first.droppedFrames);
+    }
+}
+
+/**
+ * What to do about verdicts: let go of the correction on the first one, and
+ * give the external sound up when a second one follows within the window.
+ */
+export interface IssuePolicyConfig {
+    /** Issues inside this window count towards giving up (5 minutes). */
+    windowMs: number;
+    maxIssues: number;
+    /** Seconds the correction stays released after an issue. */
+    holdMs: number;
+}
+
+export const DEFAULT_ISSUE_POLICY: IssuePolicyConfig = {
+    windowMs: 300000,
+    maxIssues: 2,
+    holdMs: 20000,
+};
+
+export type IssueAction = 'release' | 'give-up';
+
+export class AudioIssuePolicy {
+    private times: number[] = [];
+
+    constructor(
+        private readonly config: IssuePolicyConfig = DEFAULT_ISSUE_POLICY
+    ) {}
+
+    get holdMs(): number {
+        return this.config.holdMs;
+    }
+
+    /** Every reliable issue counts, whichever session is the slowed one. */
+    onIssue(now: number): IssueAction {
+        this.times = this.times.filter((t) => now - t < this.config.windowMs);
+        this.times.push(now);
+        return this.times.length >= this.config.maxIssues
+            ? 'give-up'
+            : 'release';
+    }
+
+    reset(): void {
+        this.times = [];
+    }
+}
diff --git a/apps/web/src/app/ios/split/split-audio-pair-status.ts b/apps/web/src/app/ios/split/split-audio-pair-status.ts
new file mode 100644
index 0000000..9c732c6
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-pair-status.ts
@@ -0,0 +1,117 @@
+import type {
+    EmbeddedMpvFrameRegion,
+    EmbeddedMpvSession,
+    EmbeddedMpvSplitAudioQuickResult,
+    EmbeddedMpvSplitAudioStatus,
+} from '@iptvnator/shared/interfaces';
+import type { CorrectionState } from './split-audio-corrector';
+import type { SyncRunStatus } from './split-audio-sync-run';
+
+type State = EmbeddedMpvSplitAudioStatus['state'];
+
+export interface PairStatusInput {
+    syncMode: 'auto' | 'manual';
+    autoOn: boolean;
+    userPaused: boolean;
+    correction: CorrectionState;
+    factors: { main: number; sound: number };
+    run: SyncRunStatus;
+    soundId: string;
+    userSpeed: number;
+    clamp(speed: number): number;
+    targetSeconds: number;
+    dBaseSeconds: number;
+    trimSeconds: number;
+    audioRate: number | null;
+    issue: EmbeddedMpvSplitAudioStatus['issue'];
+    disabledReason: string | null;
+    manualVoided: EmbeddedMpvSplitAudioStatus['manualVoided'];
+    originalAudioDuringFreeze: boolean;
+    quick: EmbeddedMpvSplitAudioQuickResult | null;
+}
+
+const RUN_STATE: Record<SyncRunStatus['phase'], State> = {
+    idle: 'idle',
+    measuring: 'measuring',
+    announcing: 'announcing',
+    freezing: 'freezing',
+    resuming: 'resuming',
+    settling: 'settling',
+    fine: 'measuring',
+    done: 'synced',
+    failed: 'failed',
+};
+
+function round5(value: number): number {
+    return Math.round(value * 1e5) / 1e5;
+}
+
+function stateOf(i: PairStatusInput): State {
+    const s = i.correction;
+    if (!i.autoOn) return 'off';
+    if (i.userPaused) return 'paused';
+    if (i.syncMode === 'auto') {
+        if (i.run.phase === 'fine') {
+            if (s.locked) return 'locked';
+            if (s.active) return 'correcting';
+            if (s.reason === 'noisy') return 'noisy';
+            return 'measuring';
+        }
+        return RUN_STATE[i.run.phase];
+    }
+    if (s.locked) return 'locked';
+    if (s.active) return 'correcting';
+    if (s.reason === 'settling') return 'settling';
+    if (s.reason === 'noisy') return 'noisy';
+    return s.lateness !== null ? 'synced' : 'measuring';
+}
+
+/** What the pair reports to the controls (see `SplitAudioPair.status`). */
+export function buildSplitAudioStatus(
+    i: PairStatusInput
+): EmbeddedMpvSplitAudioStatus {
+    const f = i.factors;
+    return {
+        mode: 'dual-session',
+        syncMode: i.syncMode,
+        soundSessionId: i.soundId,
+        state: stateOf(i),
+        userSpeed: i.userSpeed,
+        mainSpeed: round5(i.clamp(i.userSpeed * f.main)),
+        soundSpeed: round5(i.clamp(i.userSpeed * f.sound)),
+        correcting: i.correction.active,
+        rate: i.correction.rate,
+        lateness: i.correction.lateness,
+        targetSeconds: i.targetSeconds,
+        dBaseSeconds: i.dBaseSeconds,
+        trimSeconds: i.trimSeconds,
+        audioRate: i.audioRate,
+        issue: i.issue,
+        ...(i.disabledReason ? { autoDisabledReason: i.disabledReason } : {}),
+        ...(i.syncMode === 'auto' ? { sync: i.run } : {}),
+        manualVoided: i.syncMode === 'manual' ? i.manualVoided : null,
+        originalAudioDuringFreeze: i.originalAudioDuringFreeze,
+        quickSync: i.quick,
+    };
+}
+
+/** Overrides what the picture session reports with what the pair means. */
+export function decoratePayload(
+    pair: {
+        volume: number;
+        speed: number;
+        pictureFrozen: boolean;
+        status(): EmbeddedMpvSplitAudioStatus;
+    },
+    payload: EmbeddedMpvSession,
+    clockRegion: EmbeddedMpvFrameRegion | null
+): void {
+    payload.volume = pair.volume;
+    payload.playbackSpeed = pair.speed;
+    // A freeze of the sync is not the user's pause: the picture keeps saying
+    // "playing" (the countdown says why it stands still).
+    if (pair.pictureFrozen && payload.status === 'paused') {
+        payload.status = 'playing';
+    }
+    payload.splitAudio = { ...pair.status(), clockRegion };
+}
diff --git a/apps/web/src/app/ios/split/split-audio-quick-sync.ts b/apps/web/src/app/ios/split/split-audio-quick-sync.ts
new file mode 100644
index 0000000..dd043c2
--- /dev/null
+++ b/apps/web/src/app/ios/split/split-audio-quick-sync.ts
@@ -0,0 +1,87 @@
+import type { EmbeddedMpvSplitAudioStatus } from '@iptvnator/shared/interfaces';
+import type { SplitAudioHost } from './embedded-mpv-split-audio';
+import { cacheBudget } from './split-audio-cache';
+import type { SyncSide } from './split-audio-sync-types';
+
+type Quick = NonNullable<EmbeddedMpvSplitAudioStatus['quickSync']>;
+
+/** Longest a quick jump back may be, and the history it needs on top. */
+const MAX_JUMP_SECONDS = 30;
+const HISTORY_SECONDS = 5;
+const MIN_JUMP_SECONDS = 0.3;
+const CACHE_HEADROOM = 1.25;
+
+export interface QuickInput {
+    /** Lateness now (positive: sound behind); null when nothing is known. */
+    lateness: number | null;
+    target: number;
+    /** How long the pair has been playing: the history that can be jumped into. */
+    playedSeconds: number;
+    /** Seconds the side's cache keeps behind the playhead. */
+    backSeconds(side: SyncSide): number;
+}
+
+/**
+ * What the "quick sync" button may do: the side that is ahead jumps back by
+ * the difference, if there is a reading, history to jump into and a cache that
+ * really keeps that much behind the playhead. Pure; the pair does the jump.
+ */
+export function planQuickJump(
+    input: QuickInput
+): Quick | { kind: 'jump'; side: SyncSide; seconds: number } {
+    if (input.lateness === null) {
+        return { kind: 'unavailable', why: 'no-reading' };
+    }
+    const gap = input.lateness - input.target;
+    const seconds = Math.round(Math.abs(gap) * 10) / 10;
+    if (seconds < MIN_JUMP_SECONDS) return { kind: 'nothing' };
+    if (seconds > MAX_JUMP_SECONDS) {
+        return { kind: 'unavailable', why: 'too-far' };
+    }
+    if (input.playedSeconds < seconds + HISTORY_SECONDS) {
+        return { kind: 'unavailable', why: 'no-history' };
+    }
+    const side: SyncSide = gap > 0 ? 'picture' : 'sound';
+    if (input.backSeconds(side) < seconds * CACHE_HEADROOM + HISTORY_SECONDS) {
+        return { kind: 'unavailable', why: 'cache' };
+    }
+    return { kind: 'jump', side, seconds };
+}
+
+export interface QuickContext {
+    host: SplitAudioHost;
+    mainId: string;
+    soundId: string | null;
+    userPaused: boolean;
+    lateness: number | null;
+    target: number;
+    startedAt: number;
+    /** Before the jump: an automatic run in progress must end. */
+    beforeJump(): void;
+    /** After the jump: what was measured is void. */
+    afterJump(): void;
+}
+
+/** Plans the quick sync and, when it can, does the jump of the one side. */
+export function runQuickSync(c: QuickContext): Quick {
+    const id = c.soundId;
+    if (!id || c.userPaused) return { kind: 'unavailable', why: 'no-reading' };
+    const plan = planQuickJump({
+        lateness: c.lateness,
+        target: c.target,
+        playedSeconds: (c.host.now() - c.startedAt) / 1000,
+        backSeconds: (side) => {
+            const sid = side === 'picture' ? c.mainId : id;
+            return cacheBudget(
+                c.host.cacheOptions(sid),
+                c.host.snapshot(sid)?.bitrateBps ?? null,
+                'back'
+            ).seconds;
+        },
+    });
+    if (plan.kind !== 'jump') return plan;
+    c.beforeJump();
+    c.host.jump(plan.side === 'picture' ? c.mainId : id, -plan.seconds);
+    c.afterJump();
+    return { kind: 'jumped', side: plan.side, seconds: plan.seconds };
+}
diff --git a/apps/web/src/app/ios/split/split-audio-run-io.ts b/apps/web/src/app/ios/split/split-audio-run-io.ts
