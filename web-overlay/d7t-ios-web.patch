+import { ChangeDetectionStrategy, Component, inject, signal } from '@angular/core';
+import { DatePipe } from '@angular/common';
+import { firstValueFrom } from 'rxjs';
+import { PlaylistsService } from '@iptvnator/services';
+import {
+    CatalogSyncService,
+    isXtreamSubscription,
+} from '@iptvnator/portal/xtream/data-access';
+
+interface SyncRow {
+    id: string;
+    title: string;
+    syncedAt: number | null;
+}
+
+/**
+ * iPhone app: "Sync with provider". A subscription's catalog is downloaded once, when it is first
+ * opened, and kept on the phone. This is the only place that downloads it again.
+ */
+@Component({
+    selector: 'app-settings-provider-sync',
+    imports: [DatePipe],
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    template: `
+        <section class="settings-section provider-sync" data-test-id="provider-sync">
+            <h2 class="provider-sync__title">Sync with provider</h2>
+            <p class="provider-sync__hint">
+                Channels, movies and series are downloaded once and kept on this phone. Sync
+                again only when your provider has changed its list.
+            </p>
+            <div class="provider-sync__group">
+                @for (row of rows(); track row.id) {
+                    <div class="provider-sync__row">
+                        <div class="provider-sync__text">
+                            <span class="provider-sync__name">{{ row.title }}</span>
+                            <span class="provider-sync__when">
+                                @if (row.syncedAt) {
+                                    Last synced {{ row.syncedAt | date: 'd MMM y, HH:mm' }}
+                                } @else {
+                                    Not downloaded yet
+                                }
+                            </span>
+                        </div>
+                        <button
+                            type="button"
+                            class="provider-sync__button"
+                            data-test-id="provider-sync-button"
+                            [disabled]="busy() !== null"
+                            (click)="sync(row)"
+                        >
+                            {{ busy() === row.id ? 'Syncing…' : 'Sync now' }}
+                        </button>
+                    </div>
+                } @empty {
+                    <div class="provider-sync__row">
+                        <span class="provider-sync__when">No subscriptions yet.</span>
+                    </div>
+                }
+            </div>
+        </section>
+    `,
+    styles: [
+        `
+            :host {
+                display: block;
+            }
+            .provider-sync__title {
+                margin: 0 0 4px;
+                font-size: 17px;
+                font-weight: 700;
+            }
+            .provider-sync__hint {
+                margin: 0 0 12px;
+                font-size: 13px;
+                opacity: 0.62;
+            }
+            .provider-sync__group {
+                border-radius: 12px;
+                background: rgba(118, 118, 128, 0.24);
+                overflow: hidden;
+            }
+            .provider-sync__row {
+                display: flex;
+                align-items: center;
+                gap: 12px;
+                min-height: 52px;
+                padding: 8px 16px;
+            }
+            .provider-sync__row + .provider-sync__row {
+                border-top: 0.5px solid rgba(84, 84, 88, 0.65);
+            }
+            .provider-sync__text {
+                display: flex;
+                flex: 1;
+                flex-direction: column;
+                min-width: 0;
+            }
+            .provider-sync__name {
+                overflow: hidden;
+                text-overflow: ellipsis;
+                white-space: nowrap;
+                font-size: 17px;
+            }
+            .provider-sync__when {
+                font-size: 13px;
+                opacity: 0.62;
+            }
+            .provider-sync__button {
+                flex: none;
+                min-width: 44px;
+                min-height: 36px;
+                padding: 0 16px;
+                border: 0;
+                border-radius: 999px;
+                background: #0a84ff;
+                color: #fff;
+                font: 600 15px/1 inherit;
+                cursor: pointer;
+            }
+            .provider-sync__button:disabled {
+                opacity: 0.5;
+            }
+        `,
+    ],
+})
+export class SettingsProviderSyncComponent {
+    private readonly playlists = inject(PlaylistsService);
+    private readonly sync$ = inject(CatalogSyncService);
+
+    readonly rows = signal<readonly SyncRow[]>([]);
+    readonly busy = signal<string | null>(null);
+
+    constructor() {
+        void this.load();
+    }
+
+    private async load(): Promise<void> {
+        const all = await firstValueFrom(this.playlists.getAllPlaylists());
+        const subs = all.filter(isXtreamSubscription);
+        this.rows.set(
+            await Promise.all(
+                subs.map(async (playlist) => ({
+                    id: playlist._id,
+                    title: playlist.title,
+                    syncedAt: await this.sync$.syncedAt(playlist._id),
+                }))
+            )
+        );
+    }
+
+    /** Forgets the saved copy and restarts the app screen so the next open downloads a new one. */
+    async sync(row: SyncRow): Promise<void> {
+        this.busy.set(row.id);
+        await this.sync$.forget(row.id);
+        // A clean start: nothing of the old catalog stays in memory.
+        window.location.assign('/');
+    }
+}
