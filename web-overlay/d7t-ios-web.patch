diff --git a/libs/shared/interfaces/src/lib/embedded-mpv-bridge.ts b/libs/shared/interfaces/src/lib/embedded-mpv-bridge.ts
new file mode 100644
index 0000000..abb36bb
--- /dev/null
+++ b/libs/shared/interfaces/src/lib/embedded-mpv-bridge.ts
@@ -0,0 +1,18 @@
+import type { ElectronBridgeApi } from './electron-api.interface';
+
+/**
+ * The embedded-MPV side of the host bridge. The desktop app exposes it as
+ * `window.electron`; the iPhone app (which is NOT the desktop shell) exposes
+ * the same methods as `window.d7tMpv` and leaves `window.electron` undefined,
+ * so the rest of the app keeps running in its web mode.
+ */
+export function getEmbeddedMpvBridge(): ElectronBridgeApi | undefined {
+    if (typeof window === 'undefined') {
+        return undefined;
+    }
+    const host = window as unknown as {
+        electron?: ElectronBridgeApi;
+        d7tMpv?: ElectronBridgeApi;
+    };
+    return host.electron ?? host.d7tMpv;
+}
