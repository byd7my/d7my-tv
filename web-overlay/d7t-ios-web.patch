+import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
+import { DatePipe } from '@angular/common';
+import { IosUpdateService } from './ios-update.service';
+
+/**
+ * Settings card for the iPhone app: which web build is running and a "Check for updates" button that
+ * looks right now (the app also checks by itself whenever it starts).
+ */
+@Component({
+    selector: 'app-ios-update-card',
+    imports: [DatePipe],
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    template: `
+        @if (update.available) {
+            <div class="ios-update" data-test-id="ios-update-card">
+                <div class="ios-update__row">
+                    <span class="ios-update__label">Version</span>
+                    <span class="ios-update__value">{{ update.running() || '—' }}</span>
+                </div>
+                <button
+                    type="button"
+                    class="ios-update__row ios-update__action"
+                    data-test-id="ios-update-check"
+                    [disabled]="update.busy()"
+                    (click)="update.check()"
+                >
+                    <span class="ios-update__label ios-update__label--accent">
+                        {{ update.busy() ? 'Checking…' : 'Check for updates' }}
+                    </span>
+                    @if (update.busy()) {
+                        <span class="ios-update__spinner" aria-hidden="true"></span>
+                    }
+                </button>
+                @if (update.kind() === 'ready') {
+                    <button
+                        type="button"
+                        class="ios-update__row ios-update__action"
+                        data-test-id="ios-update-apply"
+                        (click)="update.apply()"
+                    >
+                        <span class="ios-update__label ios-update__label--accent">Restart now to update</span>
+                    </button>
+                }
+            </div>
+            @if (update.message()) {
+                <p
+                    class="ios-update__note"
+                    [class.ios-update__note--error]="update.kind() === 'error' || update.kind() === 'unsupported'"
+                    data-test-id="ios-update-message"
+                >
+                    {{ update.message() }}
+                </p>
+            }
+            @if (update.lastChecked(); as when) {
+                <p class="ios-update__note">Last checked {{ when | date: 'shortTime' }}</p>
+            }
+        }
+    `,
+    styles: `
+        :host {
+            display: block;
+        }
+        .ios-update {
+            background: var(--l-surface, #1c1c1e);
+            border-radius: 14px;
+            overflow: hidden;
+        }
+        .ios-update__row {
+            display: flex;
+            align-items: center;
+            justify-content: space-between;
+            gap: 12px;
+            width: 100%;
+            min-height: 48px;
+            padding: 0 16px;
+            border: 0;
+            background: none;
+            color: inherit;
+            font: inherit;
+            font-size: 17px;
+            text-align: start;
+        }
+        .ios-update__row + .ios-update__row {
+            border-top: 0.5px solid rgba(255, 255, 255, 0.12);
+        }
+        .ios-update__value {
+            color: rgba(235, 235, 245, 0.6);
+            font-variant-numeric: tabular-nums;
+        }
+        .ios-update__label--accent {
+            color: #0a84ff;
+            font-weight: 600;
+        }
+        .ios-update__action:disabled {
+            opacity: 0.6;
+        }
+        .ios-update__spinner {
+            width: 18px;
+            height: 18px;
+            border-radius: 50%;
+            border: 2px solid rgba(255, 255, 255, 0.25);
+            border-top-color: #0a84ff;
+            animation: ios-update-spin 0.8s linear infinite;
+        }
+        @keyframes ios-update-spin {
+            to {
+                transform: rotate(360deg);
+            }
+        }
+        .ios-update__note {
+            margin: 8px 16px 0;
+            color: rgba(235, 235, 245, 0.6);
+            font-size: 13px;
+            line-height: 1.4;
+        }
+        .ios-update__note--error {
+            color: #ff9f0a;
+        }
+    `,
+})
+export class IosUpdateCardComponent {
+    readonly update = inject(IosUpdateService);
+}
diff --git a/apps/web/src/app/ios/ios-update.service.ts b/apps/web/src/app/ios/ios-update.service.ts
new file mode 100644
index 0000000..a3c9d4b
--- /dev/null
+++ b/apps/web/src/app/ios/ios-update.service.ts
@@ -0,0 +1,130 @@
+import { Injectable, computed, signal } from '@angular/core';
+import { getD7tNative } from './ios-bridge';
+
+export type IosUpdateKind =
+    | 'unavailable' // not running inside the iPhone app
+    | 'idle'
+    | 'checking'
+    | 'current'
+    | 'ready'
+    | 'busy'
+    | 'unsupported' // this installed app build cannot check on demand yet
+    | 'error';
+
+interface OtaInfo {
+    bundled?: string;
+    downloaded?: string;
+    channel?: string;
+    canCheck?: boolean;
+}
+
+interface OtaCheckResult extends OtaInfo {
+    status?: 'ok' | 'busy' | 'error';
+    message?: string;
+}
+
+const CHECK_TIMEOUT_MS = 90_000;
+
+/**
+ * Manual "Check for updates" for the iPhone app's over-the-air web builds. The app already checks on
+ * every start; this lets the person ask right now (Settings) instead of waiting and reopening.
+ */
+@Injectable({ providedIn: 'root' })
+export class IosUpdateService {
+    private readonly native = getD7tNative();
+
+    readonly available = this.native !== undefined;
+    readonly kind = signal<IosUpdateKind>(this.available ? 'idle' : 'unavailable');
+    readonly message = signal('');
+    /** The web build on screen (first 7 characters of the commit it was built from). */
+    readonly running = signal('');
+    readonly channel = signal('');
+    readonly lastChecked = signal<Date | null>(null);
+
+    readonly busy = computed(() => this.kind() === 'checking');
+
+    constructor() {
+        void this.refreshRunning();
+    }
+
+    private async refreshRunning(): Promise<OtaInfo | null> {
+        if (!this.native) return null;
+        let info: OtaInfo | null = null;
+        try {
+            info = await this.native.call<OtaInfo>('ota.info');
+        } catch {
+            info = null;
+        }
+        let running = info?.bundled ?? '';
+        try {
+            const response = await fetch('d7t://localhost/version.json', {
+                cache: 'no-store',
+            });
+            if (response.ok) {
+                running =
+                    ((await response.json()) as { version?: string }).version ??
+                    running;
+            }
+        } catch {
+            // older builds have no version.json
+        }
+        this.running.set(running.slice(0, 7));
+        this.channel.set(info?.channel ?? '');
+        this.pending = running;
+        return info;
+    }
+
+    private pending = '';
+
+    async check(): Promise<void> {
+        if (!this.native || this.busy()) return;
+        this.kind.set('checking');
+        this.message.set('');
+        try {
+            const info = await this.refreshRunning();
+            if (!info?.canCheck) {
+                this.kind.set('unsupported');
+                this.message.set(
+                    'This copy of the app cannot check on its own yet. Install the newest D7T app once, then this button works. For now, close the app completely and open it again to update.'
+                );
+                return;
+            }
+            const result = await Promise.race([
+                this.native.call<OtaCheckResult>('ota.check'),
+                new Promise<never>((_, reject) =>
+                    setTimeout(
+                        () => reject(new Error('The update server did not answer in time.')),
+                        CHECK_TIMEOUT_MS
+                    )
+                ),
+            ]);
+            this.lastChecked.set(new Date());
+            if (result.status === 'busy') {
+                this.kind.set('busy');
+                this.message.set('An update check is already running. Try again in a moment.');
+            } else if (result.status === 'error') {
+                this.kind.set('error');
+                this.message.set(result.message || 'Could not reach the update server.');
+            } else if (result.downloaded && result.downloaded !== this.pending) {
+                this.kind.set('ready');
+                this.message.set(`Version ${result.downloaded.slice(0, 7)} is downloaded.`);
+            } else {
+                this.kind.set('current');
+                this.message.set('You have the newest version.');
+            }
+        } catch (error) {
+            this.kind.set('error');
+            this.message.set(error instanceof Error ? error.message : 'Update check failed.');
+        }
+    }
+
+    /** Switch to the downloaded copy now: the page reloads from it. */
+    async apply(): Promise<void> {
+        try {
+            await this.native?.call('ota.apply');
+        } catch {
+            this.kind.set('error');
+            this.message.set('Could not restart onto the new version.');
+        }
+    }
+}
diff --git a/apps/web/src/app/ios/split/embedded-mpv-preview-session.ts b/apps/web/src/app/ios/split/embedded-mpv-preview-session.ts
new file mode 100644
index 0000000..b767a13
--- /dev/null
+++ b/apps/web/src/app/ios/split/embedded-mpv-preview-session.ts
@@ -0,0 +1,95 @@
+import type {
+    EmbeddedMpvBounds,
+    EmbeddedMpvFrameRegion,
+    EmbeddedMpvPreviewRequest,
+} from '@iptvnator/shared/interfaces';
+
+/**
+ * Recipe for the silent preview session of the audio-sync window: the
+ * helper decodes the audio channel's picture, but only the scoreboard region
+ * is cropped out, only a few frames per second are produced, and nothing is
+ * played. All of it is mpv options, so the helper binary stays unchanged.
+ */
+
+const DEFAULT_OUTPUT_WIDTH = 480;
+const MIN_OUTPUT_WIDTH = 160;
+const MAX_OUTPUT_WIDTH = 960;
+const MIN_OUTPUT_HEIGHT = 24;
+const MAX_OUTPUT_HEIGHT = 540;
+/** Smallest region edge (fraction of the frame) that is still a region. */
+const MIN_REGION_EDGE = 0.02;
+/** Frames per second of the crop: enough for a once-a-second clock. */
+const PREVIEW_FRAMES_PER_SECOND = 4;
+/** Broadcast pictures are 16:9; the region's aspect is derived from it. */
+const SOURCE_ASPECT = 16 / 9;
+
+export interface EmbeddedMpvPreviewPlan {
+    bounds: EmbeddedMpvBounds;
+    /** mpv `key=value` lines, applied after the user's own options. */
+    options: string[];
+    region: EmbeddedMpvFrameRegion | null;
+}
+
+export function clampPreviewRegion(
+    region: EmbeddedMpvFrameRegion | undefined
+): EmbeddedMpvFrameRegion | null {
+    if (!region) return null;
+    const values = [region.x, region.y, region.width, region.height];
+    if (!values.every((value) => Number.isFinite(value))) return null;
+    const width = Math.min(1, Math.max(MIN_REGION_EDGE, region.width));
+    const height = Math.min(1, Math.max(MIN_REGION_EDGE, region.height));
+    return {
+        x: Math.min(1 - width, Math.max(0, region.x)),
+        y: Math.min(1 - height, Math.max(0, region.y)),
+        width,
+        height,
+    };
+}
+
+function fraction(value: number): string {
+    return value.toFixed(4);
+}
+
+export function buildEmbeddedMpvPreviewPlan(
+    request: EmbeddedMpvPreviewRequest | undefined
+): EmbeddedMpvPreviewPlan {
+    const region = clampPreviewRegion(request?.region);
+    const requestedWidth = Number.isFinite(request?.outputWidth)
+        ? Math.round(request?.outputWidth as number)
+        : DEFAULT_OUTPUT_WIDTH;
+    const width = Math.min(
+        MAX_OUTPUT_WIDTH,
+        Math.max(MIN_OUTPUT_WIDTH, requestedWidth)
+    );
+    const aspect = region
+        ? (region.width * SOURCE_ASPECT) / region.height
+        : SOURCE_ASPECT;
+    const height = Math.min(
+        MAX_OUTPUT_HEIGHT,
+        Math.max(MIN_OUTPUT_HEIGHT, Math.round(width / aspect))
+    );
+
+    const filters = region
+        ? [
+              `crop=iw*${fraction(region.width)}:ih*${fraction(region.height)}:iw*${fraction(region.x)}:ih*${fraction(region.y)}`,
+              `fps=${PREVIEW_FRAMES_PER_SECOND}`,
+          ]
+        : [`fps=${PREVIEW_FRAMES_PER_SECOND}`];
+
+    return {
+        bounds: { x: 0, y: 0, width, height },
+        region,
+        options: [
+            // Nothing is heard from this session and no audio is decoded.
+            'ao=null',
+            'aid=no',
+            'mute=yes',
+            // Software filters need frames in system memory.
+            'hwdec=auto-copy',
+            `vf=lavfi=[${filters.join(',')}]`,
+            // A tiny picture must not hold large buffers.
+            'demuxer-max-bytes=8MiB',
+            'demuxer-max-back-bytes=1MiB',
+        ],
+    };
+}
