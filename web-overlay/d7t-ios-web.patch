+} from '@iptvnator/portal/shared/ui';
+import {
+    ContentType,
+    XtreamStore,
+} from '@iptvnator/portal/xtream/data-access';
+import {
+    normalizeTitleKeys,
+    plainDisplayText,
+    toXtreamRecentlyAddedTimestamp,
+} from '@iptvnator/shared/interfaces';
+import { TmdbApiService, TmdbRuntimeService } from '@iptvnator/services';
+import { IosCategoryRow } from '../ios-live/ios-category-sheet.component';
+import { IosCategorySheetService } from '../ios-live/ios-category-sheet.service';
+import { IosHiddenCategoriesService } from '../ios-live/ios-hidden-categories.service';
+
+interface BrowseItem {
+    readonly added?: string;
+    readonly category_id: string | number;
+    readonly cover?: string;
+    readonly id?: number;
+    readonly last_modified?: string;
+    readonly name?: string;
+    readonly poster_url?: string;
+    readonly series_id?: number;
+    readonly stream_id?: number;
+    readonly stream_icon?: string;
+    readonly title?: string;
+    readonly xtream_id?: number;
+}
+
+interface BrowseCategory {
+    readonly id: string;
+    readonly name: string;
+    readonly items: BrowseItem[];
+}
+
+interface CategoryTile {
+    readonly id: string;
+    readonly name: string;
+}
+
+/** Same split as Lume: a few real poster rails, every other category a light tile. */
+const RAIL_ITEMS = 20;
+const MAX_RAILS = 4;
+const RECENT_ITEMS = 20;
+/** A "Top 10 This Week" rail needs at least this many titles that are really in the library. */
+const MIN_TRENDING_MATCHES = 5;
+
+/**
+ * Movies / Series on the phone: a big title, "Recently Added" and one poster rail per category,
+ * each with "Show All" (the category's full grid). It reads the same store as the desktop views.
+ */
+@Component({
+    selector: 'app-ios-browse',
+    templateUrl: './ios-browse.component.html',
+    styleUrl: './ios-browse.component.scss',
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    imports: [ContentCardComponent, ContentRailShellComponent, RouterLink],
+})
+export class IosBrowseComponent {
+    private readonly store = inject(XtreamStore);
+    private readonly router = inject(Router);
+    private readonly route = inject(ActivatedRoute);
+    private readonly getVisible = this.store.getVisibleContentByType();
+    private readonly hiddenService = inject(IosHiddenCategoriesService);
+    private readonly sheets = inject(IosCategorySheetService);
+    private readonly tmdbApi = inject(TmdbApiService);
+    private readonly tmdbRuntime = inject(TmdbRuntimeService);
+
+    /** TMDB weekly trending for this kind of title, English (library titles are mostly English). */
+    private readonly trending = signal<string[]>([]);
+
+    readonly type: ContentType =
+        this.route.parent?.snapshot.routeConfig?.path === 'series'
+            ? 'series'
+            : 'vod';
+    readonly title = this.type === 'series' ? 'Series' : 'Movies';
+
+    private readonly playlistId = computed(
+        () => this.store.currentPlaylist()?.id ?? null
+    );
+
+    private readonly hiddenType = this.type === 'series' ? 'series' : 'vod';
+    private readonly hiddenIds = computed(() =>
+        this.hiddenService.hiddenIds(this.playlistId() ?? '', this.hiddenType)
+    );
+
+    /** Every item outside the categories the user hid (a local preference only). */
+    private readonly all = computed(() => {
+        const hidden = this.hiddenIds();
+        const items = this.getVisible(this.type) as BrowseItem[];
+        return hidden.size
+            ? items.filter((i) => !hidden.has(String(i.category_id)))
+            : items;
+    });
+
+    private readonly categoryList = computed(() => {
+        const list =
+            this.type === 'series'
+                ? this.store.serialCategories()
+                : this.store.vodCategories();
+        return (list as unknown as Array<Record<string, unknown>>).map((c) => ({
+            id: String(c['category_id'] ?? c['id'] ?? ''),
+            name: plainDisplayText(String(c['category_name'] ?? c['name'] ?? '')),
+        }));
+    });
+
+    readonly recent = computed(() => {
+        const now = Date.now();
+        const series = this.type === 'series';
+        return this.all()
+            .map((item) => ({
+                item,
+                at:
+                    toXtreamRecentlyAddedTimestamp(
+                        series ? item.last_modified : item.added,
+                        now
+                    ) ||
+                    toXtreamRecentlyAddedTimestamp(
+                        series ? item.added : item.last_modified,
+                        now
+                    ),
+            }))
+            .filter((entry) => entry.at > 0)
+            .sort((a, b) => b.at - a.at)
+            .slice(0, RECENT_ITEMS)
+            .map((entry) => entry.item);
+    });
+
+    /** The big card on top: the newest title, or the first title of the first rail. */
+    readonly featured = computed<BrowseItem | null>(
+        () => this.recent()[0] ?? this.categories()[0]?.items[0] ?? null
+    );
+
+    /**
+     * Trending titles (TMDB, this week) that are really in the library, in TMDB's order. Matching is
+     * by normalised title only, so it never guesses: a title that is not found is simply left out.
+     */
+    private readonly trendingInLibrary = computed<BrowseItem[]>(() => {
+        const wanted = this.trending();
+        if (!wanted.length) return [];
+        const byKey = new Map<string, BrowseItem>();
+        for (const item of this.all()) {
+            const key = normalizeTitleKeys(item.title || item.name || '').exact;
+            if (key && !byKey.has(key)) byKey.set(key, item);
+        }
+        const out: BrowseItem[] = [];
+        const seen = new Set<BrowseItem>();
+        for (const title of wanted) {
+            const hit = byKey.get(normalizeTitleKeys(title).exact);
+            if (hit && !seen.has(hit)) {
+                seen.add(hit);
+                out.push(hit);
+            }
+            if (out.length >= 10) break;
+        }
+        return out;
+    });
+
+    /** True when the numbered rail is TMDB's trending list, false when it is the newest ten. */
+    readonly topIsTrending = computed(
+        () => this.trendingInLibrary().length >= MIN_TRENDING_MATCHES
+    );
+
+    /** Numbered rail: this week's trending titles found in the library, else the ten newest. */
+    readonly topTen = computed<BrowseItem[]>(() =>
+        this.topIsTrending()
+            ? this.trendingInLibrary()
+            : this.recent().slice(0, 10)
+    );
+
+    /** Category pills under the title; "Show All" for the rest stays in Categories. */
+    readonly genres = computed(() =>
+        this.categoryList()
+            .filter((c) => c.id && !this.hiddenIds().has(c.id))
+            .slice(0, 10)
+    );
+
+    /** The subscription these titles come from. */
+    readonly sourceName = computed(() => {
+        const playlist = this.store.currentPlaylist() as
+            | { title?: string; name?: string }
+            | null
+            | undefined;
+        return plainDisplayText(playlist?.title || playlist?.name || '');
+    });
+
+    readonly categories = computed<BrowseCategory[]>(() => {
+        const hidden = this.hiddenIds();
+        const groups = new Map<string, BrowseItem[]>();
+        for (const item of this.all()) {
+            const id = String(item.category_id);
+            const group = groups.get(id);
+            if (group) {
+                if (group.length < RAIL_ITEMS) group.push(item);
+            } else {
+                groups.set(id, [item]);
+            }
+        }
+        const result: BrowseCategory[] = [];
+        for (const { id, name } of this.categoryList()) {
+            if (!id || hidden.has(id)) continue;
+            const items = groups.get(id);
+            if (items?.length) result.push({ id, name, items });
+            if (result.length >= MAX_RAILS) break;
+        }
+        return result;
+    });
+
+    /** Every visible category that is not already a rail. */
+    readonly tiles = computed<CategoryTile[]>(() => {
+        const hidden = this.hiddenIds();
+        const railIds = new Set(this.categories().map((c) => c.id));
+        return this.categoryList().filter(
+            (c) => c.id && !hidden.has(c.id) && !railIds.has(c.id)
+        );
+    });
+
+    private readonly sheetRows = computed<IosCategoryRow[]>(() => {
+        const counts = this.store.getCategoryItemCounts();
+        const hidden = this.hiddenIds();
+        return this.categoryList()
+            .filter((c) => c.id && !hidden.has(c.id))
+            .map((c) => ({
+                key: `c:${c.id}`,
+                name: c.name,
+                count: counts?.get(Number(c.id)) ?? null,
+                hideable: true,
+            }));
+    });
+
+    private readonly hiddenRows = computed<IosCategoryRow[]>(() => {
+        const hidden = this.hiddenIds();
+        return this.categoryList()
+            .filter((c) => hidden.has(c.id))
+            .map((c) => ({ key: `c:${c.id}`, name: c.name, hideable: false }));
+    });
+
+    readonly isLoading = computed(
+        () =>
+            this.all().length === 0 &&
+            (this.store.isLoadingContent() ||
+                this.store.isLoadingCategories() ||
+                this.store.isImporting())
+    );
+
+    constructor() {
+        effect(() => this.store.setSelectedContentType(this.type));
+        void this.loadTrending();
+    }
+
+    /** Best effort: with TMDB off, no key or no network the rail simply stays "Newest 10". */
+    private async loadTrending(): Promise<void> {
+        try {
+            if (!this.tmdbRuntime.isEnabled()) return;
+            const results = await this.tmdbApi.getTrending(
+                this.type === 'series' ? 'tv' : 'movie',
+                'en-US',
+                this.tmdbRuntime.apiKey()
+            );
+            const titles: string[] = [];
+            for (const r of results) {
+                for (const t of [r.title ?? r.name, r.original_title ?? r.original_name]) {
+                    if (t) titles.push(t);
+                }
+            }
+            this.trending.set(titles);
+        } catch (error) {
+            console.warn('TMDB trending (browse) failed:', error);
+        }
+    }
+
+    /** Same rule as the "NEW" badge in the design: added to the library within the last 14 days. */
+    isNew(item: BrowseItem): boolean {
+        const now = Date.now();
+        const raw = this.type === 'series' ? item.last_modified : item.added;
+        const at =
+            toXtreamRecentlyAddedTimestamp(raw, now) ||
+            toXtreamRecentlyAddedTimestamp(
+                this.type === 'series' ? item.added : item.last_modified,
+                now
+            );
+        return at > 0 && now - at <= 14 * 24 * 3600 * 1000;
+    }
+
+    openSources(): void {
+        void this.router.navigate(['/workspace', 'sources']);
+    }
+
+    openCategories(): void {
+        const playlist = this.playlistId() ?? '';
+        this.sheets.open({
+            rows: this.sheetRows,
+            hiddenRows: this.hiddenRows,
+            selectedKey: signal<string | null>(null),
+            onPick: (key) => {
+                const link = this.link(this.type, key.slice(2));
+                if (link) void this.router.navigate(link);
+            },
+            onHide: (key) =>
+                this.hiddenService.hide(playlist, this.hiddenType, key.slice(2)),
+            onRestore: (key) =>
+                this.hiddenService.restore(playlist, this.hiddenType, key.slice(2)),
+            onRestoreAll: () =>
+                this.hiddenService.restoreAll(playlist, this.hiddenType),
+        });
+    }
+
+    link(section: string, ...rest: Array<string | number>): string[] | null {
+        const id = this.playlistId();
+        return id
+            ? ['/workspace', 'xtreams', id, section, ...rest.map(String)]
+            : null;
+    }
+
+    poster(item: BrowseItem): string | undefined {
+        return item.poster_url || item.cover || item.stream_icon;
+    }
+
+    label(item: BrowseItem): string {
+        return plainDisplayText(item.title || item.name || '');
+    }
+
+    open(item: BrowseItem): void {
+        const id =
+            item.xtream_id ||
+            item.id ||
+            (this.type === 'series' ? item.series_id : item.stream_id);
+        void this.router.navigate(['..', this.type, item.category_id, id], {
+            relativeTo: this.route,
+        });
+    }
+}
