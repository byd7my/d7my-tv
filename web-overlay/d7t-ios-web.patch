+// ─────────────────────────────────────────────────────────────────────────────
+// One design language for the whole iPhone app, taken from Lume's SwiftUI source
+// (sizes read from Lume/Views: PosterCardMetrics, CategoryTileMetrics,
+// DetailMetrics, PrimaryPlayButton, LiveStreamCardView, EngineControlsOverlay,
+// sheets with .medium/.large detents).  Lume is the reference for proportions,
+// spacing, type scale, radii and hierarchy; D7my-TV supplies the features.
+//
+//   touch target   44        content inset   20       section gap   28
+//   row (list)     52        rail gap        16       tile radius   10
+//   card radius    12        poster radius   10       sheet radius  36
+//   primary button 50 tall   control button  44       toolbar icon  20–24
+//   type           large title 34/700 · title3 20/700 · headline 17/600
+//                  body 17 · subheadline 15 · footnote 13 · caption 12
+// ─────────────────────────────────────────────────────────────────────────────
+html.d7t-ios {
+    --l-inset: 20px;
+    --l-section: 28px;
+    --l-touch: 44px;
+    --l-row: 52px;
+    --l-r-card: 12px;
+    --l-r-tile: 10px;
+    --l-r-sheet: 36px;
+    --l-bg: #000;
+    --l-surface: #1c1c1e;
+    --l-surface-2: #2c2c2e;
+    --l-fill: rgba(118, 118, 128, 0.24);
+    --l-fill-strong: rgba(118, 118, 128, 0.4);
+    --l-sep: rgba(84, 84, 88, 0.65);
+    --l-label: #fff;
+    --l-label-2: rgba(235, 235, 245, 0.6);
+    --l-label-3: rgba(235, 235, 245, 0.3);
+    --l-tint: #0a84ff;
+    --l-danger: #ff453a;
+    --l-font: -apple-system, 'SF Pro Text', system-ui, sans-serif;
+}
+
+@media (max-width: 640px), (max-height: 480px) and (orientation: landscape) {
+    html.d7t-ios {
+        // ── Page titles: Lume's large navigation title ───────────────────────
+        .recently-added-page__title,
+        .sources-title,
+        app-workspace-settings-context-panel + * h2:first-child {
+            font-size: 34px !important;
+            font-weight: 700 !important;
+            letter-spacing: -0.02em;
+            line-height: 1.1;
+        }
+
+        // ── Rails (Home, Recently added): title3 header, 16 gap, 10-radius posters ─
+        .rail__title {
+            font-size: 20px !important;
+            font-weight: 700 !important;
+            letter-spacing: -0.01em;
+        }
+
+        .rail__chev {
+            display: none !important;
+        }
+
+        .rail__card,
+        .content-card,
+        .content-card__activation {
+            border-radius: var(--l-r-tile) !important;
+        }
+
+        // ── Buttons ──────────────────────────────────────────────────────────
+        // Control buttons: 44 tall capsules on a quiet fill (Lume's bordered style).
+        .mdc-button,
+        .mat-mdc-button,
+        .mat-mdc-outlined-button,
+        .mat-mdc-unelevated-button,
+        .mat-mdc-raised-button {
+            min-height: var(--l-touch);
+            border-radius: 999px !important;
+            font-family: var(--l-font);
+            font-size: 15px;
+            font-weight: 600;
+            letter-spacing: 0;
+        }
+
+        .mat-mdc-outlined-button {
+            border: 0 !important;
+            background: var(--l-fill);
+            color: var(--l-label);
+        }
+
+        .mat-mdc-button:not(.mat-mdc-icon-button) {
+            color: var(--l-tint);
+        }
+
+        // Primary action: 50 tall, white fill with dark label (Lume's PrimaryPlayButton).
+        .mat-mdc-unelevated-button.mat-primary,
+        .mat-mdc-raised-button.mat-primary,
+        .mat-mdc-unelevated-button:not([disabled]):not(.mat-warn),
+        .mat-mdc-raised-button:not([disabled]):not(.mat-warn) {
+            min-height: 50px;
+            padding-inline: 24px;
+            background: #fff !important;
+            color: #000 !important;
+            font-size: 17px;
+            box-shadow: none !important;
+        }
+
+        .mat-mdc-icon-button {
+            width: var(--l-touch) !important;
+            height: var(--l-touch) !important;
+            padding: 10px !important;
+        }
+
+        // ── Fields: filled 12-radius controls, no outlines ───────────────────
+        .mat-mdc-form-field {
+            .mdc-notched-outline__leading,
+            .mdc-notched-outline__notch,
+            .mdc-notched-outline__trailing {
+                border-color: transparent !important;
+            }
+
+            .mdc-text-field--outlined {
+                background: var(--l-fill);
+                border-radius: 12px;
+                min-height: var(--l-touch);
+            }
+
+            .mat-mdc-select-value,
+            input {
+                font-size: 17px;
+            }
+        }
+
+        .settings-select {
+            width: 100%;
+        }
+
+        // ── Grouped cards (Settings and friends): inset-grouped list look ─────
+        .settings-card {
+            background: var(--l-surface) !important;
+            border: 0 !important;
+            border-radius: var(--l-r-card) !important;
+            box-shadow: none !important;
+            padding: 16px !important;
+        }
+
+        .settings-card h3,
+        .settings-card .settings-card__title {
+            font-size: 17px;
+            font-weight: 600;
+        }
+
+        // ── Dialogs: a bottom sheet with a 36 radius (medium/large detent) ─────
+        .cdk-global-overlay-wrapper:has(.mat-mdc-dialog-panel) {
+            align-items: flex-end !important;
+            justify-content: stretch !important;
+        }
+
+        .mat-mdc-dialog-panel {
+            width: 100% !important;
+            max-width: 100% !important;
+            max-height: calc(100dvh - env(safe-area-inset-top) - 12px) !important;
+            margin: 0 !important;
+        }
+
+        .mat-mdc-dialog-container .mdc-dialog__surface {
+            border-radius: var(--l-r-sheet) var(--l-r-sheet) 0 0 !important;
+            background: var(--l-surface) !important;
+            box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.45) !important;
+            padding-bottom: env(safe-area-inset-bottom);
+        }
+
+        .mat-mdc-dialog-title {
+            font-size: 17px !important;
+            font-weight: 700 !important;
+            text-align: center;
+        }
+
+        .mat-mdc-dialog-actions {
+            gap: 10px;
+            padding: 12px 20px 16px !important;
+            justify-content: flex-end;
+        }
+
+        // ── Menus: 14 radius glass, 44 rows, 17pt ────────────────────────────
+        .mat-mdc-menu-panel {
+            border-radius: 14px !important;
+            background: rgba(44, 44, 46, 0.92) !important;
+            -webkit-backdrop-filter: blur(30px) saturate(1.8);
+            backdrop-filter: blur(30px) saturate(1.8);
+            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5) !important;
+            min-width: 220px;
+        }
+
+        .mat-mdc-menu-item {
+            min-height: var(--l-touch) !important;
+            font-size: 17px;
+        }
+
+        // ── Snackbar, tooltips ───────────────────────────────────────────────
+        .mat-mdc-snack-bar-container .mdc-snackbar__surface {
+            border-radius: 14px !important;
+        }
+
+        // ── Switch: 51 × 31 with a 27 thumb, like UISwitch ───────────────────
+        .mdc-switch {
+            --mat-switch-track-width: 51px;
+            --mat-switch-track-height: 31px;
+            --mat-switch-track-shape: 16px;
+            --mat-switch-selected-handle-width: 27px;
+            --mat-switch-selected-handle-height: 27px;
+            --mat-switch-unselected-handle-width: 27px;
+            --mat-switch-unselected-handle-height: 27px;
+            --mat-switch-selected-track-color: #30d158;
+            --mat-switch-selected-hover-track-color: #30d158;
+            --mat-switch-selected-focus-track-color: #30d158;
+            --mat-switch-selected-pressed-track-color: #30d158;
+            --mat-switch-unselected-track-color: rgba(120, 120, 128, 0.32);
+            --mat-switch-selected-handle-color: #fff;
+            --mat-switch-unselected-handle-color: #fff;
+        }
+    }
+}
+
+// ═════════════ Audio panel, Auto Sync window, sync bar: compact grouped rows ═════════════
+// Source of truth: audio-sync-window.component.{html,scss} and split-audio-panel.component.*
+// (shared with desktop and untouched there).  On the phone the window was a stack of cards: two
+// 220 px pictures, three result rows, a verdict, a stepper, a chip row and two buttons — about
+// 740 px tall.  Here it is Lume's settings pattern: an inset-grouped list of 44–52 px rows, the
+// clock crops shrunk to thumbnails beside their readouts, one 44 px primary action.
+@media (max-width: 640px), (max-height: 480px) and (orientation: landscape) {
+    html.d7t-ios {
+        // One frame for both panels.
+        .player-controls__split-audio-panel .split-audio,
+        app-audio-sync-window > .sync {
+            gap: 0 !important;
+            padding: 0 !important;
+            background: rgba(28, 28, 30, 0.96) !important;
+            -webkit-backdrop-filter: blur(30px) saturate(1.8);
+            backdrop-filter: blur(30px) saturate(1.8);
+            border: 0 !important;
+            border-radius: 24px !important;
+            box-shadow:
+                inset 0 0 0 0.5px rgba(255, 255, 255, 0.14),
+                0 18px 60px rgba(0, 0, 0, 0.55) !important;
+            color: var(--l-label);
+            font-family: var(--l-font);
+            font-size: 15px;
+            overflow-x: hidden;
+            overflow-y: auto !important;
+            overscroll-behavior: contain;
+        }
+
+        // Header: 48 tall, 17/600 title, 36 round buttons.
+        .split-audio__header,
+        .sync__header {
+            min-height: 48px;
+            padding: 0 8px 0 16px !important;
+            gap: 8px;
+            border-bottom: 0.5px solid var(--l-sep) !important;
+            background: transparent !important;
+        }
+
+        .split-audio__title,
+        .sync__title {
+            font-size: 17px !important;
+            font-weight: 600 !important;
+            letter-spacing: -0.01em;
+        }
+
+        .split-audio__header-icon,
+        .sync__header-icon {
+            width: 20px;
+            height: 20px;
+            font-size: 20px;
+            color: var(--l-tint) !important;
+        }
+
+        .split-audio__icon-button,
+        .sync__icon-button,
+        .sync-bar__close {
+            width: 36px !important;
+            height: 36px !important;
+            border: 0 !important;
+            border-radius: 50% !important;
+            background: var(--l-fill) !important;
+            color: var(--l-label) !important;
+        }
+
+        .sync__icon-button--small {
+            width: 32px !important;
+            height: 32px !important;
+        }
+
+        // ── Audio channel list: 52 rows with inset hairlines ───────────────────
+        .split-audio__source {
+            display: flex;
+            align-items: center;
+            gap: 12px;
+            min-height: var(--l-touch);
+            margin: 10px 12px 0;
+            padding: 0 12px !important;
+            border-radius: var(--l-r-card);
+            background: var(--l-surface-2);
+            font-size: 17px;
+            color: var(--l-label);
+
+            select {
+                flex: 1;
+                min-height: var(--l-touch);
+                border: 0 !important;
+                background: transparent !important;
+                color: var(--l-tint) !important;
+                font-size: 17px;
+                text-align: right;
+            }
+        }
+
+        .split-audio__list {
+            margin: 10px 12px 12px;
+            padding: 0 !important;
+            border-radius: var(--l-r-card);
+            background: var(--l-surface-2);
+            overflow: hidden;
+        }
+
+        .split-audio__row {
+            min-height: var(--l-row);
+            padding: 0 4px 0 16px !important;
+            border: 0 !important;
+            border-radius: 0 !important;
+            background: transparent !important;
+            font-size: 17px;
+
+            & + .split-audio__row {
+                border-top: 0.5px solid var(--l-sep) !important;
+            }
+        }
+
+        .split-audio__name {
+            font-size: 17px !important;
+            font-weight: 400;
+        }
+
+        .split-audio__search input {
+            min-height: 40px;
+            margin: 10px 12px 0;
+            padding: 0 14px;
+            border: 0 !important;
+            border-radius: 999px !important;
+            background: var(--l-fill) !important;
+            color: var(--l-label) !important;
+            font-size: 17px;
+        }
+
+        .split-audio__empty,
+        .split-audio__hints {
+            padding: 12px 20px;
+            font-size: 13px;
+            line-height: 1.35;
+            color: var(--l-label-2);
+            text-align: center;
+        }
+
+        .split-audio__footer {
+            gap: 8px;
+            padding: 8px 12px 12px;
+        }
+
+        // ── Auto / Manual section of the audio panel (app-split-sync-section) ──────
+        .sync-section {
+            display: flex;
+            flex-direction: column;
+            gap: 0 !important;
+            padding: 10px 12px 0 !important;
+        }
+
+        .sync-section__modes {
+            display: flex;
+            gap: 2px;
+            padding: 2px;
+            border-radius: 10px;
+            background: var(--l-fill);
+        }
+
+        .sync-section__mode {
+            flex: 1;
+            min-height: 32px;
+            padding: 0 10px !important;
+            border: 0 !important;
+            border-radius: 8px !important;
+            background: transparent !important;
+            color: var(--l-label) !important;
+            font-size: 15px;
+            font-weight: 600;
+        }
+
+        .sync-section__mode[aria-pressed='true'],
+        .sync-section__mode--on,
+        .sync-section__mode[aria-checked='true'] {
+            background: #636366 !important;
+        }
+
+        .sync-section__hint,
+        .sync-section__summary {
+            margin: 0;
+            padding: 8px 4px 0;
+            font-size: 13px;
+            line-height: 1.35;
+            color: var(--l-label-2);
+        }
+
+        .sync-section__start {
+            display: flex;
+            align-items: center;
+            justify-content: center;
+            gap: 8px;
+            width: 100%;
+            min-height: var(--l-touch) !important;
+            margin: 10px 0 0 !important;
+            padding: 0 20px !important;
+            border: 0 !important;
+            border-radius: 999px !important;
+            background: #fff !important;
+            color: #000 !important;
+            font-size: 17px !important;
+            font-weight: 600 !important;
+            box-shadow: none !important;
+        }
+
+        // The two secondary tools (choose clock regions / quick sync): rows, not tiles.
+        .sync-section__tools {
+            display: flex !important;
+            flex-direction: column;
+            gap: 0 !important;
+            margin-top: 10px;
+            border-radius: var(--l-r-card);
+            background: var(--l-surface-2);
+            overflow: hidden;
+        }
+
+        .sync-section__tool {
+            display: flex !important;
+            flex-direction: row !important;
+            align-items: center;
+            justify-content: flex-start;
+            gap: 12px;
+            min-height: var(--l-touch);
+            padding: 0 16px !important;
+            border: 0 !important;
+            border-radius: 0 !important;
+            background: transparent !important;
+            color: var(--l-label) !important;
+            font-size: 17px;
+            text-align: left;
+
+            mat-icon {
+                width: 22px;
+                height: 22px;
+                font-size: 22px;
+                color: var(--l-tint);
+            }
+
+            & + .sync-section__tool {
+                border-top: 0.5px solid var(--l-sep) !important;
+            }
+
+            &[disabled] {
+                opacity: 0.4;
+            }
+        }
+
+        .sync-section__nudges {
+            display: flex;
+            gap: 6px;
+            margin-top: 8px;
+        }
+
+        .sync-section__nudge {
+            flex: 1;
+            min-height: 36px;
+            border: 0 !important;
+            border-radius: 999px !important;
+            background: var(--l-fill) !important;
+            color: var(--l-label) !important;
+            font-size: 15px;
+            font-weight: 600;
+        }
+
+        .sync-section__link {
+            min-height: var(--l-touch);
+            color: var(--l-tint) !important;
+            font-size: 15px;
+        }
+
+        // "Sync audio by clock" opener when no split is running.
+        .split-audio__sync {
+            display: flex;
+            align-items: center;
+            gap: 12px;
+            width: calc(100% - 24px);
+            min-height: var(--l-touch);
+            margin: 10px 12px 0;
+            padding: 0 16px !important;
+            border: 0 !important;
+            border-radius: var(--l-r-card) !important;
+            background: var(--l-surface-2) !important;
+            color: var(--l-label) !important;
+            font-size: 17px;
+            text-align: left;
+
+            mat-icon {
+                color: var(--l-tint);
+            }
+        }
+
+        .split-audio__divider {
+            display: none;
+        }
+
+        .split-audio__save,
+        .split-audio__original {
+            min-height: var(--l-touch);
+            border: 0 !important;
+            border-radius: 999px !important;
+            background: var(--l-fill) !important;
+            color: var(--l-label) !important;
+            font-size: 15px;
+            font-weight: 600;
+        }
+
+        // ── Auto Sync window ────────────────────────────────────────────────────
+        // Notice / hint lines: footnote, secondary.
+        .sync__notice,
+        .sync__hint,
+        .sync__error {
+            margin: 0;
+            padding: 8px 16px 0;
+            background: transparent !important;
+            border: 0 !important;
+            font-size: 13px;
+            line-height: 1.35;
+            color: var(--l-label-2);
+        }
+
+        .sync__error {
+            color: var(--l-danger);
+        }
+
+        // Each source (main video / audio channel) is one grouped row: caption on top, the clock
+        // crop as a 52 px strip on the left, its readout on the right.
+        .sync__source {
+            display: grid !important;
+            grid-template-columns: minmax(0, 1fr) auto;
+            grid-template-areas: 'label label' 'shot readout';
+            align-items: center;
+            gap: 4px 12px;
+            margin: 10px 12px 0;
+            padding: 10px 12px;
+            border-radius: var(--l-r-card);
+            background: var(--l-surface-2);
+
+            &[hidden] {
+                display: none !important;
+            }
+        }
+
+        .sync__label {
+            grid-area: label;
+            font-size: 13px;
+            font-weight: 600;
+            color: var(--l-label-2);
+        }
+
+        .sync__shot:not(.sync__shot--picking) {
+            grid-area: shot;
+            min-height: 0 !important;
+            height: 52px;
+            border-radius: 8px;
+
+            .sync__canvas {
+                height: 52px !important;
+                max-height: 52px !important;
+                width: 100% !important;
+                object-fit: contain;
+            }
+        }
+
+        .sync__readout {
+            grid-area: readout;
+            display: flex;
+            align-items: center;
+            gap: 8px;
+        }
+
+        .sync__clock {
+            font-size: 22px;
+            font-weight: 600;
+            font-variant-numeric: tabular-nums;
+        }
+
+        .sync__badge {
+            padding: 2px 8px;
+            border-radius: 999px;
+            font-size: 12px;
+            font-weight: 600;
+        }
+
+        // Result: an inset-grouped list, rows 40 tall, the difference in headline weight.
+        .sync__result {
+            margin: 10px 12px 0;
+            border-radius: var(--l-r-card);
+            background: var(--l-surface-2);
+            overflow: hidden;
+            gap: 0 !important;
+            padding: 0 !important;
+
+            &:empty {
+                display: none;
+            }
+        }
+
+        .sync__row {
+            display: flex;
+            align-items: center;
+            justify-content: space-between;
+            min-height: 40px;
+            padding: 0 16px;
+            font-size: 15px;
+
+            & + .sync__row,
+            & + .sync__verdict {
+                border-top: 0.5px solid var(--l-sep);
+            }
+
+            strong {
+                font-size: 17px;
+                font-weight: 600;
+                font-variant-numeric: tabular-nums;
+            }
+        }
+
+        .sync__row--dim {
+            color: var(--l-label-2);
+            font-size: 13px;
+            min-height: 32px;
+        }
+
+        .sync__verdict {
+            display: flex;
+            align-items: center;
+            gap: 8px;
+            min-height: 40px;
+            padding: 0 16px;
+            font-size: 15px;
+            font-weight: 600;
+            background: transparent !important;
+            border-radius: 0 !important;
+        }
+
+        // Primary actions: 44 tall capsules (white, dark label) — Lume's PrimaryPlayButton at the
+        // control size; inside the result group it sits flush as a full-width row button.
+        .sync__primary,
+        .sync__actions .sync__primary {
+            min-height: var(--l-touch) !important;
+            margin: 10px 12px 0;
+            padding: 0 20px !important;
+            border: 0 !important;
+            border-radius: 999px !important;
+            background: #fff !important;
+            color: #000 !important;
+            font-size: 17px !important;
+            font-weight: 600 !important;
+            box-shadow: none !important;
+
+            &[disabled] {
+                opacity: 0.4;
+            }
+        }
+
+        .sync__result .sync__primary {
+            width: calc(100% - 24px);
+            margin: 8px 12px 12px;
+        }
+
+        .sync__link {
+            min-height: var(--l-touch);
+            padding: 0 16px;
+            border: 0;
+            background: transparent;
+            color: var(--l-tint) !important;
+            font-size: 15px;
+            font-weight: 600;
+            text-decoration: none !important;
+        }
+
+        .sync__actions {
+            display: flex;
+            flex-direction: column;
+            align-items: stretch;
+            gap: 0 !important;
+            padding-bottom: 8px;
+        }
+
+        // Picking (the clock reader): a segmented control, a frame capped at 180, then actions.
+        .sync__tabs {
+            display: flex;
+            gap: 2px;
+            margin: 10px 12px 0;
+            padding: 2px;
+            border-radius: 10px;
+            background: var(--l-fill);
+        }
+
+        .sync__tab {
+            flex: 1;
