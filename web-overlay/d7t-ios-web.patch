+++ b/apps/web/src/app/ios/ios-mpv-host.ts
@@ -0,0 +1,746 @@
+import type {
+    ElectronBridgeApi,
+    EmbeddedMpvBounds,
+    EmbeddedMpvFrameCapture,
+    EmbeddedMpvFrameRegion,
+    EmbeddedMpvSession,
+    EmbeddedMpvSupport,
+    ResolvedPortalPlayback,
+    SplitAudioSyncAction,
+} from '@iptvnator/shared/interfaces';
+import { getD7tNative } from './ios-bridge';
+import type { SplitAudioAddon } from './split/embedded-mpv-split-audio-addon';
+import { EmbeddedMpvSplitAudioManager } from './split/embedded-mpv-split-audio-manager';
+
+/**
+ * The embedded-MPV half of the desktop bridge, for the iPhone app.
+ *
+ * The desktop main process owns the mpv sessions and reports them back as
+ * `EmbeddedMpvSession` snapshots. Here the sessions are real libmpv players
+ * drawn by the phone app behind this (transparent) page; this file keeps the
+ * snapshots and forwards each command. It is installed as `window.d7tMpv`
+ * (never `window.electron`), so the rest of the app stays in its web mode.
+ */
+
+type Listener = (session: EmbeddedMpvSession) => void;
+
+interface MpvEventPayload {
+    sid: string;
+    type: string;
+    [key: string]: unknown;
+}
+
+interface TrackInfo {
+    id: number;
+    type: string;
+    title?: string;
+    lang?: string;
+    selected?: boolean;
+    isDefault?: boolean;
+}
+
+const POSITION_PUBLISH_MS = 500;
+
+interface FrameSlot {
+    sid: string | null;
+    region: EmbeddedMpvFrameRegion | null;
+    maxWidth: number;
+    busy: boolean;
+    timer: number | null;
+    last: (EmbeddedMpvFrameCapture & { at: number; region: EmbeddedMpvFrameRegion | null }) | null;
+    seq: number;
+    askedAt?: number;
+}
+
+const FRAME_PUMP_MS = 350;
+const FRAME_IDLE_MS = 4000;
+const noop = (): void => undefined;
+
+const newSlot = (): FrameSlot => ({
+    sid: null,
+    region: null,
+    maxWidth: 640,
+    busy: false,
+    timer: null,
+    last: null,
+    seq: 0,
+});
+
+const sameRegion = (
+    a: EmbeddedMpvFrameRegion | null,
+    b: EmbeddedMpvFrameRegion | null
+): boolean =>
+    a === null || b === null
+        ? a === b
+        : Math.abs(a.x - b.x) < 1e-3 &&
+          Math.abs(a.y - b.y) < 1e-3 &&
+          Math.abs(a.width - b.width) < 1e-3 &&
+          Math.abs(a.height - b.height) < 1e-3;
+
+class IosMpvHost {
+    private readonly listeners = new Set<Listener>();
+    private readonly sessions = new Map<string, EmbeddedMpvSession>();
+    private readonly lastPublish = new Map<string, number>();
+    private readonly lastStatus = new Map<string, string>();
+    /** The hidden "sound" sessions of the two-session audio mode (the page never sees them). */
+    private readonly hidden = new Set<string>();
+    private mainSessionId: string | null = null;
+    private soundRegion: EmbeddedMpvFrameRegion | null = null;
+    private counter = 0;
+    private readonly frames: Record<'main' | 'preview', FrameSlot> = {
+        main: newSlot(),
+        preview: newSlot(),
+    };
+
+    /** What the two-session pair reads and drives (the manager is the desktop's own code). */
+    private readonly splitAddon: SplitAudioAddon = {
+        setPaused: (id, paused) => {
+            // The pair reads the session's status right away (a freeze checks that it really holds).
+            const session = this.sessions.get(id);
+            if (session && session.status !== 'loading') session.status = paused ? 'paused' : 'playing';
+            void this.native('mpv.paused', { sid: id, paused }).catch(noop);
+        },
+        seek: (id, seconds) =>
+            void this.native('mpv.seek', { sid: id, seconds }).catch(noop),
+        seekBy: (id, delta) =>
+            void this.native('mpv.seekBy', { sid: id, seconds: delta }).catch(noop),
+        setSpeed: (id, speed) => {
+            const session = this.sessions.get(id);
+            if (session) session.playbackSpeed = speed;
+            void this.native('mpv.speed', { sid: id, speed }).catch(noop);
+        },
+        setVolume: (id, volume) => {
+            const session = this.sessions.get(id);
+            if (session) session.volume = volume;
+            void this.native('mpv.volume', { sid: id, volume: toMpvVolume(volume) }).catch(noop);
+        },
+        getSessionSnapshot: (id) => {
+            const s = this.sessions.get(id);
+            if (!s) return null;
+            return {
+                status: s.status,
+                positionSeconds: s.positionSeconds,
+                volume: s.volume,
+                playbackSpeed: s.playbackSpeed,
+                stats: {
+                    bufferedAheadSeconds: s.stats?.bufferedAheadSeconds,
+                },
+            };
+        },
+    };
+
+    private readonly split = new EmbeddedMpvSplitAudioManager({
+        addon: () => this.splitAddon,
+        usesFrameCopy: () => true,
+        now: () => Date.now(),
+        createSession: (bounds, title, volume) =>
+            this.createHiddenSession(bounds, title, volume),
+        // The sound's own session is not a new picture: it must not announce itself as the primary
+        // playback (that would reset the chosen audio and hide the sync controls).
+        loadPlayback: (id, playback) => void this.loadEmbeddedMpvPlayback(id, playback, false),
+        setPaused: (id, paused) => void this.setEmbeddedMpvPaused(id, paused),
+        seekBy: (id, delta) => void this.seekEmbeddedMpvBy(id, delta),
+        disposeSession: (id) => void this.disposeEmbeddedMpvSession(id),
+        warn: (message, error) => console.warn(`[split-audio] ${message}`, error),
+    });
+
+    constructor() {
+        getD7tNative()?.on('mpv', (payload) =>
+            this.onEvent(payload as MpvEventPayload)
+        );
+        window.setInterval(() => this.tickSplit(), 500);
+    }
+
+    /** About twice a second, like the desktop's polling: the pair steers, the page gets its status. */
+    private tickSplit(): void {
+        this.split.tick();
+        for (const id of this.sessions.keys()) {
+            if (!this.hidden.has(id) && this.split.pairOf(id)) this.publish(id, true);
+        }
+    }
+
+    private createHiddenSession(
+        _bounds: EmbeddedMpvBounds,
+        title: string,
+        volume: number
+    ): string {
+        const id = `ios-s-${Date.now().toString(36)}-${++this.counter}`;
+        const now = new Date().toISOString();
+        this.hidden.add(id);
+        this.sessions.set(id, {
+            id,
+            title,
+            streamUrl: '',
+            status: 'loading',
+            positionSeconds: 0,
+            durationSeconds: null,
+            volume,
+            audioTracks: [],
+            selectedAudioTrackId: null,
+            subtitleTracks: [],
+            selectedSubtitleTrackId: null,
+            playbackSpeed: 1,
+            aspectOverride: 'auto',
+            startedAt: now,
+            updatedAt: now,
+        });
+        void this.native('mpv.create', {
+            sid: id,
+            bounds: { x: 0, y: 0, width: 2, height: 2 },
+            hidden: true,
+            volume: toMpvVolume(volume),
+        }).catch((error) => console.warn('[split-audio] sound session failed', error));
+        return id;
+    }
+
+    private native(method: string, args: Record<string, unknown>) {
+        const native = getD7tNative();
+        if (!native) {
+            return Promise.reject(new Error('native bridge missing'));
+        }
+        return native.call<unknown>(method, args);
+    }
+
+    // ------------------------------------------------------------ session state
+
+    private publish(id: string, force = true): EmbeddedMpvSession | null {
+        const session = this.sessions.get(id);
+        if (!session) return null;
+        const now = Date.now();
+        if (!force && now - (this.lastPublish.get(id) ?? 0) < POSITION_PUBLISH_MS) {
+            return session;
+        }
+        this.lastPublish.set(id, now);
+        session.updatedAt = new Date(now).toISOString();
+        const previous = this.lastStatus.get(id) ?? null;
+        if (previous !== session.status) {
+            this.lastStatus.set(id, session.status);
+            this.split.onStatus(id, session.status, previous, false, session.error);
+        }
+        const copy = { ...session };
+        if (this.hidden.has(id)) return copy;
+        this.split.decorate(copy);
+        this.listeners.forEach((listener) => listener(copy));
+        return copy;
+    }
+
+    private update(id: string, change: Partial<EmbeddedMpvSession>, force = true) {
+        const session = this.sessions.get(id);
+        if (!session) return null;
+        Object.assign(session, change);
+        return this.publish(id, force);
+    }
+
+    private onEvent(event: MpvEventPayload): void {
+        const { sid } = event;
+        const session = this.sessions.get(sid);
+        if (!session) return;
+        switch (event.type) {
+            case 'load': {
+                const duration = Number(event['duration']) || 0;
+                this.update(sid, {
+                    status: session.status === 'paused' ? 'paused' : 'playing',
+                    durationSeconds: duration > 0 && isFinite(duration) ? duration : null,
+                    videoWidth: Number(event['width']) || undefined,
+                    videoHeight: Number(event['height']) || undefined,
+                });
+                void this.refreshTracks(sid);
+                break;
+            }
+            case 'progress': {
+                const duration = Number(event['duration']) || 0;
+                this.update(
+                    sid,
+                    {
+                        positionSeconds: Number(event['position']) || 0,
+                        durationSeconds:
+                            duration > 0 && isFinite(duration) ? duration : session.durationSeconds,
+                        stats: {
+                            ...session.stats,
+                            bufferedAheadSeconds: Number(event['bufferedDuration']) || 0,
+                        },
+                    },
+                    false
+                );
+                break;
+            }
+            case 'state': {
+                const state = String(event['state']);
+                const status =
+                    state === 'playing' || state === 'buffering'
+                        ? 'playing'
+                        : state === 'paused'
+                          ? 'paused'
+                          : state === 'ended'
+                            ? 'ended'
+                            : state === 'loading'
+                              ? 'loading'
+                              : session.status;
+                if (status !== session.status) this.update(sid, { status });
+                break;
+            }
+            case 'buffer':
+                this.update(sid, {
+                    stats: { ...session.stats, buffering: !!event['isBuffering'] },
+                });
+                break;
+            case 'error':
+                this.update(sid, {
+                    status: 'error',
+                    error: String(event['error'] ?? 'playback error'),
+                });
+                break;
+            case 'end':
+                if (event['reason'] === 'error') {
+                    this.update(sid, { status: 'error', error: 'stream ended with an error' });
+                } else {
+                    this.update(sid, { status: 'ended' });
+                }
+                break;
+        }
+    }
+
+    private async refreshTracks(sid: string): Promise<void> {
+        try {
+            const result = (await this.native('mpv.tracks', { sid })) as {
+                tracks: TrackInfo[];
+                ids: { aid: number; sid: number };
+                media?: { videoCodec?: string; audioCodec?: string; hwdecCurrent?: string; fps?: number } | null;
+            };
+            const audio = result.tracks.filter((t) => t.type === 'audio');
+            const subs = result.tracks.filter((t) => t.type === 'sub');
+            const toTrack = (t: TrackInfo) => ({
+                id: t.id,
+                title: t.title || undefined,
+                language: t.lang || undefined,
+                selected: !!t.selected,
+                defaultTrack: !!t.isDefault,
+            });
+            const session = this.sessions.get(sid);
+            this.update(sid, {
+                audioTracks: audio.map(toTrack),
+                selectedAudioTrackId: result.ids.aid > 0 ? result.ids.aid : null,
+                subtitleTracks: subs.map(toTrack),
+                selectedSubtitleTrackId: result.ids.sid > 0 ? result.ids.sid : null,
+                stats: {
+                    ...session?.stats,
+                    videoCodec: result.media?.videoCodec || undefined,
+                    audioCodec: result.media?.audioCodec || undefined,
+                    hwdec: result.media?.hwdecCurrent || undefined,
+                    fps: result.media?.fps || undefined,
+                },
+            });
+        } catch {
+            /* tracks are optional */
+        }
+    }
+
+    // ------------------------------------------------------------ the bridge
+
+    readonly platform = 'ios';
+
+    onEmbeddedMpvSessionUpdate = (callback: Listener): (() => void) => {
+        this.listeners.add(callback);
+        return () => this.listeners.delete(callback);
+    };
+
+    getEmbeddedMpvSupport = async (): Promise<EmbeddedMpvSupport> => ({
+        supported: true,
+        platform: 'ios',
+        // The phone shows the same player chrome as the desktop's frame-copy engine (it carries the
+        // "audio from another channel" panel and the clock-sync window); the picture itself is still
+        // drawn by the native view behind the page, so the page canvas stays empty.
+        engine: 'frame-copy',
+        frameCopyAvailable: true,
+        capabilities: {
+            subtitles: true,
+            playbackSpeed: true,
+            aspectOverride: true,
+            screenshot: false,
+            recording: false,
+        },
+    });
+
+    prepareEmbeddedMpv = () => this.getEmbeddedMpvSupport();
+
+    createEmbeddedMpvSession = async (
+        bounds: EmbeddedMpvBounds,
+        title = '',
+        initialVolume = 100
+    ): Promise<EmbeddedMpvSession> => {
+        const id = `ios-${Date.now().toString(36)}-${++this.counter}`;
+        const now = new Date().toISOString();
+        const session: EmbeddedMpvSession = {
+            id,
+            title,
+            streamUrl: '',
+            status: 'loading',
+            positionSeconds: 0,
+            durationSeconds: null,
+            volume: initialVolume,
+            audioTracks: [],
+            selectedAudioTrackId: null,
+            subtitleTracks: [],
+            selectedSubtitleTrackId: null,
+            playbackSpeed: 1,
+            aspectOverride: 'auto',
+            startedAt: now,
+            updatedAt: now,
+        };
+        this.sessions.set(id, session);
+        this.mainSessionId = id;
+        // Two-session audio is always available on the phone: the clock of the other channel is read
+        // from its hidden player (see the frame calls below).
+        this.split.allow(id, { extraOptions: [], autoReconnect: true, splitAudio: true }, 0);
+        await this.native('mpv.create', { sid: id, bounds, volume: toMpvVolume(initialVolume) });
+        const copy = { ...session };
+        this.split.decorate(copy);
+        return copy;
+    };
+
+    loadEmbeddedMpvPlayback = async (
+        sessionId: string,
+        playback: ResolvedPortalPlayback,
+        isPicture = true
+    ): Promise<void> => {
+        if (isPicture) {
+            // A new picture ends the audio channel that belonged to the old one.
+            this.split.onUserLoad(sessionId);
+            // Whatever page started it (Live, Recently viewed, Favorites, Search), the sound picker
+            // must know which channel is the picture; see SplitAudioCatalogService.
+            window.dispatchEvent(
+                new CustomEvent('d7t-primary-playback', {
+                    detail: { url: playback.streamUrl, title: playback.title },
+                })
+            );
+        }
+        this.update(sessionId, {
+            streamUrl: playback.streamUrl,
+            title: playback.title,
+            status: 'loading',
+            error: undefined,
+        });
+        await this.native('mpv.load', {
+            sid: sessionId,
+            url: playback.streamUrl,
+            headers: playback.headers,
+            userAgent: playback.userAgent,
+            referer: playback.referer,
+            startPosition: playback.startTime,
+        });
+    };
+
+    setEmbeddedMpvBounds = async (sessionId: string, bounds: EmbeddedMpvBounds): Promise<void> => {
+        await this.native('mpv.bounds', { sid: sessionId, bounds });
+    };
+
+    setEmbeddedMpvPaused = async (sessionId: string, paused: boolean) => {
+        await this.native('mpv.paused', { sid: sessionId, paused });
+        this.split.onSetPaused(sessionId, paused);
+        return this.update(sessionId, { status: paused ? 'paused' : 'playing' });
+    };
+
+    seekEmbeddedMpv = async (sessionId: string, seconds: number) => {
+        this.split.onSeekTo(sessionId, seconds);
+        await this.native('mpv.seek', { sid: sessionId, seconds });
+        return this.update(sessionId, { positionSeconds: seconds });
+    };
+
+    seekEmbeddedMpvBy = async (sessionId: string, deltaSeconds: number) => {
+        this.split.onSeekBy(sessionId, deltaSeconds);
+        await this.native('mpv.seekBy', { sid: sessionId, seconds: deltaSeconds });
+        return this.sessions.get(sessionId) ?? null;
+    };
+
+    setEmbeddedMpvVolume = async (sessionId: string, volume: number) => {
+        if (!this.split.onSetVolume(sessionId, volume)) {
+            await this.native('mpv.volume', { sid: sessionId, volume: toMpvVolume(volume) });
+        }
+        return this.update(sessionId, { volume });
+    };
+
+    setEmbeddedMpvSpeed = async (sessionId: string, speed: number) => {
+        if (!this.split.onSetSpeed(sessionId, speed)) {
+            await this.native('mpv.speed', { sid: sessionId, speed });
+        }
+        return this.update(sessionId, { playbackSpeed: speed });
+    };
+
+    setEmbeddedMpvAudioTrack = async (sessionId: string, trackId: number) => {
+        await this.native('mpv.audioTrack', { sid: sessionId, trackId });
+        const session = this.sessions.get(sessionId);
+        return this.update(sessionId, {
+            selectedAudioTrackId: trackId,
+            audioTracks: (session?.audioTracks ?? []).map((t) => ({ ...t, selected: t.id === trackId })),
+        });
+    };
+
+    setEmbeddedMpvSubtitleTrack = async (sessionId: string, trackId: number) => {
+        await this.native('mpv.subTrack', { sid: sessionId, trackId });
+        const session = this.sessions.get(sessionId);
+        return this.update(sessionId, {
+            selectedSubtitleTrackId: trackId > 0 ? trackId : null,
+            subtitleTracks: (session?.subtitleTracks ?? []).map((t) => ({ ...t, selected: t.id === trackId })),
+        });
+    };
+
+    setEmbeddedMpvSubtitleDelay = async (sessionId: string, seconds: number) => {
+        await this.native('mpv.subDelay', { sid: sessionId, seconds });
+        return this.sessions.get(sessionId) ?? null;
+    };
+
+    setEmbeddedMpvAspect = async (sessionId: string, aspect: string) => {
+        await this.native('mpv.prop', {
+            sid: sessionId,
+            name: 'video-aspect-override',
+            value: aspect === 'auto' ? '-1' : aspect,
+        });
+        return this.update(sessionId, { aspectOverride: aspect });
+    };
+
+    disposeEmbeddedMpvSession = async (sessionId: string) => {
+        this.split.onDispose(sessionId);
+        const session = this.sessions.get(sessionId) ?? null;
+        this.sessions.delete(sessionId);
+        this.lastPublish.delete(sessionId);
+        this.lastStatus.delete(sessionId);
+        this.hidden.delete(sessionId);
+        if (this.mainSessionId === sessionId) this.mainSessionId = null;
+        for (const slot of Object.values(this.frames)) {
+            if (slot.sid === sessionId) this.stopSlot(slot);
+        }
+        try {
+            await this.native('mpv.dispose', { sid: sessionId });
+        } catch {
+            /* already gone */
+        }
+        return session ? { ...session, status: 'closed' as const } : null;
+    };
+
+    /**
+     * Sound from another channel (even another subscription): mpv `audio-add`,
+     * shifted by `audio-delay`. The picture keeps its own audio track, which
+     * comes back when the other sound is removed.
+     */
+    private readonly ownAudio = new Map<string, number | null>();
+
+    setEmbeddedMpvExternalAudio = async (
+        sessionId: string,
+        playback: ResolvedPortalPlayback | null,
+        delaySeconds = 0
+    ) => {
+        const session = this.sessions.get(sessionId);
+        if (!session) return null;
+        if (playback) this.soundRegion = playback.clockRegion ?? null;
+        // Two sessions: the other channel plays in its own hidden player, kept in step with the picture.
+        if (this.split.setExternalAudio(sessionId, playback, delaySeconds)) {
+            return this.publish(sessionId);
+        }
+        if (!playback) {
+            const own = this.ownAudio.get(sessionId);
+            this.ownAudio.delete(sessionId);
+            if (own) {
+                await this.native('mpv.audioTrack', { sid: sessionId, trackId: own });
+            }
+            await this.native('mpv.prop', { sid: sessionId, name: 'audio-delay', value: 0 });
+            return this.update(sessionId, { externalAudioError: undefined });
+        }
+        if (!this.ownAudio.has(sessionId)) {
+            this.ownAudio.set(sessionId, session.selectedAudioTrackId);
+        }
+        try {
+            await this.native('mpv.addAudio', {
+                sid: sessionId,
+                url: playback.streamUrl,
+                title: playback.title,
+            });
+            await this.native('mpv.prop', {
+                sid: sessionId,
+                name: 'audio-delay',
+                value: delaySeconds,
+            });
+            void this.refreshTracks(sessionId);
+            return this.update(sessionId, { externalAudioError: undefined });
+        } catch (error) {
+            return this.update(sessionId, {
+                externalAudioError: error instanceof Error ? error.message : String(error),
+            });
+        }
+    };
+
+    setEmbeddedMpvExternalAudioDelay = async (sessionId: string, seconds: number) => {
+        const delay = Math.max(-60, Math.min(60, seconds));
+        if (this.split.setExternalAudioDelay(sessionId, delay)) {
+            return this.publish(sessionId);
+        }
+        await this.native('mpv.prop', { sid: sessionId, name: 'audio-delay', value: seconds });
+        return this.sessions.get(sessionId) ?? null;
+    };
+
+    // ------------------------------------------------------------ two-session audio + clock frames
+
+    reportEmbeddedMpvSplitAudioLateness = async (
+        sessionId: string,
+        latenessSeconds: number,
+        manual = false
+    ): Promise<boolean> => this.split.report(sessionId, latenessSeconds, manual);
+
+    setEmbeddedMpvSplitAudioAuto = async (sessionId: string, on: boolean): Promise<boolean> =>
+        this.split.setAuto(sessionId, on);
+
+    setEmbeddedMpvSplitAudioSyncMode = async (
+        sessionId: string,
+        mode: 'auto' | 'manual'
+    ): Promise<boolean> => {
+        const done = this.split.setSyncMode(sessionId, mode);
+        if (done) this.publish(sessionId);
+        return done;
+    };
+
+    splitEmbeddedMpvAudioSyncAction = async (
+        sessionId: string,
+        action: SplitAudioSyncAction
+    ): Promise<boolean> => {
+        const known = ['start', 'cancel', 'quick', 'original-audio-on', 'original-audio-off'];
+        if (!known.includes(action)) return false;
+        const done = this.split.syncAction(sessionId, action);
+        if (done) this.publish(sessionId);
+        return done;
+    };
+
+    /** The standalone clock preview is a third connection; the two-session mode replaces it. */
+    createEmbeddedMpvPreviewSession = async (): Promise<EmbeddedMpvSession> => {
+        throw new Error('The clock preview is not available while the two-session audio mode is on.');
+    };
+
+    attachEmbeddedMpvFrameView = async (
+        sessionId: string,
+        role: 'main' | 'preview' = 'main'
+    ): Promise<boolean> => {
+        if (!this.sessions.has(sessionId)) return false;
+        const slot = this.frames[role];
+        slot.sid = sessionId;
+        slot.last = null;
+        // The player attaches its main session just by playing; reading pictures is costly, so the
+        // pump runs only while somebody (the clock sync) keeps asking for frames.
+        if (role !== 'main') this.startSlot(role);
+        return true;
+    };
+
+    detachEmbeddedMpvFrameView = (role: 'main' | 'preview' = 'main'): void => {
+        this.stopSlot(this.frames[role]);
+    };
+
+    /** The newest picture of a role (cropped to `region`), read from the player the last time it was asked. */
+    captureEmbeddedMpvFrame = (
+        role: 'main' | 'preview',
+        region?: EmbeddedMpvFrameRegion,
+        maxWidth?: number
+    ): EmbeddedMpvFrameCapture | null => {
+        const slot = this.frames[role];
+        slot.askedAt = Date.now();
+        if (role === 'main') {
+            slot.region = region ?? null;
+            slot.maxWidth = maxWidth ?? 640;
+            if (!slot.sid && this.mainSessionId) slot.sid = this.mainSessionId;
+            this.startSlot('main');
+        }
+        const last = slot.last;
+        if (!last || !sameRegion(last.region, role === 'main' ? slot.region : this.soundRegion)) {
+            return null;
+        }
+        return {
+            width: last.width,
+            height: last.height,
+            data: last.data,
+            ageMs: Date.now() - last.at,
+            seq: last.seq,
+        };
+    };
+
+    private startSlot(role: 'main' | 'preview'): void {
+        const slot = this.frames[role];
+        if (slot.timer !== null) return;
+        slot.timer = window.setInterval(() => void this.pumpFrame(role), FRAME_PUMP_MS);
+    }
+
+    private stopSlot(slot: FrameSlot): void {
+        if (slot.timer !== null) window.clearInterval(slot.timer);
+        slot.timer = null;
+        slot.sid = null;
+        slot.last = null;
+        slot.busy = false;
+    }
+
+    private async pumpFrame(role: 'main' | 'preview'): Promise<void> {
+        const slot = this.frames[role];
+        const sid = slot.sid;
+        if (role === 'main' && Date.now() - (slot.askedAt ?? 0) > FRAME_IDLE_MS) {
+            if (slot.timer !== null) window.clearInterval(slot.timer);
+            slot.timer = null;
+            return;
+        }
+        if (!sid || slot.busy || !this.sessions.has(sid)) return;
+        const region = role === 'main' ? slot.region : this.soundRegion;
+        slot.busy = true;
+        try {
+            const result = (await this.native('mpv.frame', {
+                sid,
+                region,
+                maxWidth: role === 'main' ? slot.maxWidth : 640,
+            })) as { width: number; height: number; base64: string };
+            if (slot.sid !== sid) return;
+            const binary = atob(result.base64);
+            const data = new Uint8ClampedArray(binary.length);
+            for (let i = 0; i < binary.length; i++) data[i] = binary.charCodeAt(i);
+            slot.last = {
+                width: result.width,
+                height: result.height,
+                data,
+                ageMs: 0,
+                seq: ++slot.seq,
+                at: Date.now(),
+                region,
+            };
+            if (role === 'preview') paintPreview(slot.last);
+        } catch {
+            /* the player has no picture yet */
+        } finally {
+            slot.busy = false;
+        }
+    }
+}
+
+/**
+ * The clock window and the sync bar show the sound channel's picture on their own canvases; on the
+ * desktop the preload script paints them, here the frames that were just read are drawn.
+ */
+function paintPreview(frame: { width: number; height: number; data: Uint8ClampedArray }): void {
+    const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-embedded-mpv-preview]');
+    canvases.forEach((canvas) => {
+        const context = canvas.getContext('2d');
+        if (!context) return;
+        if (canvas.width !== frame.width || canvas.height !== frame.height) {
+            canvas.width = frame.width;
+            canvas.height = frame.height;
+        }
+        context.putImageData(new ImageData(frame.data as Uint8ClampedArray<ArrayBuffer>, frame.width, frame.height), 0, 0);
+    });
+}
+
+/** The player's volume is 0..1; mpv wants 0..100 (1 would be 1 % — practically silent). */
+const toMpvVolume = (value: number): number =>
+    Math.round(Math.max(0, Math.min(1, Number.isFinite(value) ? value : 1)) * 100);
+
+export function installIosMpvHost(): void {
+    if (typeof window === 'undefined' || !getD7tNative()) return;
+    const host = window as unknown as { d7tMpv?: unknown };
+    if (host.d7tMpv) return;
+    host.d7tMpv = new IosMpvHost() as unknown as ElectronBridgeApi;
+    // The clock window asks for the frame-copy canvas before it offers itself; the phone reads frames
+    // from the players instead, so a hidden stand-in satisfies that check.
+    const canvas = document.createElement('canvas');
+    canvas.setAttribute('data-embedded-mpv-frame', '');
+    canvas.hidden = true;
+    (document.body ?? document.documentElement).appendChild(canvas);
+}
diff --git a/apps/web/src/app/ios/ios-native-tabs.ts b/apps/web/src/app/ios/ios-native-tabs.ts
new file mode 100644
index 0000000..765b294
--- /dev/null
+++ b/apps/web/src/app/ios/ios-native-tabs.ts
@@ -0,0 +1,128 @@
+import { getD7tNative } from './ios-bridge';
+
+/**
+ * iPhone app: the bottom tab bar is the system's own (UITabBarController, drawn as Liquid Glass by
+ * iOS), not HTML. The page keeps its router and its existing tab links; this connects the two:
+ *  - tells the phone which tab is showing (and when the bar must hide, e.g. fullscreen);
+ *  - follows the phone's taps by activating the page's own tab link, so routing, guards and the
+ *    "More" sheet behave exactly as before.
+ */
+const TAB_LINKS: Record<string, string> = {
+    home: '/dashboard',
+    movies: '/vod',
+    series: '/series',
+    live: '/live',
+    search: '/search',
+};
+
+export function installIosNativeTabs(): void {
+    const native = getD7tNative();
+    if (!native) return;
+    document.documentElement.classList.add('d7t-native-tabs');
+
+    let last = '';
+    const send = (state: {
+        active: string;
+        hidden: boolean;
+        tabs: string[];
+        more: boolean;
+    }) => {
+        const key = JSON.stringify(state);
+        if (key === last) return;
+        last = key;
+        void native.call('tabs.state', state).catch(() => undefined);
+    };
+
+    const compute = () => {
+        const html = document.documentElement;
+        const hidden =
+            html.classList.contains('d7t-has-fullscreen') ||
+            !!document.querySelector('.d7t-fullscreen');
+        // Only the tabs this source has (an M3U playlist has no Movies/Series).
+        const tabs = Object.entries(TAB_LINKS)
+            .filter(([, suffix]) =>
+                document.querySelector(`.app-rail a.nav-item[href$="${suffix}"]`)
+            )
+            .map(([id]) => id);
+        const sheetOpen = document.querySelector('.app-rail.native-more-open');
+        // Dialogs, the category sheet and the clock window are HTML on top of the page; the system
+        // bar must not float over them.
+        const overlayOpen = !!document.querySelector(
+            '.mat-mdc-dialog-container, .mat-bottom-sheet-container, app-ios-category-sheet, app-audio-sync-window'
+        );
+        let active = 'none';
+        if (!sheetOpen) {
+            for (const [id, suffix] of Object.entries(TAB_LINKS)) {
+                const link = document.querySelector(
+                    `.app-rail a.nav-item[href$="${suffix}"]`
+                );
+                if (link?.classList.contains('is-active') || link?.classList.contains('active')) {
+                    active = id;
+                    break;
+                }
+            }
+        }
+        // The glass More button sits top-trailing: it stays off the player (whose own controls are
+        // there) and off pages whose header holds the search field.
+        const path = location.pathname;
+        const hasPlayer = !!document.querySelector(
+            '.video-player, app-web-player-view, .embedded-mpv-player__viewport'
+        );
+        const searchHeader = /\/(search|settings)(\/|$)/.test(path);
+        const more = !hasPlayer && !searchHeader && !sheetOpen && !overlayOpen;
+        // The glass More button owns a strip under the status bar (see _ios-shell.scss), so it never
+        // lies over page content such as "See all".
+        html.classList.toggle(
+            'd7t-more-btn',
+            !hasPlayer && !searchHeader && !hidden
+        );
+        send({
+            active,
+            hidden: hidden || overlayOpen,
+            tabs,
+            more,
+        });
+    };
+
+    let frame = 0;
+    const schedule = () => {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(compute);
+    };
+
+    // The rail (tab links, More sheet) and the fullscreen classes are what the state is read from.
+    let watched: Element | null = null;
+    const observer = new MutationObserver(schedule);
+    const watch = () => {
+        const rail = document.querySelector('.app-rail');
+        if (rail && rail !== watched) {
+            observer.disconnect();
+            watched = rail;
+            observer.observe(rail, {
+                attributes: true,
+                attributeFilter: ['class'],
+                childList: true,
+                subtree: true,
+            });
+            observer.observe(document.documentElement, {
+                attributes: true,
+                attributeFilter: ['class'],
+            });
+        }
+        schedule();
+    };
+    window.setInterval(watch, 300);
+    window.addEventListener('popstate', schedule);
+    watch();
+
+    native.on('tab', (payload) => {
+        const id = String(payload);
+        const target =
+            id === 'more'
+                ? document.querySelector<HTMLElement>('.app-rail button.rail-more')
+                : document.querySelector<HTMLElement>(
+                      `.app-rail a.nav-item[href$="${TAB_LINKS[id]}"]`
+                  );
+        target?.click();
+    });
+}
