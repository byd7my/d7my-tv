+import {
+    ChangeDetectionStrategy,
+    Component,
+    computed,
+    ElementRef,
+    HostListener,
+    input,
+    OnInit,
+    output,
+    signal,
+    viewChild,
+} from '@angular/core';
+import { foldSearchText, plainDisplayText } from '@iptvnator/shared/interfaces';
+
+export type IosCategoryIcon = 'all' | 'favorites' | 'recent' | null;
+
+export interface IosCategoryRow {
+    /** `all`, `favorites`, `recent` or `c:<category id>`. */
+    readonly key: string;
+    readonly name: string;
+    readonly count?: number | null;
+    readonly icon?: IosCategoryIcon;
+    /** Only real provider categories can be hidden. */
+    readonly hideable: boolean;
+    /** Edit view only: the category is currently left out of the app. */
+    readonly hidden?: boolean;
+}
+
+/**
+ * Bottom sheet for choosing (and hiding / restoring) categories, laid out after
+ * the iOS "page sheet": title, Done, an inset-separator list and a floating
+ * search capsule. It is rendered through the CDK overlay so no ancestor with
+ * containment can clip or re-anchor it.
+ */
+@Component({
+    selector: 'app-ios-category-sheet',
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    template: `
+        <div
+            class="ios-sheet__scrim"
+            [class.is-open]="open()"
+            (click)="dismiss()"
+        ></div>
+        <section
+            class="ios-sheet"
+            role="dialog"
+            aria-modal="true"
+            [attr.aria-label]="heading()"
+            [class.is-open]="open()"
+            [class.is-dragging]="dragging()"
+            [style.transform]="sheetTransform()"
+        >
+            <header
+                class="ios-sheet__header"
+                (pointerdown)="dragStart($event)"
+                (pointermove)="dragMove($event)"
+                (pointerup)="dragEnd($event)"
+                (pointercancel)="dragEnd($event)"
+            >
+                <span class="ios-sheet__grabber" aria-hidden="true"></span>
+                @if (page() === 'hidden') {
+                    <button
+                        type="button"
+                        class="ios-pill ios-pill--text"
+                        (click)="page.set('list')"
+                    >
+                        <svg viewBox="0 0 12 20" width="9" height="15" aria-hidden="true">
+                            <path d="M10 2 2 10l8 8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
+                        </svg>
+                        Back
+                    </button>
+                } @else {
+                    <button
+                        type="button"
+                        class="ios-pill ios-pill--text"
+                        data-test-id="ios-cat-edit"
+                        [class.is-active]="editing()"
+                        (click)="toggleEdit()"
+                    >
+                        {{ editing() ? 'Finish' : 'Edit' }}
+                    </button>
+                }
+                <h2 class="ios-sheet__title">{{ heading() }}</h2>
+                <button
+                    type="button"
+                    class="ios-pill"
+                    data-test-id="ios-cat-done"
+                    (click)="dismiss()"
+                >
+                    Done
+                </button>
+            </header>
+
+            <div class="ios-sheet__scroll" #scroller>
+                @if (page() === 'list' && editing()) {
+                    <div class="ios-bulk">
+                        <div class="ios-bulk__count" data-test-id="ios-cat-selected">
+                            Selected <b>{{ shownCount() }}</b> / {{ editList().length }}
+                        </div>
+                        <div class="ios-bulk__actions">
+                            <button
+                                type="button"
+                                class="ios-pill ios-pill--small"
+                                data-test-id="ios-cat-select-all"
+                                [disabled]="shownCount() === editList().length"
+                                (click)="restoreAll.emit()"
+                            >
+                                Select all
+                            </button>
+                            <button
+                                type="button"
+                                class="ios-pill ios-pill--small"
+                                data-test-id="ios-cat-deselect-all"
+                                [disabled]="shownCount() === 0"
+                                (click)="deselectAll()"
+                            >
+                                Deselect all
+                            </button>
+                        </div>
+                    </div>
+                    <ul class="ios-list" role="list">
+                        @for (row of filteredEdit(); track row.key) {
+                            <li class="ios-row">
+                                <button
+                                    type="button"
+                                    class="ios-row__main"
+                                    role="checkbox"
+                                    data-test-id="ios-cat-toggle"
+                                    [attr.aria-checked]="!row.hidden"
+                                    (click)="toggle(row)"
+                                >
+                                    <span class="ios-check" [class.is-on]="!row.hidden" aria-hidden="true">
+                                        @if (!row.hidden) {
+                                            <svg viewBox="0 0 24 24" width="16" height="16"><path d="m5 12.5 4.6 4.6L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
+                                        }
+                                    </span>
+                                    <span class="ios-row__name">{{ plain(row.name) }}</span>
+                                    @if (row.count != null) {
+                                        <span class="ios-row__count">{{ row.count }}</span>
+                                    }
+                                </button>
+                            </li>
+                        } @empty {
+                            <li class="ios-empty">No categories match “{{ term() }}”.</li>
+                        }
+                    </ul>
+                } @else if (page() === 'list') {
+                    <ul class="ios-list" role="list">
+                        @for (row of filteredRows(); track row.key) {
+                            <li class="ios-row" [class.is-selected]="row.key === selectedKey()">
+                                <button
+                                    type="button"
+                                    class="ios-row__main"
+                                    data-test-id="ios-cat-row"
+                                    [attr.aria-current]="row.key === selectedKey() ? 'true' : null"
+                                    (click)="pick(row)"
+                                >
+                                    @if (row.icon) {
+                                        <span class="ios-row__icon" aria-hidden="true">
+                                            @switch (row.icon) {
+                                                @case ('favorites') {
+                                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 20.5s-8-4.9-8-11A4.6 4.6 0 0 1 12 6.8 4.6 4.6 0 0 1 20 9.5c0 6.1-8 11-8 11Z" fill="currentColor" /></svg>
+                                                }
+                                                @case ('recent') {
+                                                    <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
+                                                }
+                                                @default {
+                                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M5 12h14M5 17h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
+                                                }
+                                            }
+                                        </span>
+                                    }
+                                    <span class="ios-row__name">{{ plain(row.name) }}</span>
+                                    @if (row.count != null) {
+                                        <span class="ios-row__count">{{ row.count }}</span>
+                                    }
+                                    @if (row.key === selectedKey()) {
+                                        <svg class="ios-row__check" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
+                                            <path d="m5 12.5 4.6 4.6L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
+                                        </svg>
+                                    }
+                                </button>
+                            </li>
+                        } @empty {
+                            <li class="ios-empty">No categories match “{{ term() }}”.</li>
+                        }
+                        @if (hiddenRows().length > 0) {
+                            <li class="ios-row ios-row--manage">
+                                <button
+                                    type="button"
+                                    class="ios-row__main"
+                                    data-test-id="ios-cat-hidden-open"
+                                    (click)="page.set('hidden')"
+                                >
+                                    <span class="ios-row__name">Hidden Categories</span>
+                                    <span class="ios-row__count">{{ hiddenRows().length }}</span>
+                                    <svg class="ios-row__chev" viewBox="0 0 12 20" width="8" height="14" aria-hidden="true">
+                                        <path d="m2 2 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
+                                    </svg>
+                                </button>
+                            </li>
+                        }
+                    </ul>
+                } @else {
+                    <p class="ios-note">
+                        Hidden categories stay on your provider and in your playlist.
+                        They are only left out of this app.
+                    </p>
+                    <ul class="ios-list" role="list">
+                        @for (row of hiddenRows(); track row.key) {
+                            <li class="ios-row">
+                                <div class="ios-row__main ios-row__main--static">
+                                    <span class="ios-row__name">{{ plain(row.name) }}</span>
+                                    <button
+                                        type="button"
+                                        class="ios-pill ios-pill--small"
+                                        data-test-id="ios-cat-restore"
+                                        [attr.aria-label]="'Restore ' + row.name"
+                                        (click)="restore.emit(row.key)"
+                                    >
+                                        Restore
+                                    </button>
+                                </div>
+                            </li>
+                        } @empty {
+                            <li class="ios-empty">No hidden categories.</li>
+                        }
+                    </ul>
+                    @if (hiddenRows().length > 1) {
+                        <div class="ios-restore-all">
+                            <button
+                                type="button"
+                                class="ios-pill"
+                                data-test-id="ios-cat-restore-all"
+                                (click)="restoreAll.emit()"
+                            >
+                                Restore All
+                            </button>
+                        </div>
+                    }
+                }
+            </div>
+
+            @if (page() === 'list') {
+                <label class="ios-search">
+                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
+                        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4" />
+                        <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
+                    </svg>
+                    <input
+                        #search
+                        type="search"
+                        enterkeyhint="search"
+                        autocomplete="off"
+                        autocapitalize="off"
+                        spellcheck="false"
+                        placeholder="Search categories"
+                        aria-label="Search categories"
+                        [value]="term()"
+                        (input)="term.set(search.value)"
+                    />
+                    @if (term()) {
+                        <button type="button" class="ios-search__clear" aria-label="Clear search" (click)="term.set(''); search.focus()">
+                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
+                        </button>
+                    }
+                </label>
+            }
+        </section>
+    `,
+    styleUrl: './ios-category-sheet.component.scss',
+})
+export class IosCategorySheetComponent implements OnInit {
+    protected readonly plain = plainDisplayText;
+    readonly rows = input.required<IosCategoryRow[]>();
+    readonly hiddenRows = input<IosCategoryRow[]>([]);
+    readonly selectedKey = input<string | null>(null);
+    readonly title = input('Categories');
+    /** Opens straight in the select/deselect view. */
+    readonly startEditing = input(false);
+
+    readonly picked = output<string>();
+    readonly hide = output<string>();
+    readonly restore = output<string>();
+    readonly restoreAll = output<void>();
+    readonly hideAll = output<void>();
+    readonly closed = output<void>();
+
+    readonly open = signal(false);
+    readonly editing = signal(false);
+    readonly page = signal<'list' | 'hidden'>('list');
+    readonly term = signal('');
+    readonly dragY = signal(0);
+    readonly dragging = signal(false);
+
+    private readonly scroller = viewChild<ElementRef<HTMLElement>>('scroller');
+    private dragOrigin: number | null = null;
+    private closing = false;
+
+    readonly heading = computed(() =>
+        this.page() === 'hidden' ? 'Hidden Categories' : this.title()
+    );
+
+    readonly filteredRows = computed(() => {
+        const q = foldSearchText(this.term().trim());
+        const all = this.rows();
+        return q ? all.filter((r) => foldSearchText(r.name).includes(q)) : all;
+    });
+
+    /** Every real category, shown or hidden, in the provider's order of the two lists. */
+    readonly editList = computed<IosCategoryRow[]>(() => [
+        ...this.rows()
+            .filter((r) => r.hideable)
+            .map((r) => ({ ...r, hidden: false })),
+        ...this.hiddenRows().map((r) => ({ ...r, hidden: true })),
+    ]);
+
+    readonly shownCount = computed(
+        () => this.editList().filter((r) => !r.hidden).length
+    );
+
+    readonly filteredEdit = computed(() => {
+        const q = foldSearchText(this.term().trim());
+        const all = this.editList();
+        return q ? all.filter((r) => foldSearchText(r.name).includes(q)) : all;
+    });
+
+    readonly sheetTransform = computed(() =>
+        this.dragY() > 0 ? `translateY(${this.dragY()}px)` : null
+    );
+
+    ngOnInit(): void {
+        if (this.startEditing()) {
+            this.editing.set(true);
+        }
+        // Next frame, so the slide-up transition has a starting state to run from.
+        requestAnimationFrame(() => this.open.set(true));
+    }
+
+    @HostListener('document:keydown.escape')
+    onEscape(): void {
+        this.dismiss();
+    }
+
+    toggleEdit(): void {
+        this.editing.update((v) => !v);
+    }
+
+    toggle(row: IosCategoryRow): void {
+        if (row.hidden) {
+            this.restore.emit(row.key);
+        } else {
+            this.hide.emit(row.key);
+        }
+    }
+
+    deselectAll(): void {
+        this.hideAll.emit();
+    }
+
+    pick(row: IosCategoryRow): void {
+        if (this.editing()) {
+            return;
+        }
+        this.picked.emit(row.key);
+        this.dismiss();
+    }
+
+    dismiss(): void {
+        if (this.closing) {
+            return;
+        }
+        this.closing = true;
+        this.dragY.set(0);
+        this.open.set(false);
+        setTimeout(() => this.closed.emit(), 260);
+    }
+
+    dragStart(event: PointerEvent): void {
+        if ((event.target as HTMLElement).closest('button')) {
+            return;
+        }
+        this.dragOrigin = event.clientY;
+        this.dragging.set(true);
+        (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
+    }
+
+    dragMove(event: PointerEvent): void {
+        if (this.dragOrigin === null) {
+            return;
+        }
+        this.dragY.set(Math.max(0, event.clientY - this.dragOrigin));
+    }
+
+    dragEnd(event: PointerEvent): void {
+        if (this.dragOrigin === null) {
+            return;
+        }
+        const travelled = this.dragY();
+        this.dragOrigin = null;
+        this.dragging.set(false);
+        (event.currentTarget as HTMLElement).releasePointerCapture?.(
+            event.pointerId
+        );
+        if (travelled > 110) {
+            this.dismiss();
+        } else {
+            this.dragY.set(0);
+        }
+    }
+}
