+    flex-direction: column;
+    gap: 22px;
+    color: var(--app-on-surface, #fff);
+}
+
+.ios-browse__title {
+    margin: 4px 20px 0;
+    font-size: 34px;
+    font-weight: 700;
+    letter-spacing: -0.02em;
+    line-height: 1.1;
+}
+
+.ios-browse__head {
+    display: flex;
+    align-items: baseline;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 0 20px;
+    margin-bottom: 10px;
+
+    h2 {
+        margin: 0;
+        font-size: 20px;
+        font-weight: 700;
+        letter-spacing: -0.01em;
+        color: var(--app-muted-color, #a3a3a3);
+        min-width: 0;
+        overflow: hidden;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    a {
+        flex-shrink: 0;
+        font-size: 17px;
+        font-weight: 500;
+        color: #0a84ff;
+        text-decoration: none;
+    }
+}
+
+.ios-browse__track {
+    display: flex;
+    gap: 12px;
+    padding: 0 20px;
+    overflow-x: auto;
+    scroll-snap-type: x proximity;
+    scrollbar-width: none;
+
+    &::-webkit-scrollbar {
+        display: none;
+    }
+}
+
+.ios-browse__card {
+    flex: 0 0 132px;
+    width: 132px;
+    padding: 0;
+    border: 0;
+    background: none;
+    color: inherit;
+    text-align: start;
+    font: inherit;
+    cursor: pointer;
+    scroll-snap-align: start;
+}
+
+.ios-browse__poster {
+    display: block;
+    width: 100%;
+    aspect-ratio: 2 / 3;
+    border-radius: 18px;
+    overflow: hidden;
+    background: rgba(255, 255, 255, 0.08);
+
