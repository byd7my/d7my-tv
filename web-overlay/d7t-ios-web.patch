+import { ChangeDetectionStrategy, Component, computed, input, output } from '@angular/core';
+import { MatIcon } from '@angular/material/icon';
+import { TranslatePipe } from '@ngx-translate/core';
+import { SETTINGS_NAV_GROUPS } from '@iptvnator/workspace/shell/util/settings-search';
+import { IosUpdateCardComponent } from '../ios/ios-update-card.component';
+import type { SettingsSection } from './settings.models';
+
+/** Colour chip behind each section's icon, like the iPhone Settings app. */
+const CHIP: Record<string, string> = {
+    general: '#8e8e93',
+    appearance: '#0a84ff',
+    playback: '#30d158',
+    epg: '#ff9f0a',
+    dashboard: '#5e5ce6',
+    tmdb: '#ff375f',
+    parental: '#bf5af2',
+    'remote-control': '#64d2ff',
+    server: '#8e8e93',
+    backup: '#30b0c7',
+    about: '#8e8e93',
+};
+
+/**
+ * Phone Settings home (design #23): a large title, the app update card, then the sections in
+ * grouped rows with a chevron. Each row opens that section's page.
+ */
+@Component({
+    selector: 'app-ios-settings-index',
+    imports: [MatIcon, TranslatePipe, IosUpdateCardComponent],
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    template: `
+        <div class="ios-index" data-test-id="ios-settings-index">
+            <h1 class="ios-index__title">Settings</h1>
+
+            <h2 class="ios-index__group">App updates</h2>
+            <app-ios-update-card />
+
+            @for (group of groups(); track group.id) {
+                @if (group.id) {
+                    <h2 class="ios-index__group">{{ group.labelKey | translate }}</h2>
+                }
+                <div class="ios-index__list">
+                    @for (section of group.sections; track section.id) {
+                        <button
+                            type="button"
+                            class="ios-index__row"
+                            [attr.data-test-id]="'ios-settings-open-' + section.id"
+                            (click)="open.emit(section.id)"
+                        >
+                            <span class="ios-index__chip" [style.background]="chip(section.id)">
+                                <mat-icon aria-hidden="true">{{ section.icon }}</mat-icon>
+                            </span>
+                            <span class="ios-index__name">{{ section.label | translate }}</span>
+                            <mat-icon class="ios-index__chevron" aria-hidden="true">chevron_right</mat-icon>
+                        </button>
+                    }
+                </div>
+            }
+        </div>
+    `,
+    styles: `
+        :host {
+            display: block;
+        }
+        .ios-index__title {
+            margin: 4px 0 14px;
+            font-size: 34px;
+            font-weight: 700;
+            letter-spacing: -0.02em;
+        }
+        .ios-index__group {
+            margin: 22px 16px 8px;
+            color: rgba(235, 235, 245, 0.55);
+            font-size: 13px;
+            font-weight: 600;
+            letter-spacing: 0.02em;
+            text-transform: uppercase;
+        }
+        .ios-index__list {
+            background: var(--l-surface, #1c1c1e);
+            border-radius: 14px;
+            overflow: hidden;
+        }
+        .ios-index__row {
+            display: flex;
+            align-items: center;
+            gap: 12px;
+            width: 100%;
+            min-height: 52px;
+            padding: 0 12px 0 16px;
+            border: 0;
+            background: none;
+            color: inherit;
+            font: inherit;
+            font-size: 17px;
+            text-align: start;
+        }
+        .ios-index__row + .ios-index__row {
+            border-top: 0.5px solid rgba(255, 255, 255, 0.12);
+        }
+        .ios-index__chip {
+            display: grid;
+            place-items: center;
+            width: 30px;
+            height: 30px;
+            border-radius: 8px;
+            color: #fff;
+            flex: none;
+        }
+        .ios-index__chip mat-icon {
+            width: 20px;
+            height: 20px;
+            font-size: 20px;
+        }
+        .ios-index__name {
+            flex: 1;
+            min-width: 0;
+        }
+        .ios-index__chevron {
+            color: rgba(235, 235, 245, 0.3);
+        }
+    `,
+})
+export class IosSettingsIndexComponent {
+    readonly sections = input.required<SettingsSection[]>();
+    readonly open = output<string>();
+
+    readonly groups = computed(() => {
+        const sections = this.sections();
+        const out: { id: string; labelKey: string; sections: SettingsSection[] }[] = [];
+        for (const group of SETTINGS_NAV_GROUPS) {
+            const list = sections.filter((s) => s.group === group.id);
+            if (list.length) out.push({ id: group.id, labelKey: group.labelKey, sections: list });
+        }
+        const rest = sections.filter((s) => !s.group);
+        if (rest.length) out.push({ id: '', labelKey: '', sections: rest });
+        return out;
+    });
+
+    chip(id: string): string {
+        return CHIP[id] ?? '#8e8e93';
+    }
+}
