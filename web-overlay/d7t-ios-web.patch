+// Live TV list, after the supplied reference: a tappable category title above
+// a plain vertical list with large rounded logos, name over EPG line, chevron
+// at the end and inset hairline separators.
+:host {
+    display: flex;
+    flex-direction: column;
+    flex: 1 1 auto;
+    min-height: 0;
+    width: 100%;
+    overflow: hidden;
+    font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif;
+}
+
+.ios-live-head {
+    flex: 0 0 auto;
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    padding: 8px 12px 6px 16px;
+}
+
+.ios-live-title {
+    // A glass-style pill (the category chooser), not a page heading: the list keeps the room.
+    appearance: none;
+    border: 0;
+    background: rgba(118, 118, 128, 0.24);
+    color: #fff;
+    font: inherit;
+    flex: 0 1 auto;
+    min-width: 0;
+    max-width: calc(100% - 56px);
+    min-height: 40px;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 0 14px;
+    border-radius: 999px;
+    text-align: start;
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+
+    &:active {
+        opacity: 0.6;
+    }
+}
+
+.ios-live-title__icon {
+    flex: 0 0 auto;
+    color: rgba(235, 235, 245, 0.6);
+}
+
+.ios-live-title__name {
+    flex: 0 1 auto;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    font-size: 17px;
+    font-weight: 600;
+    letter-spacing: -0.01em;
+}
+
+.ios-live-title__chev {
+    flex: 0 0 auto;
+    margin-inline-start: 2px;
+    color: rgba(235, 235, 245, 0.55);
+}
+
+.ios-live-sort {
+    margin-inline-start: auto;
+    appearance: none;
+    border: 0;
+    background: transparent;
+    color: rgba(235, 235, 245, 0.7);
+    width: 44px;
+    height: 44px;
+    display: grid;
+    place-items: center;
+    border-radius: 50%;
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+
+    &:active {
+        background: rgba(255, 255, 255, 0.1);
+    }
+}
+
