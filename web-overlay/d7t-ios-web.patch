+// Fit the app to a phone screen when it runs inside the iOS shell (html.d7t-ios, set by the shell).
+// Same typeface as the iPhone's own apps (the reference apps use it).
+html.d7t-ios,
+html.d7t-ios body,
+html.d7t-ios *:not(mat-icon):not(.mat-icon):not(.material-icons) {
+    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui,
+        sans-serif;
+}
+
+html.d7t-ios {
+    -webkit-text-size-adjust: 100%;
+    -webkit-tap-highlight-color: transparent;
+    -webkit-touch-callout: none;
+    overscroll-behavior: none;
+    height: 100%;
+
+    body {
+        // The document itself never scrolls or shifts (rotating the phone and leaving fullscreen
+        // used to leave the page scrolled away, i.e. blank, and zoomed ~6 %).
+        position: fixed;
+        inset: 0;
+        width: 100%;
+        // Notch / Dynamic Island on top, home indicator at the bottom.
+        padding-top: env(safe-area-inset-top, 0px);
+        padding-bottom: env(safe-area-inset-bottom, 0px);
+        padding-left: env(safe-area-inset-left, 0px);
+        padding-right: env(safe-area-inset-right, 0px);
+        box-sizing: border-box;
+        height: 100%;
+        background: var(--app-shell-bg, #0d0f12);
+        overflow: hidden;
+        user-select: none;
+        -webkit-user-select: none;
+    }
+
+    input,
+    textarea,
+    [contenteditable] {
+        user-select: text;
+        -webkit-user-select: text;
+        // iOS zooms into inputs below 16px.
+        font-size: max(16px, 1em);
+    }
+}
+
+// Video is drawn by the phone app BEHIND this page, so the player box and everything around it
+// must let it show through (a page with a player is see-through; the shell colour sits behind it).
+html.d7t-ios {
+    .embedded-mpv-player,
+    .embedded-mpv-player__viewport {
+        background: transparent !important;
+    }
+
+    *:has(.embedded-mpv-player__viewport) {
+        background: transparent !important;
+        backdrop-filter: none !important;
+    }
+}
+
+// ── Phone layout (iPhone app) ────────────────────────────────────────────────
+// Same app, same features; only the arrangement changes so it works with a thumb:
+//  - the navigation bar moves to the bottom (like every iPhone app),
+//  - the live player sits on top at 16:9 and the channel list fills the rest,
+//  - the player's controls float over the picture instead of taking a strip below it.
+@media (max-width: 640px), (max-height: 480px) and (orientation: landscape) {
+    html.d7t-ios {
+        // The top bar is contextual now (see WorkspaceShellHeaderComponent.phoneApp): 52 px when
+        // it holds Back / a page action / a search field, and gone — no blank strip — otherwise.
+        .workspace-shell {
+            grid-template-rows: auto minmax(0, 1fr) auto !important;
+        }
+
+        app-workspace-shell-header.is-phone-empty {
+            display: none !important;
+        }
+
+        app-workspace-shell-header:not(.is-phone-empty) .workspace-header {
+            min-height: 52px;
+        }
+
+        app-workspace-shell-header {
+            grid-row: 1 !important;
+        }
+
+        .workspace-body {
+            grid-row: 2 !important;
+        }
+
+        // Room under the content so the floating tab bar never covers the last row.
+        .workspace-content {
+            padding-bottom: 84px;
+            box-sizing: border-box;
+        }
+
+        // ── Floating glass tab bar: Home · Movies · Series · Live TV · Search · More ──
+        app-workspace-shell-rail {
+            position: fixed !important;
+            left: 12px;
+            right: 12px;
+            bottom: calc(env(safe-area-inset-bottom, 0px) + 6px);
+            z-index: 900;
+            height: 64px;
+            grid-row: auto !important;
+            grid-column: 1 !important;
+        }
+
+        .app-rail {
+            flex-direction: row !important;
+            justify-content: space-around;
+            align-items: center;
+            gap: 0 !important;
+            padding: 6px 8px !important;
+            overflow: visible !important;
+            position: relative;
+            isolation: isolate;
+            border: 0 !important;
+            background: transparent !important;
+
+            // The glass lives on a pseudo-element: a backdrop-filter on the bar itself would make it
+            // the containing block of the fixed "More" sheet.
+            &::before {
+                content: '';
+                position: absolute;
+                inset: 0;
+                z-index: -1;
+                border: 0.5px solid rgba(255, 255, 255, 0.22);
+                border-radius: 32px;
+                // Dark-tinted glass in every theme, so the white labels always read.
+                background: linear-gradient(
+                    180deg,
+                    rgba(70, 74, 84, 0.62),
+                    rgba(28, 30, 36, 0.62)
