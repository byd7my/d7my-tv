+import { inject, Injectable } from '@angular/core';
+import { PwaXtreamDataSource } from './data-sources/pwa-xtream-data-source';
+import {
+    isCatalogDiskCacheEnabled,
+    pwaCatalogDiskCache,
+} from './data-sources/pwa-catalog-disk-cache';
+
+/**
+ * "Sync with provider" (iPhone app, in Settings): the one place that downloads a subscription's
+ * catalog again. Opening a subscription never does it once a saved copy exists.
+ */
+@Injectable({ providedIn: 'root' })
+export class CatalogSyncService {
+    private readonly dataSource = inject(PwaXtreamDataSource);
+
+    readonly available = isCatalogDiskCacheEnabled;
+
+    syncedAt(playlistId: string): Promise<number | null> {
+        return pwaCatalogDiskCache.syncedAt(playlistId);
+    }
+
+    /** Drops the saved copy; the caller reloads the app so the next open downloads a fresh one. */
+    async forget(playlistId: string): Promise<void> {
+        this.dataSource.clearSessionCache(playlistId);
+        await pwaCatalogDiskCache.clear(playlistId);
+    }
+}
diff --git a/libs/portal/xtream/data-access/src/lib/data-sources/pwa-catalog-disk-cache.ts b/libs/portal/xtream/data-access/src/lib/data-sources/pwa-catalog-disk-cache.ts
new file mode 100644
index 0000000..0375342
--- /dev/null
+++ b/libs/portal/xtream/data-access/src/lib/data-sources/pwa-catalog-disk-cache.ts
@@ -0,0 +1,122 @@
+/**
+ * iPhone app only: the provider's catalog (categories and streams) kept on the phone.
+ *
+ * The web build keeps the catalog in memory for one session, so every launch downloaded the
+ * whole catalog from the provider again. In the iPhone app that download happens once, when a
+ * subscription is first opened; after that the saved copy is used, and a new download happens
+ * only when the user asks for it in Settings ("Sync with provider").
+ *
+ * IndexedDB holds it (a large catalog does not fit localStorage). If IndexedDB is not available
+ * every call quietly does nothing, and the app behaves as before (download each session).
+ */
+const DB_NAME = 'd7t-provider-catalog';
+const STORE = 'entries';
+
+interface DiskEntry {
+    at: number;
+    data: unknown;
+}
+
+function enabled(): boolean {
+    return (
+        typeof window !== 'undefined' &&
+        !!(window as unknown as { d7tNative?: unknown }).d7tNative &&
+        typeof indexedDB !== 'undefined'
+    );
+}
+
+class PwaCatalogDiskCache {
+    private dbPromise: Promise<IDBDatabase | null> | null = null;
+
+    private open(): Promise<IDBDatabase | null> {
+        if (!enabled()) return Promise.resolve(null);
+        this.dbPromise ??= new Promise((resolve) => {
+            try {
+                const request = indexedDB.open(DB_NAME, 1);
+                request.onupgradeneeded = () =>
+                    request.result.createObjectStore(STORE);
+                request.onsuccess = () => resolve(request.result);
+                request.onerror = () => resolve(null);
+                request.onblocked = () => resolve(null);
+            } catch {
+                resolve(null);
+            }
+        });
+        return this.dbPromise;
+    }
+
+    private async run<T>(
+        mode: IDBTransactionMode,
+        work: (store: IDBObjectStore) => IDBRequest<T>
+    ): Promise<T | null> {
+        const db = await this.open();
+        if (!db) return null;
+        return new Promise((resolve) => {
+            try {
+                const request = work(
+                    db.transaction(STORE, mode).objectStore(STORE)
+                );
+                request.onsuccess = () => resolve(request.result);
+                request.onerror = () => resolve(null);
+            } catch {
+                resolve(null);
+            }
+        });
+    }
+
+    async read<T>(key: string): Promise<{ at: number; data: T } | null> {
+        const entry = (await this.run('readonly', (s) => s.get(key))) as
+            | DiskEntry
+            | null
+            | undefined;
+        return entry && entry.data !== undefined
+            ? { at: entry.at, data: entry.data as T }
+            : null;
+    }
+
+    async write(key: string, data: unknown): Promise<void> {
+        await this.run('readwrite', (s) =>
+            s.put({ at: Date.now(), data } satisfies DiskEntry, key)
+        );
+    }
+
+    /** When the subscription's catalog was last downloaded; null if it never was. */
+    async syncedAt(playlistId: string): Promise<number | null> {
+        const times: number[] = [];
+        for (const type of ['live', 'movie', 'series']) {
+            const entry = (await this.run('readonly', (s) =>
+                s.get(`${playlistId}-${type}-content`)
+            )) as DiskEntry | null | undefined;
+            if (entry) times.push(entry.at);
+        }
+        return times.length ? Math.max(...times) : null;
+    }
+
+    /** Forget the saved catalog of one subscription: the next open downloads it again. */
+    async clear(playlistId: string): Promise<void> {
+        const db = await this.open();
+        if (!db) return;
+        await new Promise<void>((resolve) => {
+            try {
+                const store = db
+                    .transaction(STORE, 'readwrite')
+                    .objectStore(STORE);
+                const request = store.openCursor();
+                request.onsuccess = () => {
+                    const cursor = request.result;
+                    if (!cursor) return resolve();
+                    if (String(cursor.key).startsWith(playlistId)) {
+                        cursor.delete();
+                    }
+                    cursor.continue();
+                };
+                request.onerror = () => resolve();
+            } catch {
+                resolve();
+            }
+        });
+    }
+}
+
+export const pwaCatalogDiskCache = new PwaCatalogDiskCache();
+export const isCatalogDiskCacheEnabled = enabled;
