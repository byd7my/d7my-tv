+<div class="ios-browse">
+    <h1 class="ios-browse__title">{{ title }}</h1>
+
+    @if (isLoading()) {
+        @for (_ of [1, 2, 3]; track $index) {
+            <div class="ios-browse__skeleton" aria-hidden="true"></div>
+        }
+    } @else {
+        @if (recent().length > 0) {
+            <section class="ios-browse__rail">
+                <header class="ios-browse__head">
+                    <h2>Recently Added</h2>
+                    @if (link('recently-added'); as all) {
+                        <a [routerLink]="all">Show All</a>
+                    }
+                </header>
+                <div class="ios-browse__track">
+                    @for (item of recent(); track item.xtream_id ?? $index) {
+                        <button
+                            type="button"
+                            class="ios-browse__card"
+                            (click)="open(item)"
+                        >
+                            <span class="ios-browse__poster">
+                                @if (poster(item); as src) {
+                                    <img [src]="src" alt="" loading="lazy" />
+                                }
+                            </span>
+                            <span class="ios-browse__name">{{ label(item) }}</span>
+                        </button>
+                    }
+                </div>
+            </section>
+        }
+
+        @for (category of categories(); track category.id) {
+            <section class="ios-browse__rail">
+                <header class="ios-browse__head">
+                    <h2>{{ category.name }}</h2>
+                    @if (link(type, category.id); as all) {
+                        <a [routerLink]="all">Show All</a>
+                    }
+                </header>
+                <div class="ios-browse__track">
+                    @for (item of category.items; track item.xtream_id ?? $index) {
+                        <button
+                            type="button"
+                            class="ios-browse__card"
+                            (click)="open(item)"
+                        >
+                            <span class="ios-browse__poster">
+                                @if (poster(item); as src) {
+                                    <img [src]="src" alt="" loading="lazy" />
+                                }
+                            </span>
+                            <span class="ios-browse__name">{{ label(item) }}</span>
+                        </button>
+                    }
+                </div>
+            </section>
+        }
+    }
+</div>
