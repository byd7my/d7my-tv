+    -webkit-box-orient: vertical;
+    overflow: hidden;
+}
+
+.ios-browse__skeleton {
+    height: 200px;
+    margin: 0 20px;
+    border-radius: 18px;
+    background: rgba(255, 255, 255, 0.06);
+}
diff --git a/libs/portal/xtream/feature/src/lib/ios-browse/ios-browse.component.ts b/libs/portal/xtream/feature/src/lib/ios-browse/ios-browse.component.ts
