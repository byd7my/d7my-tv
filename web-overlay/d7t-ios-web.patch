diff --git a/apps/web/src/app/ios/ios-backend.interceptor.ts b/apps/web/src/app/ios/ios-backend.interceptor.ts
new file mode 100644
index 0000000..d70a2f4
--- /dev/null
+++ b/apps/web/src/app/ios/ios-backend.interceptor.ts
@@ -0,0 +1,37 @@
+import {
+    HttpErrorResponse,
+    HttpResponse,
+    type HttpInterceptorFn,
+} from '@angular/common/http';
+import { from, throwError } from 'rxjs';
+import { catchError, map } from 'rxjs/operators';
+import { handleIosBackend } from './ios-backend';
+import { getD7tNative, IOS_BACKEND_ORIGIN } from './ios-bridge';
+
+/** Answers the app's own backend calls inside the iOS shell, so no server is needed. */
+export const iosBackendInterceptor: HttpInterceptorFn = (req, next) => {
+    if (!getD7tNative() || !req.url.startsWith(IOS_BACKEND_ORIGIN)) {
+        return next(req);
+    }
+    const url = new URL(req.urlWithParams);
+    return from(
+        handleIosBackend({
+            method: req.method,
+            path: url.pathname.replace(/\/+$/, '') || '/',
+            query: url.searchParams,
+            body: req.body,
+        })
+    ).pipe(
+        map((res) => {
+            if (res.status >= 400) {
+                throw new HttpErrorResponse({
+                    url: req.url,
+                    status: res.status,
+                    error: res.body,
+                });
+            }
+            return new HttpResponse({ url: req.url, status: res.status, body: res.body });
+        }),
+        catchError((error) => throwError(() => error))
+    );
+};
diff --git a/apps/web/src/app/ios/ios-backend.ts b/apps/web/src/app/ios/ios-backend.ts
new file mode 100644
index 0000000..a64a528
--- /dev/null
+++ b/apps/web/src/app/ios/ios-backend.ts
@@ -0,0 +1,337 @@
+/**
+ * The web-backend (apps/web-backend) as it runs inside the iOS app: the same routes and answers, with the
+ * provider requests made by the phone itself (no CORS, no proxy server).
+ */
+import epgParser from 'epg-parser';
+import parser from 'iptv-playlist-parser';
+import {
+    buildStalkerIdentityRequestContext,
+    buildStalkerRequestUrl,
+    normalizeXtreamServerUrl,
+    type ParsedPlaylist,
+} from '@iptvnator/shared/interfaces';
+import { createPlaylistObject as createM3uPlaylist } from '@iptvnator/shared/m3u-utils';
+import { getD7tNative } from './ios-bridge';
+
+interface NativeHttpResult {
+    status: number;
+    location: string;
+    contentType: string;
+    body: string;
+    bodyBase64?: string;
+}
+
+export interface IosBackendRequest {
+    readonly method: string;
+    readonly path: string;
+    readonly query: URLSearchParams;
+    readonly body: unknown;
+}
+
+export interface IosBackendResponse {
+    readonly status: number;
+    readonly body: unknown;
+}
+
+const targets = new Map<string, URL>();
+const TIMEOUT = { playlist: 120, epg: 180, xtream: 45, stalker: 30 } as const;
+
+class ProviderHttpError extends Error {
+    constructor(
+        readonly status: number,
+        message: string
+    ) {
+        super(message);
+    }
+}
+
+async function httpGet(
+    url: string,
+    options: { headers?: Record<string, string>; timeout: number; binary?: boolean }
+): Promise<NativeHttpResult> {
+    const native = getD7tNative();
+    if (!native) throw new ProviderHttpError(502, 'Bad Gateway');
+    let current = url;
+    for (let hop = 0; hop < 6; hop++) {
+        const r = await native.call<NativeHttpResult>('httpGet', {
+            url: current,
+            headers: options.headers ?? {},
+            timeout: options.timeout,
+            binary: !!options.binary,
+        });
+        if (r.status >= 300 && r.status < 400 && r.location) {
+            current = new URL(r.location, current).toString();
+            continue;
+        }
+        if (r.status < 200 || r.status >= 300) {
+            throw new ProviderHttpError(r.status, statusText(r.status));
+        }
+        return r;
+    }
+    throw new ProviderHttpError(502, 'Too many redirects');
+}
+
+function statusText(status: number): string {
+    switch (status) {
+        case 401: return 'Unauthorized';
+        case 403: return 'Forbidden';
+        case 404: return 'Not Found';
+        case 429: return 'Too Many Requests';
+        case 500: return 'Internal Server Error';
+        case 503: return 'Service Unavailable';
+        default: return 'Bad Gateway';
+    }
+}
+
+function errorBody(error: unknown): IosBackendResponse {
+    if (error instanceof ProviderHttpError) {
+        return { status: 200, body: { message: error.message, status: error.status } };
+    }
+    return { status: 200, body: { message: 'Bad Gateway', status: 502 } };
+}
+
+function target(query: URLSearchParams): URL | IosBackendResponse {
+    const id = query.get('targetId')?.trim();
+    if (!id) return { status: 400, body: { message: 'Missing targetId', status: 400 } };
+    const url = targets.get(id);
+    if (!url) {
+        return {
+            status: 404,
+            body: { message: 'Provider target not found', status: 404, code: 'PROVIDER_TARGET_NOT_FOUND' },
+        };
+    }
+    return url;
+}
+
+const isResponse = (v: URL | IosBackendResponse): v is IosBackendResponse => !(v instanceof URL);
+
+function proxyParams(query: URLSearchParams, excluded: string[]): Record<string, string> {
+    const out: Record<string, string> = {};
+    query.forEach((value, key) => {
+        if (!excluded.includes(key) && value.trim()) out[key] = value.trim();
+    });
+    return out;
+}
+
+function guid(): string {
+    return Math.random().toString(36).slice(2);
+}
+
+function lastSegment(value: string): string {
+    const s = value.slice(value.lastIndexOf('/') + 1).trim();
+    return s.length > 0 ? s : 'Playlist without title';
+}
+
+async function gunzip(base64: string): Promise<string> {
+    const bin = atob(base64);
+    const bytes = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
+    return await new Response(stream).text();
+}
+
+async function parsePlaylist(url: URL, userAgent?: string): Promise<IosBackendResponse> {
+    try {
+        const r = await httpGet(url.href, {
+            timeout: TIMEOUT.playlist,
+            headers: userAgent ? { 'User-Agent': userAgent } : undefined,
+        });
+        const parsed = parser.parse(r.body) as ParsedPlaylist;
+        const now = new Date().toISOString();
+        const id = guid();
+        const playlist = createM3uPlaylist(lastSegment(url.href), parsed, url.href, 'URL');
+        for (const item of playlist.playlist.items) item.id = guid();
+        return {
+            status: 200,
+            body: { ...playlist, id, _id: id, importDate: now, lastUsage: now, ...(userAgent ? { userAgent } : {}) },
+        };
+    } catch (error) {
+        const e = errorBody(error).body as { status: number; message: string };
+        return { status: e.status >= 400 ? e.status : 500, body: e };
+    }
+}
+
+async function parseEpg(url: URL): Promise<IosBackendResponse> {
+    try {
+        const gz = url.pathname.endsWith('.gz');
+        const r = await httpGet(url.href, { timeout: TIMEOUT.epg, binary: gz });
+        const xml = gz ? await gunzip(r.bodyBase64 ?? '') : r.body;
+        return { status: 200, body: epgParser.parse(xml) };
+    } catch (error) {
+        const e = errorBody(error).body as { status: number; message: string };
+        return { status: e.status >= 400 ? e.status : 500, body: e };
+    }
+}
+
+
+// ── Provider response cache ─────────────────────────────────────────────────────
+// The web build has no local database, so every visit to Live / Movies / Series would download the
+// whole catalogue again (tens of thousands of items) and show "Syncing playlist" each time. Big list
+// answers are kept for a while, in memory and on the phone (IndexedDB), and reused.
+const CACHE_TTL_MS: Record<string, number> = {
+    get_live_categories: 20 * 60_000,
+    get_live_streams: 20 * 60_000,
+    get_vod_categories: 20 * 60_000,
+    get_vod_streams: 20 * 60_000,
+    get_series_categories: 20 * 60_000,
+    get_series: 20 * 60_000,
+    get_vod_info: 10 * 60_000,
+    get_series_info: 10 * 60_000,
+};
+const memoryCache = new Map<string, { at: number; body: string }>();
+const inflight = new Map<string, Promise<string>>();
+
+function openCacheDb(): Promise<IDBDatabase | null> {
+    return new Promise((resolve) => {
+        try {
+            const req = indexedDB.open('d7t-provider-cache', 1);
+            req.onupgradeneeded = () => req.result.createObjectStore('r');
+            req.onsuccess = () => resolve(req.result);
+            req.onerror = () => resolve(null);
+        } catch {
+            resolve(null);
+        }
+    });
+}
+
+async function cacheRead(key: string): Promise<{ at: number; body: string } | null> {
+    const db = await openCacheDb();
+    if (!db) return null;
+    return new Promise((resolve) => {
+        const req = db.transaction('r').objectStore('r').get(key);
+        req.onsuccess = () => resolve((req.result as { at: number; body: string } | undefined) ?? null);
+        req.onerror = () => resolve(null);
+    });
+}
+
+async function cacheWrite(key: string, value: { at: number; body: string }): Promise<void> {
+    const db = await openCacheDb();
+    if (!db) return;
+    await new Promise<void>((resolve) => {
+        const tx = db.transaction('r', 'readwrite');
+        tx.objectStore('r').put(value, key);
+        tx.oncomplete = () => resolve();
+        tx.onerror = () => resolve();
+    });
+}
+
+async function cachedBody(key: string, ttl: number, load: () => Promise<string>): Promise<string> {
+    const now = Date.now();
+    const mem = memoryCache.get(key);
+    if (mem && now - mem.at < ttl) return mem.body;
+    const disk = await cacheRead(key);
+    if (disk && now - disk.at < ttl) {
+        memoryCache.set(key, disk);
+        return disk.body;
+    }
+    const running = inflight.get(key);
+    if (running) return running;
+    const task = load()
+        .then(async (body) => {
+            // Only real JSON answers are kept; an error page that came back as 200 must not stick.
+            if (!/^\s*[\[{]/.test(body)) return body;
+            const value = { at: Date.now(), body };
+            memoryCache.set(key, value);
+            await cacheWrite(key, value);
+            return body;
+        })
+        .finally(() => inflight.delete(key));
+    inflight.set(key, task);
+    return task;
+}
+
+async function xtream(url: URL, query: URLSearchParams): Promise<IosBackendResponse> {
+    const action = query.get('action') ?? undefined;
+    try {
+        const base = new URL(normalizeXtreamServerUrl(url.href));
+        base.pathname = `${base.pathname.replace(/\/+$/, '')}/player_api.php`;
+        base.search = '';
+        const params = proxyParams(query, ['targetId', 'connectionTest', 'userAgent']);
+        const qs = Object.entries(params)
+            .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
+            .join('&');
+        const ua = query.get('userAgent')?.trim();
+        const fullUrl = qs ? `${base.href}?${qs}` : base.href;
+        const load = async () => {
+            const r = await httpGet(fullUrl, {
+                timeout: TIMEOUT.xtream,
+                headers: ua ? { 'User-Agent': ua } : undefined,
+            });
+            return r.body;
+        };
+        const ttl = action ? CACHE_TTL_MS[action] : undefined;
+        const body = ttl ? await cachedBody(fullUrl, ttl, load) : await load();
+        let payload: unknown;
+        try {
+            payload = JSON.parse(body);
+        } catch {
+            payload = body;
+        }
+        return { status: 200, body: { action, payload } };
+    } catch (error) {
+        if (query.get('connectionTest') === 'true') {
+            return { status: 200, body: { connectionFailure: { kind: 'connection', canTryHttp: false } } };
+        }
+        return errorBody(error);
+    }
+}
+
+async function stalker(url: URL, query: URLSearchParams): Promise<IosBackendResponse> {
+    try {
+        const macAddress = query.get('macAddress')?.trim() ?? '';
+        const token = query.get('token')?.trim();
+        const serialNumber = query.get('serialNumber')?.trim();
+        const params: Record<string, string | number> = proxyParams(query, [
+            'targetId', 'macAddress', 'token', 'serialNumber', 'skipConnectionGuard',
+        ]);
+        if (params['action'] === 'handshake' && token) params['token'] = token;
+        const identity = buildStalkerIdentityRequestContext({
+            macAddress,
+            params,
+            ...(token ? { token } : {}),
+            ...(serialNumber ? { serialNumber } : {}),
+        });
+        const headers = { ...identity.headers };
+        if (!macAddress) delete headers['Cookie'];
+        const requestUrl = buildStalkerRequestUrl(url.href, identity.requestParams);
+        const r = await httpGet(requestUrl, {
+            headers,
+            timeout: params['action'] === 'create_link' ? 60 : TIMEOUT.stalker,
+        });
+        let payload: unknown;
+        try {
+            payload = JSON.parse(r.body);
+        } catch {
+            payload = r.body;
+        }
+        return { status: 200, body: { action: query.get('action') ?? undefined, payload } };
+    } catch (error) {
+        return errorBody(error);
+    }
+}
+
+export async function handleIosBackend(req: IosBackendRequest): Promise<IosBackendResponse> {
+    const { method, path, query } = req;
+    if (method === 'POST' && path === '/provider-targets') {
+        const raw = (req.body as { url?: string } | null)?.url;
+        try {
+            const url = new URL(String(raw));
+            const targetId = guid() + guid();
+            targets.set(targetId, url);
+            return { status: 200, body: { targetId } };
+        } catch {
+            return { status: 400, body: { message: 'Invalid URL', status: 400 } };
+        }
+    }
+    if (method === 'GET' && (path === '/parse' || path === '/parse-xml' || path === '/xtream' || path === '/stalker')) {
+        const url = target(query);
+        if (isResponse(url)) return url;
+        if (path === '/parse') return parsePlaylist(url, query.get('userAgent')?.trim() || undefined);
+        if (path === '/parse-xml') return parseEpg(url);
+        if (path === '/xtream') return xtream(url, query);
+        return stalker(url, query);
+    }
+    if (path === '/health') return { status: 200, body: { ok: true } };
+    if (path === '/provider-hosts/reset') return { status: 200, body: { reset: false } };
+    return { status: 404, body: { message: 'Not found', status: 404 } };
+}
diff --git a/apps/web/src/app/ios/ios-bridge.ts b/apps/web/src/app/ios/ios-bridge.ts
new file mode 100644
index 0000000..73e6ac9
--- /dev/null
+++ b/apps/web/src/app/ios/ios-bridge.ts
@@ -0,0 +1,21 @@
+/**
+ * The iOS shell (D7T app) injects `window.d7tNative` before the page starts.
+ * Everything that needs the phone itself (raw-socket HTTP, mpv, Vision OCR) goes through it.
+ */
+export interface D7tNativeBridge {
+    readonly platform: 'ios';
+    call<T = unknown>(method: string, args?: unknown): Promise<T>;
+    on(event: string, handler: (payload: unknown) => void): () => void;
+}
+
+declare global {
+    interface Window {
+        d7tNative?: D7tNativeBridge;
+    }
+}
+
+export const IOS_BACKEND_ORIGIN = 'https://d7t-backend.local';
+
+export function getD7tNative(): D7tNativeBridge | undefined {
+    return typeof window === 'undefined' ? undefined : window.d7tNative;
+}
diff --git a/apps/web/src/app/ios/ios-fullscreen.ts b/apps/web/src/app/ios/ios-fullscreen.ts
new file mode 100644
index 0000000..2dd8486
--- /dev/null
+++ b/apps/web/src/app/ios/ios-fullscreen.ts
@@ -0,0 +1,119 @@
+/**
+ * iPhone WebKit only allows fullscreen for <video>. The player asks for fullscreen on its own
+ * container, so give the page a small stand-in: the element fills the screen (CSS class
+ * `d7t-fullscreen`), everything else on the page is hidden (the video is drawn behind the page),
+ * and `document.fullscreenElement` / `fullscreenchange` behave like the real thing.
+ *
+ * Turning the phone sideways while a live player is open enters fullscreen by itself, and turning it
+ * back leaves it (the same thing every video app does).
+ */
+export function installIosFullscreen(): void {
+    if (typeof window === 'undefined' || !(window as unknown as { d7tNative?: unknown }).d7tNative) {
+        return;
+    }
+    let current: Element | null = null;
+    let enteredByRotation = false;
+    const root = document.documentElement;
+    const notify = () => document.dispatchEvent(new Event('fullscreenchange'));
+    // Turning the phone (and fullscreen on/off) can leave the page scrolled or zoomed by WebKit:
+    // put the viewport back. The meta viewport pins the scale; this pins the scroll position.
+    const resetViewport = () => {
+        window.scrollTo(0, 0);
+        document.documentElement.scrollTop = 0;
+        document.body.scrollTop = 0;
+    };
+    window.addEventListener('orientationchange', () => window.setTimeout(resetViewport, 120));
+    window.addEventListener('resize', () => window.setTimeout(resetViewport, 0));
+
+    // A way back to the list from inside the picture (the player's own exit icon is small and far
+    // from the thumb). It follows the controls: visible together with the title.
+    let backButton: HTMLButtonElement | null = null;
+    const addBackButton = (host: Element) => {
+        backButton?.remove();
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = 'd7t-fs-back';
+        button.setAttribute('aria-label', 'Back to list');
+        button.innerHTML =
+            '<svg viewBox="0 0 12 20" width="11" height="18" aria-hidden="true"><path d="M10 2 2 10l8 8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
+        button.addEventListener('click', (event) => {
+            event.stopPropagation();
+            enteredByRotation = false;
+            void exit();
+        });
+        host.appendChild(button);
+        backButton = button;
+    };
+
+    const clear = () => {
+        backButton?.remove();
+        backButton = null;
+        current?.classList.remove('d7t-fullscreen');
+        root.classList.remove('d7t-has-fullscreen');
+        current = null;
+    };
+
+    const exit = async (): Promise<void> => {
+        if (!current) return;
+        clear();
+        notify();
+        window.dispatchEvent(new Event('resize'));
+        resetViewport();
+    };
+
+    // The player can disappear while fullscreen (another channel, back to the list). The page must
+    // not stay in the fullscreen look then.
+    new MutationObserver(() => {
+        if (current && !current.isConnected) {
+            clear();
+            enteredByRotation = false;
+            notify();
+            window.dispatchEvent(new Event('resize'));
+        }
+    }).observe(document.documentElement, { childList: true, subtree: true });
+
+    Object.defineProperty(document, 'fullscreenEnabled', { configurable: true, get: () => true });
+    Object.defineProperty(document, 'fullscreenElement', {
+        configurable: true,
+        get: () => (current && current.isConnected ? current : null),
+    });
+    Object.defineProperty(document, 'exitFullscreen', { configurable: true, value: exit });
+    Object.defineProperty(Element.prototype, 'requestFullscreen', {
+        configurable: true,
+        writable: true,
+        value: async function (this: Element): Promise<void> {
+            if (current && current !== this) clear();
+            current = this;
+            this.classList.add('d7t-fullscreen');
+            root.classList.add('d7t-has-fullscreen');
+            addBackButton(this);
+            notify();
+            window.dispatchEvent(new Event('resize'));
+        },
+    });
+
+    // Sideways = fullscreen for a live player.
+    const landscape = window.matchMedia('(orientation: landscape)');
+    const fullscreenButton = (): HTMLButtonElement | null => {
+        const buttons = document.querySelectorAll<HTMLButtonElement>('.embedded-mpv-player__controls button');
+        for (const button of Array.from(buttons)) {
+            const icon = button.querySelector('mat-icon')?.textContent?.trim();
+            if (icon === 'fullscreen' || icon === 'fullscreen_exit') return button;
+        }
+        return null;
+    };
+    const onRotate = () => {
+        if (landscape.matches) {
+            if (current) return;
+            const button = fullscreenButton();
+            if (button && button.querySelector('mat-icon')?.textContent?.trim() === 'fullscreen') {
+                enteredByRotation = true;
+                button.click();
+            }
+        } else if (current && enteredByRotation) {
+            enteredByRotation = false;
+            void exit();
+        }
+    };
+    landscape.addEventListener('change', () => window.setTimeout(onRotate, 150));
+}
diff --git a/apps/web/src/app/ios/ios-mpv-host.ts b/apps/web/src/app/ios/ios-mpv-host.ts
