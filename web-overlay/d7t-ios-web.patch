@@ -0,0 +1,428 @@
+import {
+    ChangeDetectionStrategy,
+    Component,
+    computed,
+    DestroyRef,
+    effect,
+    inject,
+    input,
+    OnInit,
+    output,
+    signal,
+    untracked,
+} from '@angular/core';
+import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
+import { MatMenuModule } from '@angular/material/menu';
+import { ActivatedRoute, Router } from '@angular/router';
+import {
+    FavoritesService,
+    XtreamStore,
+} from '@iptvnator/portal/xtream/data-access';
+import { plainDisplayText } from '@iptvnator/shared/interfaces';
+import { PortalChannelSortMode } from '@iptvnator/portal/shared/util';
+import { EMPTY, fromEvent, merge, of, switchMap } from 'rxjs';
+import { catchError, filter } from 'rxjs/operators';
+import {
+    PortalChannelsListComponent,
+    XtreamChannelListItem,
+} from '../portal-channels-list/portal-channels-list.component';
+import { IosCategoryRow } from './ios-category-sheet.component';
+import { IosCategorySheetService } from './ios-category-sheet.service';
+import { XtreamFavoriteMarksService } from '../portal-channels-list/xtream-favorite-marks.service';
+import { IosHiddenCategoriesService } from './ios-hidden-categories.service';
+
+type Scope =
+    | { kind: 'all' }
+    | { kind: 'favorites' }
+    | { kind: 'recent' }
+    | { kind: 'category'; id: number };
+
+interface CategoryLike {
+    readonly category_id?: string | number;
+    readonly id?: string | number;
+    readonly category_name?: string;
+    readonly name?: string;
+}
+
+const SORT_OPTIONS: ReadonlyArray<{
+    mode: PortalChannelSortMode;
+    label: string;
+}> = [
+    { mode: 'server', label: 'Provider order' },
+    { mode: 'name-asc', label: 'Name A–Z' },
+    { mode: 'name-desc', label: 'Name Z–A' },
+];
+
+/**
+ * The Live TV list as the iPhone app shows it: one tappable category title
+ * (opens the Categories sheet), a plain vertical channel list underneath.
+ * It reuses the real channel list, EPG queue, favorites and playback of the
+ * PC app; only the arrangement and the category chooser are new.
+ */
+@Component({
+    selector: 'app-ios-live-panel',
+    changeDetection: ChangeDetectionStrategy.OnPush,
+    imports: [MatMenuModule, PortalChannelsListComponent],
+    template: `
+        <div class="ios-live-head">
+            <button
+                type="button"
+                class="ios-live-title"
+                data-test-id="ios-live-category"
+                aria-haspopup="dialog"
+                [attr.aria-label]="'Category: ' + title() + '. Choose category'"
+                (click)="openSheet()"
+            >
+                @switch (scope().kind) {
+                    @case ('favorites') {
+                        <svg class="ios-live-title__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 20.5s-8-4.9-8-11A4.6 4.6 0 0 1 12 6.8 4.6 4.6 0 0 1 20 9.5c0 6.1-8 11-8 11Z" fill="currentColor" /></svg>
+                    }
+                    @case ('recent') {
+                        <svg class="ios-live-title__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
+                    }
+                }
+                <span class="ios-live-title__name">{{ plain(title()) }}</span>
+                <svg class="ios-live-title__chev" viewBox="0 0 14 22" width="12" height="19" aria-hidden="true">
+                    <path d="m2.5 8.5 4.5-5 4.5 5M2.5 13.5l4.5 5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
+                </svg>
+            </button>
+            <button
+                type="button"
+                class="ios-live-sort"
+                aria-label="Sort channels"
+                [matMenuTriggerFor]="sortMenu"
+            >
+                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
+                    <path d="M4 7h10M4 12h7M4 17h4M18 5v14m0 0-3-3m3 3 3-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
+                </svg>
+            </button>
+            <mat-menu #sortMenu="matMenu">
+                @for (option of sortOptions; track option.mode) {
+                    <button mat-menu-item (click)="sortModeChange.emit(option.mode)">
+                        {{ sortMode() === option.mode ? '✓ ' : '' }}{{ option.label }}
+                    </button>
+                }
+            </mat-menu>
+        </div>
+        <app-portal-channels-list
+            class="ios-live-list"
+            [revealRequest]="revealRequest()"
+            [sortMode]="sortMode()"
+            [searchTermInput]="searchTermInput()"
+            [channelsOverride]="channelsOverride()"
+            (playClicked)="playClicked.emit($event)"
+            (playbackRequested)="playbackRequested.emit($event)"
+        />
+    `,
+    styleUrl: './ios-live-panel.component.scss',
+})
+export class IosLiveCategoryPanelComponent implements OnInit {
+    readonly sortMode = input<PortalChannelSortMode>('server');
+    readonly searchTermInput = input('');
+    readonly revealRequest = input<{
+        channelId: number;
+        sequence: number;
+    } | null>(null);
+
+    readonly sortModeChange = output<PortalChannelSortMode>();
+    readonly playClicked = output<XtreamChannelListItem>();
+    readonly playbackRequested = output<XtreamChannelListItem>();
+
+    readonly sortOptions = SORT_OPTIONS;
+    protected readonly plain = plainDisplayText;
+
+    private readonly store = inject(XtreamStore);
+    private readonly favoritesService = inject(FavoritesService);
+    private readonly hiddenService = inject(IosHiddenCategoriesService);
+    private readonly favoriteMarks = inject(XtreamFavoriteMarksService);
+    private readonly sheets = inject(IosCategorySheetService);
+    private readonly router = inject(Router);
+    private readonly route = inject(ActivatedRoute);
+    private readonly destroyRef = inject(DestroyRef);
+
+    private readonly playlistId = computed(
+        () => this.store.currentPlaylist()?.id ?? ''
+    );
+
+    readonly scope = signal<Scope>({ kind: 'all' });
+    private readonly favoriteIds = signal<ReadonlySet<number>>(new Set());
+
+    private readonly categories = computed(
+        () => this.store.getCategoriesBySelectedType() as CategoryLike[]
+    );
+    private readonly counts = this.store.getCategoryItemCounts;
+    private readonly hiddenIds = computed(() =>
+        this.hiddenService.hiddenIds(this.playlistId(), 'live')
+    );
+
+    private static idOf(category: CategoryLike): string {
+        return String(category.category_id ?? category.id ?? '');
+    }
+
+    private static nameOf(category: CategoryLike): string {
+        return String(category.category_name ?? category.name ?? '');
+    }
+
+    private readonly visibleCategories = computed(() => {
+        const hidden = this.hiddenIds();
+        return this.categories().filter(
+            (c) => !hidden.has(IosLiveCategoryPanelComponent.idOf(c))
+        );
+    });
+
+    private readonly recentLiveIds = computed(() => {
+        const out: number[] = [];
+        for (const item of this.store.recentItems() as unknown as Array<{
+            type?: string;
+            xtream_id?: number;
+        }>) {
+            if (item.type === 'live' && typeof item.xtream_id === 'number') {
+                out.push(item.xtream_id);
+            }
+        }
+        return out;
+    });
+
+    /** Every live channel outside hidden categories (store selection must be null). */
+    private readonly allVisibleChannels = computed(() => {
+        const hidden = this.hiddenIds();
+        const all = this.store.selectItemsFromSelectedCategory() as XtreamChannelListItem[];
+        return hidden.size
+            ? all.filter((i) => !hidden.has(String(i.category_id ?? '')))
+            : all;
+    });
+
+    readonly channelsOverride = computed<XtreamChannelListItem[] | null>(() => {
+        const s = this.scope();
+        if (s.kind === 'category') {
+            return null;
+        }
+        const all = this.allVisibleChannels();
+        if (s.kind === 'favorites') {
+            const fav = this.favoriteIds();
+            return all.filter((i) => fav.has(i.xtream_id));
+        }
+        if (s.kind === 'recent') {
+            const byId = new Map(all.map((i) => [i.xtream_id, i] as const));
+            return this.recentLiveIds()
+                .map((id) => byId.get(id))
+                .filter((i): i is XtreamChannelListItem => !!i);
+        }
+        return all;
+    });
+
+    readonly title = computed(() => {
+        const s = this.scope();
+        if (s.kind === 'favorites') return 'Favorites';
+        if (s.kind === 'recent') return 'Recently Watched';
+        if (s.kind === 'all') return 'All Channels';
+        const found = this.categories().find(
+            (c) => IosLiveCategoryPanelComponent.idOf(c) === String(s.id)
+        );
+        return found
+            ? IosLiveCategoryPanelComponent.nameOf(found)
+            : 'Channels';
+    });
+
+    private readonly selectedKey = computed(() => {
+        const s = this.scope();
+        return s.kind === 'category' ? `c:${s.id}` : s.kind;
+    });
+
+    constructor() {
+        // Keep the store's category in step with the scope: "all", favorites and
+        // recents read the whole live catalog, so no category may be selected.
+        effect(() => {
+            const s = this.scope();
+            untracked(() =>
+                this.store.setSelectedCategory(
+                    s.kind === 'category' ? s.id : null
+                )
+            );
+        });
+    }
+
+    ngOnInit(): void {
+        // Only the route may pick the first category. The store's selection is shared by Movies,
+        // Series and Live: taking it here opened Live on a *movie* category (no live channels
+        // in it, so an empty list) after the user had browsed Movies.
+        const raw = this.route.snapshot.params['categoryId'];
+        const fromRoute = raw === undefined || raw === '' ? NaN : Number(raw);
+        if (Number.isFinite(fromRoute)) {
+            this.scope.set({ kind: 'category', id: fromRoute });
+        }
+
+        const playlist = this.store.currentPlaylist();
+        if (playlist) {
+            this.store.loadRecentItems({ id: playlist.id });
+            merge(
+                of(null),
+                fromEvent(window, 'iptvnator-favorites-changed'),
+                this.favoriteMarks.changes$.pipe(
+                    filter((change) => change.playlistId === playlist.id)
+                )
+            )
+                .pipe(
+                    switchMap(() =>
+                        this.favoritesService
+                            .getFavorites(playlist.id)
+                            .pipe(catchError(() => EMPTY))
+                    ),
+                    takeUntilDestroyed(this.destroyRef)
+                )
+                .subscribe((items) => {
+                    this.favoriteIds.set(
+                        new Set(
+                            items
+                                .filter((i) => i.type === 'live')
+                                .map((i) => i.xtream_id)
+                        )
+                    );
+                });
+        }
+    }
+
+    openSheet(): void {
+        const native = (
+            window as unknown as {
+                d7tNative?: {
+                    call: <T>(method: string, args?: unknown) => Promise<T>;
+                };
+            }
+        ).d7tNative;
+        if (native) {
+            void this.openNativeSheet(native);
+            return;
+        }
+        this.openHtmlSheet();
+    }
+
+    /** iPhone: the system's own sheet (Liquid Glass) with search; hiding stays in the HTML editor. */
+    private async openNativeSheet(native: {
+        call: <T>(method: string, args?: unknown) => Promise<T>;
+    }): Promise<void> {
+        const rows = this.sheetRows();
+        const selected = this.selectedKey();
+        const icons: Record<string, string> = {
+            all: 'list.bullet',
+            favorites: 'heart.fill',
+            recent: 'clock',
+        };
+        const toItem = (row: IosCategoryRow) => ({
+            id: row.key,
+            title: plainDisplayText(row.name),
+            icon: icons[row.key],
+            checked: row.key === selected,
+            trailing: row.count != null ? String(row.count) : undefined,
+        });
+        const special = rows.filter((r) => icons[r.key]).map(toItem);
+        const categories = rows.filter((r) => !icons[r.key]).map(toItem);
+        try {
+            const picked = await native.call<string | null>('ui.sheet', {
+                title: 'Categories',
+                searchable: true,
+                groups: [
+                    { items: special },
+                    { heading: 'Categories', items: categories },
+                    {
+                        items: [
+                            {
+                                id: '__edit',
+                                title: 'Choose which categories to show',
+                                icon: 'eye.slash',
+                            },
+                        ],
+                    },
+                ],
+            });
+            if (picked === '__edit') {
+                this.openHtmlSheet(true);
+            } else if (picked) {
+                this.select(picked);
+            }
+        } catch {
+            this.openHtmlSheet();
+        }
+    }
+
+    private openHtmlSheet(startEditing = false): void {
+        this.sheets.open({
+            startEditing,
+            rows: this.sheetRows,
+            hiddenRows: this.hiddenRows,
+            selectedKey: this.selectedKey,
+            onPick: (key) => this.select(key),
+            onHide: (key) => this.hide(key),
+            onRestore: (key) => this.restore(key),
+            onRestoreAll: () =>
+                this.hiddenService.restoreAll(this.playlistId(), 'live'),
+        });
+    }
+
+    private readonly sheetRows = computed<IosCategoryRow[]>(() => {
+        const counts = this.counts();
+        const total = this.visibleCategories().reduce(
+            (sum, c) =>
+                sum + (counts?.get(Number(IosLiveCategoryPanelComponent.idOf(c))) ?? 0),
+            0
+        );
+        const rows: IosCategoryRow[] = [
+            { key: 'all', name: 'All Channels', icon: 'all', count: total, hideable: false },
+            { key: 'favorites', name: 'Favorites', icon: 'favorites', count: this.favoriteIds().size, hideable: false },
+            { key: 'recent', name: 'Recently Watched', icon: 'recent', count: this.recentLiveIds().length, hideable: false },
+        ];
+        for (const c of this.visibleCategories()) {
+            const id = IosLiveCategoryPanelComponent.idOf(c);
+            rows.push({
+                key: `c:${id}`,
+                name: IosLiveCategoryPanelComponent.nameOf(c),
+                count: counts?.get(Number(id)) ?? null,
+                hideable: true,
+            });
+        }
+        return rows;
+    });
+
+    private readonly hiddenRows = computed<IosCategoryRow[]>(() => {
+        const hidden = this.hiddenIds();
+        return this.categories()
+            .filter((c) => hidden.has(IosLiveCategoryPanelComponent.idOf(c)))
+            .map((c) => ({
+                key: `c:${IosLiveCategoryPanelComponent.idOf(c)}`,
+                name: IosLiveCategoryPanelComponent.nameOf(c),
+                hideable: false,
+            }));
+    });
+
+    private select(key: string): void {
+        if (key === 'all' || key === 'favorites' || key === 'recent') {
+            this.scope.set({ kind: key });
+            return;
+        }
+        const id = Number(key.slice(2));
+        if (!Number.isFinite(id)) {
+            return;
+        }
+        this.scope.set({ kind: 'category', id });
+        // Same as the PC rail: keep a category route in step with the selection.
+        if (this.route.snapshot.params['categoryId'] !== undefined) {
+            void this.router.navigate(
+                ['/workspace', 'xtreams', this.playlistId(), 'live', id],
+                { queryParamsHandling: 'preserve', replaceUrl: true }
+            );
+        }
+    }
+
+    private hide(key: string): void {
+        const id = key.slice(2);
+        this.hiddenService.hide(this.playlistId(), 'live', id);
+        const s = this.scope();
+        if (s.kind === 'category' && String(s.id) === id) {
+            this.scope.set({ kind: 'all' });
+        }
+    }
+
+    private restore(key: string): void {
+        this.hiddenService.restore(this.playlistId(), 'live', key.slice(2));
+    }
+}
