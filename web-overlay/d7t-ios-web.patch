@@ -0,0 +1,80 @@
+import { Overlay, OverlayRef } from '@angular/cdk/overlay';
+import { ComponentPortal } from '@angular/cdk/portal';
+import {
+    effect,
+    EffectRef,
+    inject,
+    Injectable,
+    Injector,
+    Signal,
+} from '@angular/core';
+import {
+    IosCategoryRow,
+    IosCategorySheetComponent,
+} from './ios-category-sheet.component';
+
+export interface IosCategorySheetConfig {
+    readonly title?: string;
+    readonly rows: Signal<IosCategoryRow[]>;
+    readonly hiddenRows: Signal<IosCategoryRow[]>;
+    readonly selectedKey: Signal<string | null>;
+    readonly onPick: (key: string) => void;
+    readonly onHide: (key: string) => void;
+    readonly onRestore: (key: string) => void;
+    readonly onRestoreAll: () => void;
+    /** Open directly in the select/deselect view. */
+    readonly startEditing?: boolean;
+}
+
+/** Presents the Categories sheet above everything (CDK overlay, body level). */
+@Injectable({ providedIn: 'root' })
+export class IosCategorySheetService {
+    private readonly overlay = inject(Overlay);
+    private readonly injector = inject(Injector);
+    private current: OverlayRef | null = null;
+
+    open(config: IosCategorySheetConfig): void {
+        if (this.current) {
+            return;
+        }
+        const ref = this.overlay.create({
+            positionStrategy: this.overlay.position().global(),
+            scrollStrategy: this.overlay.scrollStrategies.block(),
+            panelClass: 'd7t-ios-sheet-pane',
+        });
+        this.current = ref;
+        const sheet = ref.attach(
+            new ComponentPortal(IosCategorySheetComponent)
+        );
+        if (config.title) {
+            sheet.setInput('title', config.title);
+        }
+        if (config.startEditing) {
+            sheet.setInput('startEditing', true);
+        }
+        const sync: EffectRef = effect(
+            () => {
+                sheet.setInput('rows', config.rows());
+                sheet.setInput('hiddenRows', config.hiddenRows());
+                sheet.setInput('selectedKey', config.selectedKey());
+            },
+            { injector: this.injector }
+        );
+        const instance = sheet.instance;
+        instance.picked.subscribe((key) => config.onPick(key));
+        instance.hide.subscribe((key) => config.onHide(key));
+        instance.restore.subscribe((key) => config.onRestore(key));
+        instance.restoreAll.subscribe(() => config.onRestoreAll());
+        // "Deselect all": every category still shown is hidden, the same way one tap would.
+        instance.hideAll.subscribe(() => {
+            for (const row of config.rows()) {
+                if (row.hideable) config.onHide(row.key);
+            }
+        });
+        instance.closed.subscribe(() => {
+            sync.destroy();
+            ref.dispose();
+            this.current = null;
+        });
+    }
+}
diff --git a/libs/portal/xtream/feature/src/lib/ios-live/ios-hidden-categories.service.ts b/libs/portal/xtream/feature/src/lib/ios-live/ios-hidden-categories.service.ts
